<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeeLazy - Model Wipe"
        ShowInTaskbar="False"
        MinHeight="760" MinWidth="980" Height="900" Width="1120"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="10">
        <!-- ================= bottom: log + actions ================= -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <StackPanel DockPanel.Dock="Right" Margin="8,0,0,0" VerticalAlignment="Bottom">
                <Button x:Name="job_stop_b" Content="Stop Background Job" Click="job_stop_click" Width="170" Height="26" Margin="0,0,0,6" Visibility="Collapsed"
                        ToolTip="Each background Revit finishes the model it is on, then skips the rest."/>
                <Button x:Name="wipe_b" Content="Wipe Ticked Models" Click="wipe_click" Width="170" Height="34" FontWeight="Bold" IsEnabled="False"
                        ToolTip="Applies the ticked wipe items to every ticked model. Each item is deleted one by one in its own transaction - one that fails never stops the others."/>
                <Button x:Name="close_b" Content="Close" Click="close_click" Width="170" Height="28" Margin="0,6,0,0"/>
            </StackPanel>
            <TextBox x:Name="log_tb" Height="120" IsReadOnly="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"/>
        </DockPanel>

        <!-- ================= progress ================= -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <TextBlock DockPanel.Dock="Right" x:Name="prog_tb" Width="330" Margin="10,0,0,0" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" Opacity="0.85" Text="Idle"/>
            <ProgressBar x:Name="prog_bar" Height="16" Minimum="0" Maximum="100" Value="0"/>
        </DockPanel>

        <!-- ================= top: models + output + run ================= -->
        <StackPanel DockPanel.Dock="Top">
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,8" Opacity="0.85"
                       Text="Strip models back to what you need - e.g. architects' files down to the building envelope before you start the facade. 1) add the models  2) choose what happens to the original  3) scan one model to get the wipe list, tick what goes  4) wipe."/>

            <TextBlock Text="1  Models" FontWeight="Bold" Margin="0,0,0,4"/>
            <WrapPanel Margin="0,0,0,4">
                <Button Content="Add Files..." Click="add_files_click" Width="100" Height="26" Margin="0,0,6,4"/>
                <Button Content="Add Folder..." Click="add_folder_click" Width="100" Height="26" Margin="0,0,6,4"/>
                <Button Content="Add ACC Files..." Click="add_acc_click" Width="120" Height="26" Margin="0,0,6,4"/>
                <Button Content="Add Open Model" Click="add_open_click" Width="115" Height="26" Margin="0,0,6,4"
                        ToolTip="The project open in this Revit right now. It is wiped in place and NOT saved."/>
                <Button Content="Remove Highlighted" Click="remove_models_click" Width="130" Height="26" Margin="12,0,6,4"/>
                <Button Content="Clear" Click="clear_models_click" Width="60" Height="26" Margin="0,0,6,4"/>
                <Button Content="Tick All" Click="models_all_click" Width="70" Height="26" Margin="12,0,6,4"/>
                <Button Content="Tick None" Click="models_none_click" Width="75" Height="26" Margin="0,0,6,4"/>
            </WrapPanel>
            <DataGrid x:Name="models_grid" AutoGenerateColumns="False" CanUserAddRows="False" RowHeaderWidth="0"
                      Height="170" CanUserSortColumns="False" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="Wipe" Width="50"
                                            Binding="{Binding selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <DataGridTextColumn Header="Model" Binding="{Binding name}" Width="260" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Source" Binding="{Binding source_label}" Width="80" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Location" Binding="{Binding folder}" Width="*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Result" Binding="{Binding status}" Width="230" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Text="2  What happens to the original" FontWeight="Bold" Margin="0,10,0,4"/>
            <RadioButton x:Name="mode_copy_rb" GroupName="mode" IsChecked="True" Checked="mode_changed" Margin="0,0,0,2"
                         Content="Detach and save a COPY - the original file / ACC model stays untouched (recommended)"/>
            <DockPanel x:Name="copy_panel" Margin="22,0,0,4">
                <CheckBox DockPanel.Dock="Right" x:Name="compact_cb" IsChecked="True" VerticalAlignment="Center" Margin="10,0,0,0" Content="Compact on save"/>
                <TextBlock DockPanel.Dock="Right" Text="name suffix:" VerticalAlignment="Center" Margin="10,0,4,0"/>
                <TextBox DockPanel.Dock="Right" x:Name="suffix_tb" Text="_Wiped" Width="90" Height="26" VerticalContentAlignment="Center"/>
                <Button DockPanel.Dock="Right" Content="Browse..." Click="out_browse_click" Width="80" Height="26" Margin="6,0,0,0"/>
                <TextBlock DockPanel.Dock="Left" Text="Save copies in:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="out_tb" Height="26" VerticalContentAlignment="Center"
                         ToolTip="Folder for the wiped copies. Leave empty to save each copy beside its original (local files). ACC models are saved here too - a folder is needed for them. An existing file is never overwritten - a number is added instead."/>
            </DockPanel>
            <RadioButton x:Name="mode_over_rb" GroupName="mode" Checked="mode_changed" Margin="0,0,0,4"
                         Content="Wipe the ORIGINAL itself - no copy. Local file: saved / synchronized in place. ACC: synchronized to ACC. (asks for a typed confirmation)"/>

            <TextBlock Text="3  Run and wipe list" FontWeight="Bold" Margin="0,8,0,4"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="Run in:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="run_cb" Width="400" Height="26" SelectedIndex="0" SelectionChanged="run_changed"
                          ToolTip="Background Revit: second Revit window(s) are started by the pyRevit CLI and do the job while you keep working here; each closes itself when done. This session: models are opened here one after another and this window waits. The open model is always wiped here.">
                    <ComboBoxItem Content="Background Revit (separate window(s) - this session stays free)"/>
                    <ComboBoxItem Content="This Revit session (one model after another, this window waits)"/>
                </ComboBox>
                <TextBlock Text="Revit instances:" VerticalAlignment="Center" Margin="12,0,6,0"
                           ToolTip="How many background Revits run at the same time. Each needs its own memory - 2 to 3 is usually the sweet spot."/>
                <ComboBox x:Name="par_cb" Width="50" Height="26" SelectedIndex="1">
                    <ComboBoxItem Content="1"/>
                    <ComboBoxItem Content="2"/>
                    <ComboBoxItem Content="3"/>
                    <ComboBoxItem Content="4"/>
                    <ComboBoxItem Content="6"/>
                    <ComboBoxItem Content="8"/>
                </ComboBox>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <Button x:Name="scan_b" Content="Scan Highlighted Model" Click="scan_click" Width="170" Height="28" FontWeight="Bold"
                        ToolTip="Opens the highlighted model (detached, read-only) just to list what can be wiped. The ticks you set then apply to EVERY ticked model."/>
                <TextBlock x:Name="info_tb" VerticalAlignment="Center" Margin="12,0,0,0" Opacity="0.75" Text="Not scanned yet."/>
            </StackPanel>
            <WrapPanel Margin="0,0,0,4">
                <TextBlock Text="Search:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="search_tb" Width="150" Height="26" VerticalContentAlignment="Center" TextChanged="search_changed"/>
                <Button Content="Tick Shown" Click="tick_shown_click" Width="80" Height="26" Margin="8,0,0,0"/>
                <Button Content="Untick Shown" Click="untick_shown_click" Width="90" Height="26" Margin="6,0,0,0"/>
                <TextBlock Text="Presets:" VerticalAlignment="Center" Margin="14,0,6,0"/>
                <Button Content="Facade Prep" Click="preset_facade_click" Width="90" Height="26"
                        ToolTip="Wipes sheets, views, annotations, links and every model category EXCEPT the building envelope (walls, curtain wall, windows, doors, roofs, floors, levels, grids)."/>
                <Button Content="Sheets &amp; Views" Click="preset_views_click" Width="100" Height="26" Margin="6,0,0,0"
                        ToolTip="Wipes only sheets, views, schedules and legends - the model elements stay."/>
                <Button Content="CAD Links" Click="preset_cad_click" Width="80" Height="26" Margin="6,0,0,0"
                        ToolTip="Wipes only the CAD links and imports (DWG, DXF, DGN...). Nothing else is ticked."/>
                <Button Content="Model Elements" Click="preset_model_click" Width="110" Height="26" Margin="6,0,0,0"
                        ToolTip="Wipes every model element (all model categories except levels and grids). Sheets, views, annotations and links stay."/>
                <Button Content="Annotations &amp; Views" Click="preset_annoviews_click" Width="140" Height="26" Margin="6,0,0,0"
                        ToolTip="Wipes every annotation / view-specific element (tags, dimensions, text, detail lines, filled regions...) and every view (plans, sections, elevations, 3D, drafting, legends, schedules). Sheets, view templates and model elements stay."/>
                <Button Content="Everything" Click="preset_all_click" Width="80" Height="26" Margin="6,0,0,0"
                        ToolTip="Ticks everything except levels, grids and purge."/>
                <Button Content="None" Click="preset_none_click" Width="55" Height="26" Margin="6,0,0,0"/>
            </WrapPanel>
            <CheckBox x:Name="others_cb" Margin="0,0,0,4"
                      Content="Also wipe categories that are NOT in the scanned model (other models in the batch may have more). Facade Prep keeps the envelope either way."
                      ToolTip="The list shows what the scanned model contains. Another model may contain categories that are not listed. Ticked: those are wiped too (envelope categories are spared after Facade Prep). Unticked: they are left alone."/>
        </StackPanel>

        <!-- ================= centre: what to wipe ================= -->
        <DataGrid x:Name="items_grid" AutoGenerateColumns="False" CanUserAddRows="False" RowHeaderWidth="0" CanUserSortColumns="False">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="Wipe" Width="50"
                                        Binding="{Binding selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <DataGridTextColumn Header="Group" Binding="{Binding group}" Width="170" IsReadOnly="True"/>
                <DataGridTextColumn Header="Item" Binding="{Binding name}" Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Count" Binding="{Binding count}" Width="70" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>

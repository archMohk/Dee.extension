<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeeRelink — Batch Update Revit Link Paths"
        ShowInTaskbar="False"
        MinHeight="560" MinWidth="900" Height="640" Width="980"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="10">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="Scans every Revit Link in each open document (one tab per document, named after it). Type or Browse a New Path per row, then click Apply to relink - nothing changes until you click Apply."/>
        <Button DockPanel.Dock="Bottom" x:Name="close_b" Content="Close" Click="close_click"
                Width="100" Height="26" HorizontalAlignment="Right" Margin="0,10,0,0"/>
        <TabControl x:Name="main_tabs"/>
    </DockPanel>
</Window>

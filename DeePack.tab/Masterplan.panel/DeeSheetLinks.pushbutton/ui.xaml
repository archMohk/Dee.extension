<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeeSheetLinks - Masterplan Bulk Sheets"
        ShowInTaskbar="False"
        MinHeight="680" MinWidth="900" Height="780" Width="960"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="10">

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="status_tb" Text="Scan links, define Sheet Types, then Preview and Create."/>
            </StatusBarItem>
        </StatusBar>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,0,0,6"
                    x:Name="progress_row" Visibility="Collapsed">
            <ProgressBar x:Name="progress_bar" Width="760" Height="18" Minimum="0" Maximum="100"/>
            <Button x:Name="cancel_b" Content="Cancel" Width="70" Height="22" Margin="8,0,0,0"
                    Click="cancel_click"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,8">
            <Button x:Name="close_b" Content="Close" Width="90" Height="30" Click="close_click"/>
        </StackPanel>

        <Border DockPanel.Dock="Top" Background="#EEF3F8" Padding="8" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock FontWeight="Bold" Text="Bulk sheets + cropped views per placed link copy"/>
                <TextBlock TextWrapping="Wrap" Margin="0,3,0,0"
                           Text="For every already-placed villa link copy, creates one Sheet + one Floor Plan view PER Sheet Type you define below - the view's Crop Region set to that villa's own footprint, and the same Building Typology / Parcel ID / Developer ID parameters DeeLinkDist wrote onto the link copied onto the view too."/>
            </StackPanel>
        </Border>

        <TabControl DockPanel.Dock="Top">
            <TabItem Header="1. Scan Links">
                <DockPanel Margin="8">
                    <GroupBox DockPanel.Dock="Top" Header="Parameter names to read from each link (same names DeeLinkDist used)"
                              Margin="0,0,0,10">
                        <Grid Margin="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Typology parameter:" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" x:Name="param_typology_tb" Height="24" Margin="4,0,10,0"
                                     VerticalContentAlignment="Center" Text="Building Typology"/>
                            <TextBlock Grid.Column="2" Text="Parcel ID parameter:" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="3" x:Name="param_parcel_tb" Height="24" Margin="4,0,10,0"
                                     VerticalContentAlignment="Center" Text="Parcel ID"/>
                            <TextBlock Grid.Column="4" Text="Developer ID parameter:" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="5" x:Name="param_developer_tb" Height="24" Margin="4,0,0,0"
                                     VerticalContentAlignment="Center" Text="Developer ID"/>
                        </Grid>
                    </GroupBox>

                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button x:Name="scan_links_b" Content="Scan Links" Width="140" Height="28" Click="scan_links_click"/>
                        <CheckBox x:Name="only_with_data_cb" Content="Only include links with Typology data" IsChecked="True"
                                  VerticalAlignment="Center" Margin="16,0,0,0" Checked="only_with_data_changed"
                                  Unchecked="only_with_data_changed"/>
                        <TextBlock x:Name="link_status_tb" VerticalAlignment="Center" Margin="16,0,0,0" FontStyle="Italic"/>
                    </StackPanel>

                    <DataGrid x:Name="links_grid" AutoGenerateColumns="False" CanUserAddRows="False" RowHeaderWidth="0">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Include" Binding="{Binding selected}" Width="60"/>
                            <DataGridTextColumn Header="Link (file) Name" Binding="{Binding link_name}" Width="220" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Typology" Binding="{Binding typology}" Width="150" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Parcel ID" Binding="{Binding parcel_id}" Width="120" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Developer ID" Binding="{Binding developer_id}" Width="*" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="2. Sheet Types">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="Define the Sheet Types every villa will get one of each - a name (used in the naming tokens as {SheetType}), the Level its cropped Floor Plan view is based on, and an optional View Template to apply. Add as many as you need - there is no fixed count."/>
                    <Button DockPanel.Dock="Top" x:Name="add_sheet_type_b" Content="Add Sheet Type" Width="150" Height="28"
                            Click="add_sheet_type_click" Margin="0,0,0,10" HorizontalAlignment="Left"/>
                    <TextBlock DockPanel.Dock="Top" x:Name="sheet_type_status_tb" Margin="0,0,0,8" FontStyle="Italic"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="sheet_types_panel"/>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <TabItem Header="3. Naming, Crop &amp; Place">
                <DockPanel Margin="8">
                    <GroupBox DockPanel.Dock="Top"
                              Header="Sheet naming - click a token below to insert it into whichever field you clicked into last, or type it directly. Modifiers: |UPPER |LOWER |TITLE |TRIM |PADn |FIRSTn |LASTn |MID:start:len |BEFORE:x |AFTER:x |BETWEEN:x:y |NUM |ALPHA |REPLACE:old:new |SPLIT:delim:n |DEFAULT:fallback"
                              Margin="0,0,0,10">
                        <StackPanel Margin="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Sheet Number:" VerticalAlignment="Center" Margin="0,0,8,6"/>
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="number_template_tb" Height="24" Margin="0,0,0,6"
                                         VerticalContentAlignment="Center" Text="{}{Serial|PAD4}"
                                         GotFocus="naming_field_focused"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Sheet Name:" VerticalAlignment="Center" Margin="0,0,8,6"/>
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="name_template_tb" Height="24" Margin="0,0,0,6"
                                         VerticalContentAlignment="Center" Text="{}{Typology} - {SheetType}"
                                         GotFocus="naming_field_focused"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="View Name:" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="2" Grid.Column="1" x:Name="view_name_template_tb" Height="24"
                                         VerticalContentAlignment="Center" Text="{}{SheetType} - {Serial|PAD4}"
                                         ToolTip="Only used for Sheet Types that create a View - must be unique project-wide, so the default includes {Serial}."
                                         GotFocus="naming_field_focused"/>
                            </Grid>
                            <WrapPanel Margin="0,6,0,0">
                                <Button Content="Typology" Tag="Typology" Height="24" Margin="0,0,4,4" Click="insert_token_click"/>
                                <Button Content="Parcel ID" Tag="ParcelID" Height="24" Margin="0,0,4,4" Click="insert_token_click"/>
                                <Button Content="Developer ID" Tag="DeveloperID" Height="24" Margin="0,0,4,4" Click="insert_token_click"/>
                                <Button Content="Link Name" Tag="LinkName" Height="24" Margin="0,0,4,4" Click="insert_token_click"/>
                                <Button Content="Sheet Type" Tag="SheetType" Height="24" Margin="0,0,4,4" Click="insert_token_click"/>
                                <Button Content="Villa Index" Tag="VillaIndex" Height="24" Margin="0,0,4,4" Click="insert_token_click"/>
                                <Button Content="Serial" Tag="Serial|PAD3" Height="24" Margin="0,0,4,4" Click="insert_token_click"/>
                                <Button Content="Alpha" Tag="Alpha" Height="24" Margin="0,0,4,4" Click="insert_token_click"/>
                                <Button Content="Date" Tag="Date" Height="24" Margin="0,0,4,4" Click="insert_token_click"/>
                            </WrapPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="Naming Set:" VerticalAlignment="Center"/>
                                <ComboBox x:Name="naming_preset_cb" Width="180" Height="26" Margin="6,0,10,0"
                                          IsEditable="True"
                                          ToolTip="Pick a saved Naming Set, or type a new name here and click Save As..."/>
                                <Button x:Name="load_preset_b" Content="Load" Width="70" Height="26" Margin="0,0,6,0"
                                        Click="load_preset_click"/>
                                <Button x:Name="save_preset_b" Content="Save As..." Width="90" Height="26" Margin="0,0,6,0"
                                        Click="save_preset_click"/>
                                <Button x:Name="delete_preset_b" Content="Delete" Width="70" Height="26"
                                        Click="delete_preset_click"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox DockPanel.Dock="Top" Header="Crop and placement" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" Margin="6">
                            <TextBlock Text="Title Block:" VerticalAlignment="Center"/>
                            <ComboBox x:Name="titleblock_cb" Width="220" Height="26" Margin="6,0,20,0"/>
                            <TextBlock Text="Crop offset:" VerticalAlignment="Center"/>
                            <TextBox x:Name="offset_tb" Width="70" Height="24" Margin="6,0,6,0" Text="0" VerticalContentAlignment="Center"/>
                            <ComboBox x:Name="offset_unit_cb" Width="110" Height="26" Margin="0,0,20,0"/>
                            <CheckBox x:Name="show_crop_cb" Content="Show crop boundary on created views" VerticalAlignment="Center"/>
                        </StackPanel>
                    </GroupBox>

                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button x:Name="preview_b" Content="Preview" Width="120" Height="30" Click="preview_click"/>
                        <Button x:Name="create_b" Content="Create Sheets &amp;&amp; Views" Width="180" Height="30" FontWeight="Bold"
                                Margin="10,0,0,0" Click="create_click"/>
                        <TextBlock x:Name="plan_status_tb" VerticalAlignment="Center" Margin="16,0,0,0" FontStyle="Italic"/>
                    </StackPanel>

                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,4" FontStyle="Italic" Foreground="#888"
                               Text="Sheet Number and Sheet Name can be edited directly in the grid below - re-checked for duplicates automatically when you click Create."/>
                    <DataGrid x:Name="plan_grid" AutoGenerateColumns="False" IsReadOnly="False" CanUserAddRows="False"
                              RowHeaderWidth="0" MaxHeight="260" Margin="0,0,0,10">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Villa" Binding="{Binding link_name}" Width="160" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Typology" Binding="{Binding typology}" Width="120" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Sheet Type" Binding="{Binding sheet_type_name}" Width="120" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Sheet Number" Binding="{Binding sheet_number}" Width="120"/>
                            <DataGridTextColumn Header="Sheet Name" Binding="{Binding sheet_name}" Width="160"/>
                            <DataGridTextColumn Header="View Name" Binding="{Binding view_name}" Width="160"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding status}" Width="*" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock DockPanel.Dock="Top" Text="Build Report:" FontWeight="Bold" Margin="0,0,0,4"/>
                    <DataGrid x:Name="report_grid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              RowHeaderWidth="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Sheet Number" Binding="{Binding sheet_number}" Width="120"/>
                            <DataGridTextColumn Header="Sheet Name" Binding="{Binding sheet_name}" Width="180"/>
                            <DataGridTextColumn Header="Sheet Type" Binding="{Binding sheet_type_name}" Width="120"/>
                            <DataGridTextColumn Header="Result" Binding="{Binding result}" Width="80"/>
                            <DataGridTextColumn Header="Message" Binding="{Binding message}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>

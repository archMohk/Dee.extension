<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeeLinkDist - Masterplan Link Distribution"
        ShowInTaskbar="False"
        MinHeight="600" MinWidth="820" Height="680" Width="880"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="10">

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="status_tb" Text="Download the template, fill it in, load it back, map typologies to links, then Place."/>
            </StatusBarItem>
        </StatusBar>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,8">
            <Button x:Name="close_b" Content="Close" Width="90" Height="30" Click="close_click"/>
        </StackPanel>

        <Border DockPanel.Dock="Top" Background="#EEF3F8" Padding="8" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock FontWeight="Bold" Text="Distribute Revit links across a masterplan"/>
                <TextBlock TextWrapping="Wrap" Margin="0,3,0,0"
                           Text="Creates a NEW instance of an already-loaded Revit link for every row of a filled-in Excel sheet, placed at that row's X/Y/Z and rotation. Existing links already placed in the model are never moved or touched."/>
            </StackPanel>
        </Border>

        <TabControl DockPanel.Dock="Top">
            <TabItem Header="1. Building Data (Excel)">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="Download the empty template, fill in one row per building (X/Y/Z in METRES, rotation in DEGREES, plus its Building Typology, Parcel ID and Developer ID), save it, then load it back here."/>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button x:Name="download_template_b" Content="Download Empty Template..." Width="200"
                                Height="28" Click="download_template_click"/>
                        <Button x:Name="load_excel_b" Content="Load Filled Excel..." Width="160" Height="28"
                                Margin="10,0,0,0" Click="load_excel_click"/>
                        <TextBlock x:Name="excel_status_tb" VerticalAlignment="Center" Margin="14,0,0,0"
                                   FontStyle="Italic"/>
                    </StackPanel>
                    <DataGrid x:Name="rows_grid" DockPanel.Dock="Top" Height="220" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False" RowHeaderWidth="0" Margin="0,0,0,10">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Row" Binding="{Binding row_number}" Width="50"/>
                            <DataGridTextColumn Header="X (m)" Binding="{Binding x}" Width="70"/>
                            <DataGridTextColumn Header="Y (m)" Binding="{Binding y}" Width="70"/>
                            <DataGridTextColumn Header="Z (m)" Binding="{Binding z}" Width="70"/>
                            <DataGridTextColumn Header="Rotation (deg)" Binding="{Binding rotation_deg}" Width="100"/>
                            <DataGridTextColumn Header="Building Typology" Binding="{Binding typology}" Width="150"/>
                            <DataGridTextColumn Header="Parcel ID" Binding="{Binding parcel_id}" Width="100"/>
                            <DataGridTextColumn Header="Developer ID" Binding="{Binding developer_id}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock DockPanel.Dock="Top" Text="Row issues:" FontWeight="Bold" Margin="0,0,0,4"/>
                    <TextBox x:Name="row_errors_tb" IsReadOnly="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" Height="70" FontFamily="Consolas" FontSize="11"/>
                </DockPanel>
            </TabItem>

            <TabItem Header="2. Map Links &amp; Place">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="Pick which already-loaded Revit link each Building Typology below should use. A typology left as '(not mapped)' is skipped when you place. Load a link into this model first (native Revit 'Link Revit') if the one you need is not offered here."/>
                    <Button DockPanel.Dock="Top" x:Name="refresh_links_b" Content="Refresh Link List"
                            Width="140" Height="26" Click="refresh_links_click" Margin="0,0,0,10"/>
                    <ScrollViewer DockPanel.Dock="Top" Height="180" VerticalScrollBarVisibility="Auto"
                                  Margin="0,0,0,10">
                        <StackPanel x:Name="mapping_panel"/>
                    </ScrollViewer>
                    <Button DockPanel.Dock="Top" x:Name="place_links_b" Content="Place Links" Width="150"
                            Height="32" FontWeight="Bold" Click="place_links_click" Margin="0,0,0,10"/>
                    <TextBlock DockPanel.Dock="Top" Text="Placement Report:" FontWeight="Bold" Margin="0,0,0,4"/>
                    <DataGrid x:Name="report_grid" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" RowHeaderWidth="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Row" Binding="{Binding row_number}" Width="50"/>
                            <DataGridTextColumn Header="Typology" Binding="{Binding typology}" Width="150"/>
                            <DataGridTextColumn Header="Result" Binding="{Binding result}" Width="80"/>
                            <DataGridTextColumn Header="Message" Binding="{Binding message}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>

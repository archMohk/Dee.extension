<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="DeeSheet — Create &amp; Manage Sheets" Height="720" Width="1050"
    MinHeight="600" MinWidth="900"
    WindowStartupLocation="CenterScreen"
    ResizeMode="CanResize"
    ShowInTaskbar="False">
    <DockPanel Margin="10">
        <Button DockPanel.Dock="Bottom" x:Name="close_b" Content="Close" Click="close_click"
                Width="100" Height="28" HorizontalAlignment="Right" Margin="0,10,0,0"/>

        <TabControl x:Name="main_tabs">
            <!-- TAB 1: Normal Creation -->
            <TabItem Header="Normal Creation">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,10" FontSize="13"
                               Text="Copy the Sheet Number column from Excel and paste it into the left box. Copy the Sheet Name column and paste it into the right box. Line 1 in both boxes = one sheet, line 2 = the next one, and so on. Numbers that already exist in the project are skipped."/>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Title Block:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="titleblock_cb" Width="320" Height="24"/>
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <DockPanel Grid.Column="0">
                            <TextBlock DockPanel.Dock="Top" Text="Sheet Number" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBox x:Name="numbers_box" AcceptsReturn="True" AcceptsTab="False"
                                     TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="13"/>
                        </DockPanel>

                        <DockPanel Grid.Column="2">
                            <TextBlock DockPanel.Dock="Top" Text="Sheet Name" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBox x:Name="names_box" AcceptsReturn="True" AcceptsTab="False"
                                     TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="13"/>
                        </DockPanel>
                    </Grid>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button x:Name="export_results_b" Content="Export Last Results to Excel" Click="export_results_click"
                                Width="190" Height="32" Margin="0,0,10,0"/>
                        <Button x:Name="create_btn" Content="Create Sheets" Width="130" Height="32" Click="create_click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- TAB 2: Super Sheet -->
            <TabItem Header="Super Sheet">
                <DockPanel Margin="10">
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Every Sheet in the project, in one editable grid (starts sorted by Number). Edit Number/Name directly in a cell. Add Row appends a new, not-yet-created sheet - click it, then Move Up/Move Down to place it wherever you want in this list (this reorders the view only, not Revit's own sheet numbering/browser order). The Delete checkbox marks an existing sheet for deletion, or just drops a not-yet-created row. Apply Changes creates/renames/deletes everything at once. Nothing changes until Apply Changes or Apply to All Sheets is clicked."/>

                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                        <TextBlock Text="Title Block:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="Bold"/>
                        <ComboBox x:Name="super_titleblock_cb" Width="320" Height="26"/>
                        <Button x:Name="super_apply_titleblock_b" Content="Apply to All Sheets" Click="super_apply_titleblock_click"
                                Width="150" Height="26" Margin="10,0,0,0"/>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button x:Name="super_scan_b" Content="Refresh Sheets" Click="super_scan_click" Width="110" Height="24"/>
                        <Button x:Name="super_add_row_b" Content="Add Row" Click="super_add_row_click" Width="90" Height="24" Margin="8,0,0,0"/>
                        <Button x:Name="super_remove_selected_b" Content="Remove Highlighted Row(s)" Click="super_remove_selected_click" Width="180" Height="24" Margin="8,0,0,0"
                                ToolTip="Click a row then Shift-click another to highlight a range (or Ctrl-click to add rows), then click this to remove/mark them."/>
                        <Button x:Name="super_move_up_b" Content="Move Up" Click="super_move_up_click" Width="80" Height="24" Margin="16,0,0,0"/>
                        <Button x:Name="super_move_down_b" Content="Move Down" Click="super_move_down_click" Width="90" Height="24" Margin="6,0,0,0"/>
                        <Button x:Name="super_apply_b" Content="Apply Changes" Click="super_apply_click" Width="130" Height="24" Margin="16,0,0,0" FontWeight="Bold"/>
                        <TextBlock x:Name="super_status_tb" Text="0 sheet(s)." VerticalAlignment="Center" Margin="16,0,0,0" FontStyle="Italic"/>
                    </StackPanel>

                    <DataGrid x:Name="super_grid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserSortColumns="False"
                              SelectionMode="Extended" SelectionUnit="FullRow" RowEditEnding="super_grid_row_edit_ending">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Delete" Binding="{Binding marked_delete, Mode=TwoWay}" Width="55"/>
                            <DataGridTextColumn Header="Sheet Number" Binding="{Binding number, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="140"/>
                            <DataGridTextColumn Header="Sheet Name" Binding="{Binding name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="*"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding status_text}" IsReadOnly="True" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>

<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeeQs - Quantity Surveying / BOQ"
        ShowInTaskbar="False"
        MinHeight="650" MinWidth="1050" Height="740" Width="1150"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="10">
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="status_tb" Text="Ready."/>
            </StatusBarItem>
        </StatusBar>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,8">
            <Button x:Name="close_b" Content="Close" Width="90" Height="30" Click="close_click"/>
        </StackPanel>

        <TabControl x:Name="main_tabs">

            <TabItem Header="1. Scan">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Pick which categories to include (defaults to every model category found in the project) and the parameter to segregate quantities by (e.g. Level). 'Then By' is optional - set it too for a 2nd-level grouping (e.g. Level, then Material). Scan computes a real measured quantity per element (Area/Volume/Length/Count depending on category) and pivots it against those value(s)."/>

                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <GroupBox Grid.Column="0" Header="Categories">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                                    <Button x:Name="cat_all_b" Content="Check All" Width="90" Height="22" Click="cat_all_click"/>
                                    <Button x:Name="cat_none_b" Content="Check None" Width="90" Height="22" Margin="6,0,0,0" Click="cat_none_click"/>
                                </StackPanel>
                                <ListBox x:Name="category_lb" Height="160">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding name}" IsChecked="{Binding checked, Mode=TwoWay}"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </GroupBox>

                        <GroupBox Grid.Column="2" Header="Segregate By Parameter">
                            <DockPanel>
                                <TextBox DockPanel.Dock="Top" x:Name="param_search_tb" Height="24" TextChanged="param_search_changed"/>
                                <ListBox x:Name="param_suggestions_lb" Height="130" Margin="0,4,0,0"
                                         SelectionChanged="param_suggestion_selected"/>
                            </DockPanel>
                        </GroupBox>

                        <GroupBox Grid.Column="4" Header="Then By (optional)">
                            <DockPanel>
                                <TextBox DockPanel.Dock="Top" x:Name="param2_search_tb" Height="24" TextChanged="param2_search_changed"/>
                                <ListBox x:Name="param2_suggestions_lb" Height="130" Margin="0,4,0,0"
                                         SelectionChanged="param2_suggestion_selected"/>
                            </DockPanel>
                        </GroupBox>
                    </Grid>

                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button x:Name="scan_b" Content="Scan" Width="110" Height="30" Click="scan_click"/>
                        <Button x:Name="generate_boq_b" Content="Generate BOQ Structure &gt;&gt;" Width="190" Height="30"
                                Margin="10,0,0,0" FontWeight="Bold" Click="generate_boq_click"/>
                    </StackPanel>

                    <DataGrid x:Name="pivot_grid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              SelectionMode="Extended" SelectionUnit="FullRow">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Segregation Value" Binding="{Binding segregation_value}" Width="220"/>
                            <DataGridTextColumn Header="Category" Binding="{Binding category_name}" Width="220"/>
                            <DataGridTextColumn Header="Quantity" Binding="{Binding quantity_text}" Width="120"/>
                            <DataGridTextColumn Header="Unit" Binding="{Binding unit}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="2. BOQ Structure">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0">
                        <TextBlock DockPanel.Dock="Top" Text="Sections (one per segregation value):" Margin="0,0,0,4" TextWrapping="Wrap"/>
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                            <TextBox x:Name="section_name_tb" Height="24" Margin="0,0,0,4"/>
                            <Button x:Name="section_add_b" Content="Add Section" Height="26" Click="section_add_click"/>
                            <Button x:Name="section_rename_b" Content="Rename Selected To Above" Height="26" Margin="0,4,0,0" Click="section_rename_click"/>
                            <Button x:Name="section_delete_b" Content="Delete Section" Height="26" Margin="0,4,0,0" Click="section_delete_click"/>
                        </StackPanel>
                        <ListBox x:Name="sections_lb" DisplayMemberPath="label" SelectionChanged="sections_lb_selection_changed"/>
                    </DockPanel>

                    <DockPanel Grid.Column="2">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBox x:Name="item_desc_tb" Width="200" Height="24" VerticalContentAlignment="Center"/>
                            <Button x:Name="item_add_b" Content="Add Item" Width="100" Height="26" Margin="6,0,0,0" Click="item_add_click"/>
                            <Button x:Name="item_delete_b" Content="Delete Item(s)" Width="110" Height="26" Margin="6,0,0,0" Click="item_delete_click"/>
                            <Button x:Name="item_up_b" Content="Move Up" Width="90" Height="26" Margin="6,0,0,0" Click="item_up_click"/>
                            <Button x:Name="item_down_b" Content="Move Down" Width="90" Height="26" Margin="6,0,0,0" Click="item_down_click"/>
                        </StackPanel>

                        <TextBlock DockPanel.Dock="Bottom" x:Name="grand_total_tb" Margin="0,8,0,0" FontWeight="Bold"
                                   Text="Grand Total: 0.00"/>

                        <DataGrid x:Name="items_grid" AutoGenerateColumns="False" CanUserAddRows="False"
                                  SelectionMode="Extended" SelectionUnit="FullRow" RowEditEnding="items_grid_row_edit_ending">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Item No" Binding="{Binding item_no}" IsReadOnly="True" Width="70"/>
                                <DataGridTextColumn Header="Description" Binding="{Binding description}" Width="*"/>
                                <DataGridTextColumn Header="Unit" Binding="{Binding unit}" Width="70"/>
                                <DataGridTextColumn Header="Quantity" Binding="{Binding quantity_edit}" Width="90"/>
                                <DataGridTextColumn Header="Rate" Binding="{Binding rate_edit}" Width="90"/>
                                <DataGridTextColumn Header="Amount" Binding="{Binding amount_text}" IsReadOnly="True" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Grid>
            </TabItem>

            <TabItem Header="3. Preview &amp; Export">
                <DockPanel Margin="8">
                    <GroupBox DockPanel.Dock="Top" Header="Project Info" Margin="0,0,0,8">
                        <Grid Margin="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Project Name:" Margin="0,4,6,4" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="project_name_tb" Margin="0,4,16,4"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Project No:" Margin="0,4,6,4" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="0" Grid.Column="3" x:Name="project_no_tb" Margin="0,4,0,4"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Client:" Margin="0,4,6,4" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="client_tb" Margin="0,4,16,4"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Consultant:" Margin="0,4,6,4" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="1" Grid.Column="3" x:Name="consultant_tb" Margin="0,4,0,4"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Date:" Margin="0,4,6,4" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="2" Grid.Column="1" x:Name="date_tb" Margin="0,4,16,4"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="Currency Symbol:" Margin="0,4,6,4" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="2" Grid.Column="3" x:Name="currency_tb" Margin="0,4,0,4" Text="$"/>
                        </Grid>
                    </GroupBox>

                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button x:Name="preview_b" Content="Preview" Width="120" Height="30" Click="preview_click"/>
                        <Button x:Name="export_b" Content="Export to Excel" Width="150" Height="30" Margin="10,0,0,0" FontWeight="Bold" Click="export_click"/>
                        <Button x:Name="export_advanced_b" Content="Export Advanced (3-sheet)" Width="190" Height="30" Margin="10,0,0,0" FontWeight="Bold" Click="export_advanced_click"/>
                    </StackPanel>

                    <TextBlock TextWrapping="Wrap"
                               Text="Preview shows exactly what will be exported (Sections, Items, Subtotals, Grand Total) in the pyRevit output window. Export to Excel writes a single styled sheet. Export Advanced writes a 3-sheet workbook (Summary section totals, Detailed item breakdown, and a hidden Data sheet with every scanned element's raw quantity for audit)."/>
                </DockPanel>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>

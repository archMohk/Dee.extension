<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeeAI — Revit AI Assistant"
        ShowInTaskbar="False"
        MinHeight="560" MinWidth="760" Height="640" Width="860"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="10">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="DeeAI writes IronPython code and runs it directly against this document to answer questions or make changes - there is no per-action confirmation. Each message you send is wrapped in one Transaction, so Undo (Ctrl+Z) reverts everything from that message in one step. Your API key is never saved - re-enter it each time you open this window."/>

        <GroupBox DockPanel.Dock="Top" Header="Connection" Margin="0,0,0,8">
            <StackPanel Margin="6">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="Anthropic API Key:" VerticalAlignment="Center" Width="130"/>
                    <PasswordBox x:Name="api_key_pb" Width="360" Height="24" VerticalContentAlignment="Center"/>
                    <TextBlock Text="(not saved - re-enter each session)" VerticalAlignment="Center" Margin="10,0,0,0" FontStyle="Italic"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Model:" VerticalAlignment="Center" Width="130"/>
                    <ComboBox x:Name="model_cb" Width="180" Height="24"/>
                    <TextBlock Text="Effort:" VerticalAlignment="Center" Width="60" Margin="20,0,0,0"/>
                    <ComboBox x:Name="effort_cb" Width="100" Height="24"/>
                    <Button x:Name="new_conversation_b" Content="New Conversation" Click="new_conversation_click" Width="130" Height="24" Margin="20,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <TextBlock DockPanel.Dock="Bottom" x:Name="status_tb" Text="Ready." Margin="0,6,0,0" FontStyle="Italic"/>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0" HorizontalAlignment="Right">
            <Button x:Name="close_b" Content="Close" Click="close_click" Width="90" Height="28"/>
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Button DockPanel.Dock="Right" x:Name="send_b" Content="Send" Click="send_click" Width="90" Height="52" Margin="8,0,0,0"/>
            <TextBox x:Name="input_tb" Height="52" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
        </DockPanel>

        <TextBox x:Name="transcript_tb" IsReadOnly="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas" FontSize="12" Background="#1e1e1e" Foreground="#d4d4d4"/>
    </DockPanel>
</Window>

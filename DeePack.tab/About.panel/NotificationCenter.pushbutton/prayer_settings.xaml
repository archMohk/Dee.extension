<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dee.extension — Prayer Times"
        ShowInTaskbar="False"
        Height="400" Width="420" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="14">
        <Button DockPanel.Dock="Bottom" x:Name="close_b" Content="Close" Click="close_click"
                Width="100" Height="28" HorizontalAlignment="Right" Margin="0,12,0,0"/>

        <StackPanel>
            <CheckBox x:Name="prayer_enabled_cb" Content="Show a notification at each prayer time"
                      Margin="0,0,0,10" Checked="prayer_setting_changed" Unchecked="prayer_setting_changed"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <CheckBox x:Name="prayer_reminder_cb" Content="Also remind me"
                          VerticalAlignment="Center" Checked="prayer_reminder_changed" Unchecked="prayer_reminder_changed"/>
                <TextBox x:Name="prayer_reminder_minutes_tb" Width="36" Height="22" Margin="6,0,6,0"
                         TextAlignment="Center" LostFocus="prayer_reminder_minutes_changed"/>
                <TextBlock Text="minutes before each prayer" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <TextBlock Text="Time format:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <RadioButton x:Name="prayer_format_24_rb" Content="24-hour" GroupName="prayerTimeFormat"
                             VerticalAlignment="Center" Checked="prayer_format_changed"/>
                <RadioButton x:Name="prayer_format_12_rb" Content="12-hour" GroupName="prayerTimeFormat"
                             VerticalAlignment="Center" Margin="16,0,0,0" Checked="prayer_format_changed"/>
            </StackPanel>

            <TextBlock x:Name="prayer_location_tb" FontSize="11" FontWeight="SemiBold"
                       Foreground="#9e9e9e" Margin="0,0,0,6" Text=""/>

            <Border x:Name="prayer_times_card" Background="#f2f2f4" CornerRadius="5" Padding="8,8">
                <Grid x:Name="prayer_times_grid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Fajr" HorizontalAlignment="Center"
                               TextWrapping="Wrap" TextAlignment="Center" FontSize="10" Foreground="#888"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Dhuhr" HorizontalAlignment="Center"
                               TextWrapping="Wrap" TextAlignment="Center" FontSize="10" Foreground="#888"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Asr" HorizontalAlignment="Center"
                               TextWrapping="Wrap" TextAlignment="Center" FontSize="10" Foreground="#888"/>
                    <TextBlock Grid.Row="0" Grid.Column="3" Text="Maghrib" HorizontalAlignment="Center"
                               TextWrapping="Wrap" TextAlignment="Center" FontSize="10" Foreground="#888"/>
                    <TextBlock Grid.Row="0" Grid.Column="4" Text="Isha" HorizontalAlignment="Center"
                               TextWrapping="Wrap" TextAlignment="Center" FontSize="10" Foreground="#888"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" x:Name="prayer_time_fajr" Text="—"
                               HorizontalAlignment="Center" FontWeight="Bold" FontSize="14" Margin="0,4,0,0"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="prayer_time_dhuhr" Text="—"
                               HorizontalAlignment="Center" FontWeight="Bold" FontSize="14" Margin="0,4,0,0"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" x:Name="prayer_time_asr" Text="—"
                               HorizontalAlignment="Center" FontWeight="Bold" FontSize="14" Margin="0,4,0,0"/>
                    <TextBlock Grid.Row="1" Grid.Column="3" x:Name="prayer_time_maghrib" Text="—"
                               HorizontalAlignment="Center" FontWeight="Bold" FontSize="14" Margin="0,4,0,0"/>
                    <TextBlock Grid.Row="1" Grid.Column="4" x:Name="prayer_time_isha" Text="—"
                               HorizontalAlignment="Center" FontWeight="Bold" FontSize="14" Margin="0,4,0,0"/>
                </Grid>
            </Border>
        </StackPanel>
    </DockPanel>
</Window>

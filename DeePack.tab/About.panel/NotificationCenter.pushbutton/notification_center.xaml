<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dee.extension — Notification Center"
        ShowInTaskbar="False"
        Height="600" Width="440" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="14">
        <Button DockPanel.Dock="Bottom" x:Name="close_b" Content="Close" Click="close_click"
                Width="100" Height="28" HorizontalAlignment="Right" Margin="0,12,0,0"/>

        <!-- ScrollViewer as a safety net, not just a taller Height - a
             plain StackPanel silently CLIPS content that doesn't fit
             instead of erroring, which is exactly how the DeeCall button
             went missing the first time this shipped. -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <TextBlock Text="Notification appearance" FontWeight="Bold" Margin="0,0,0,8"/>
            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#888" Margin="0,0,0,10"
                       Text="Applies to every notification this extension shows - prayer times and DeeCall announcements alike."/>

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Position:" VerticalAlignment="Center" Margin="0,0,0,8"/>
                <ComboBox Grid.Row="0" Grid.Column="1" x:Name="position_cb" Width="180" Height="24"
                          HorizontalAlignment="Left" Margin="0,0,0,8" SelectionChanged="appearance_changed"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Width:" VerticalAlignment="Center" Margin="0,0,0,8"/>
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBox x:Name="width_tb" Width="60" Height="22" TextAlignment="Center" LostFocus="appearance_changed"/>
                    <TextBlock Text="px" VerticalAlignment="Center" Margin="6,0,0,0"/>
                </StackPanel>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Height:" VerticalAlignment="Center" Margin="0,0,0,8"/>
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBox x:Name="height_tb" Width="60" Height="22" TextAlignment="Center" LostFocus="appearance_changed"/>
                    <TextBlock Text="px" VerticalAlignment="Center" Margin="6,0,0,0"/>
                </StackPanel>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Stays for:" VerticalAlignment="Center"/>
                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                    <TextBox x:Name="duration_tb" Width="60" Height="22" TextAlignment="Center" LostFocus="appearance_changed"/>
                    <TextBlock Text="seconds" VerticalAlignment="Center" Margin="6,0,0,0"/>
                </StackPanel>
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="Preview theme:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <RadioButton x:Name="theme_dark_rb" Content="Dark" GroupName="hubPreviewTheme"
                             VerticalAlignment="Center" IsChecked="True"/>
                <RadioButton x:Name="theme_light_rb" Content="Light" GroupName="hubPreviewTheme"
                             VerticalAlignment="Center" Margin="10,0,0,0"/>
                <RadioButton x:Name="theme_colored_rb" Content="Colored" GroupName="hubPreviewTheme"
                             VerticalAlignment="Center" Margin="10,0,0,0"/>
            </StackPanel>
            <Button x:Name="test_notification_b" Content="Test Notification" Width="160" Height="28"
                    HorizontalAlignment="Left" Margin="0,0,0,16" Click="test_notification_click"/>

            <Border BorderBrush="#3a3f4d" BorderThickness="0,1,0,0" Padding="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="Notifications" FontWeight="Bold" Margin="0,0,0,8"/>
                    <!-- Hover-highlight cards, not plain Buttons - same whole-card
                         click/hover pattern as DeeLazy's module launcher
                         (wired in script.py, not here - see _wire_card). -->
                    <Border x:Name="prayer_card_b" Height="52" Margin="0,0,0,8" CornerRadius="6"
                            BorderThickness="1" Background="Transparent">
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Prayer Times" FontWeight="Bold" FontSize="14"/>
                            <TextBlock Text="On/off, reminder lead time, 12h/24h format" FontSize="11" Foreground="#888"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="deecall_card_b" Height="52" CornerRadius="6"
                            BorderThickness="1" Background="Transparent">
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="DeeCall" FontWeight="Bold" FontSize="14"/>
                            <TextBlock Text="Send an announcement to everyone" FontSize="11" Foreground="#888"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>

<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeeControl — Turn DeePack Buttons On and Off"
        ShowInTaskbar="False"
        MinHeight="640" MinWidth="1000" Height="780" Width="1120"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="10">

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem><TextBlock x:Name="status_tb" Text="Ready."/></StatusBarItem>
        </StatusBar>

        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="Untick anything you do not want on the DeePack ribbon. A panel disappears on its own once everything inside it is off, and About / DeeControl are always on so you can never lock yourself out. Nothing changes in Revit until you click Apply — and even then the ribbon only rebuilds after a pyRevit reload."/>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
            <TextBlock Text="Filter:" VerticalAlignment="Center"/>
            <TextBox x:Name="search_tb" Width="240" Height="24" Margin="6,0,0,0"
                     TextChanged="search_changed"
                     ToolTip="Type any number of words — a row must match all of them, in its name, type or brief."/>
            <CheckBox x:Name="buttons_only_cb" Content="Buttons only" VerticalAlignment="Center"
                      Margin="14,0,0,0" Click="search_changed"
                      ToolTip="Hides the panel and group rows so you only see the actual buttons."/>
            <Button x:Name="all_on_b" Content="All On" Width="80" Height="24" Margin="18,0,0,0" Click="all_on_click"/>
            <Button x:Name="all_off_b" Content="All Off" Width="80" Height="24" Margin="6,0,0,0" Click="all_off_click"/>
            <Button x:Name="invert_b" Content="Invert" Width="80" Height="24" Margin="6,0,0,0" Click="invert_click"/>
            <Button x:Name="shown_on_b" Content="Shown On" Width="90" Height="24" Margin="18,0,0,0" Click="shown_on_click"
                    ToolTip="Switches on every row currently passing the filter."/>
            <Button x:Name="shown_off_b" Content="Shown Off" Width="90" Height="24" Margin="6,0,0,0" Click="shown_off_click"/>
        </StackPanel>

        <Border DockPanel.Dock="Bottom" BorderBrush="#F2994D" BorderThickness="2" CornerRadius="4"
                Padding="10" Margin="0,8,0,6">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="apply_b" Content="Apply Changes" Width="150" Height="30"
                            FontWeight="Bold" Click="apply_click"/>
                    <Button x:Name="reload_b" Content="Reload pyRevit Now" Width="170" Height="30"
                            Margin="10,0,0,0" Click="reload_click"
                            ToolTip="Rebuilds the ribbon so your changes show up. You can also do this later from the pyRevit tab."/>
                    <Button x:Name="reset_b" Content="Reset — Turn Everything On" Width="200" Height="30"
                            Margin="10,0,0,0" Click="reset_click"/>
                    <Button x:Name="close_b" Content="Close" Width="90" Height="30" Margin="10,0,0,0" Click="close_click"/>
                </StackPanel>
                <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0"
                           Text="Apply rewrites the layout list inside each panel's bundle.yaml — the same mechanism pyRevit itself uses to decide what to build. Those files are tracked in git, so your choices show up as normal repository changes you can review or revert."/>
                <TextBlock x:Name="pending_tb" TextWrapping="Wrap" FontSize="12" FontWeight="Bold"
                           Foreground="#FFB300" Margin="0,6,0,0" Text=""/>
            </StackPanel>
        </Border>

        <DataGrid x:Name="items_grid" AutoGenerateColumns="False" CanUserAddRows="False"
                  SelectionMode="Extended" SelectionUnit="FullRow" FontFamily="Consolas">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="On" Binding="{Binding enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="45"/>
                <DataGridTextColumn Header="Name" Binding="{Binding display_name}" IsReadOnly="True" Width="260"/>
                <DataGridTextColumn Header="Type" Binding="{Binding kind}" IsReadOnly="True" Width="80"/>
                <DataGridTextColumn Header="What it does" Binding="{Binding brief}" IsReadOnly="True" Width="*"/>
                <DataGridTextColumn Header="Note" Binding="{Binding note}" IsReadOnly="True" Width="190"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>

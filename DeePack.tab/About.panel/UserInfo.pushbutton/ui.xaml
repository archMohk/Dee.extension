<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dee.extension — User Info"
        ShowInTaskbar="False"
        Height="480" Width="440" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="14">

        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Border BorderBrush="#3a3f4d" BorderThickness="0,1,0,0" Margin="0,0,0,10" Padding="0,10,0,0">
                <StackPanel>
                    <TextBlock Text="Prayer time notifications" FontWeight="Bold" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal">
                        <CheckBox x:Name="prayer_enabled_cb" Content="Show a notification at each prayer time"
                                  VerticalAlignment="Center" Checked="prayer_setting_changed" Unchecked="prayer_setting_changed"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="Stays on screen for" VerticalAlignment="Center"/>
                        <TextBox x:Name="prayer_duration_tb" Width="40" Height="22" Margin="6,0,6,0"
                                 TextAlignment="Center" LostFocus="prayer_duration_changed"/>
                        <TextBlock Text="seconds" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="prayer_location_tb" FontSize="11" Foreground="#9e9e9e" Margin="0,8,0,3" Text=""/>
                    <TextBlock x:Name="prayer_times_tb" FontSize="12" TextWrapping="Wrap" Text=""/>
                </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="check_now_b" Content="Check Now" Width="110" Height="28" Click="check_now_click"
                        ToolTip="Runs a fresh check against the server instead of showing the last cached result."/>
                <Button x:Name="reenter_b" Content="Re-enter Email" Width="120" Height="28" Margin="8,0,0,0" Click="reenter_click"/>
                <Button x:Name="close_b" Content="Close" Width="90" Height="28" Margin="8,0,0,0" Click="close_click"/>
            </StackPanel>
            <TextBlock x:Name="contact_tb" TextWrapping="Wrap" FontSize="11" Margin="0,10,0,0"
                       Foreground="#9e9e9e" Text=""/>
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Signed in as:" FontWeight="Bold" Margin="0,0,0,10"/>
            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="email_tb" TextWrapping="Wrap" Margin="0,0,0,10" Text=""/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Access status:" FontWeight="Bold" Margin="0,0,0,10"/>
            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="status_tb" TextWrapping="Wrap" FontWeight="Bold" FontSize="14" Margin="0,0,0,10" Text=""/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Expires:" FontWeight="Bold" Margin="0,0,0,10"/>
            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="expires_tb" TextWrapping="Wrap" Margin="0,0,0,10" Text=""/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="ACC:" FontWeight="Bold" Margin="0,0,0,10"/>
            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="acc_tb" TextWrapping="Wrap" Margin="0,0,0,10" Text=""/>
        </Grid>
    </DockPanel>
</Window>

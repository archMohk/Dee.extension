<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update DeePack"
        Height="580" Width="470"
        MinHeight="420" MinWidth="430"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False">
    <!-- DockPanel, not a StackPanel: the buttons dock to the bottom and
         therefore cannot be pushed off the window by text above them.
         The previous version was a fixed-height StackPanel, and as soon
         as the status line wrapped to three lines the buttons went
         under the branding bar. What is left over scrolls instead. -->
    <DockPanel Margin="20,18,20,10">

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Center" Margin="0,12,0,0">
            <Button x:Name="check_b" Content="Check for Updates" Click="check_click"
                    Width="140" Height="30" Margin="0,0,8,0"/>
            <Button x:Name="update_b" Content="Update Now" Click="update_click"
                    Width="110" Height="30" Margin="0,0,8,0" FontWeight="Bold"/>
            <Button x:Name="cancel_b" Content="Cancel" Click="cancel_click"
                    Width="90" Height="30"/>
        </StackPanel>

        <Button DockPanel.Dock="Bottom" x:Name="website_b" Content="www.archmkd.com"
                Click="website_click" HorizontalAlignment="Center"
                Padding="14,5" Margin="0,12,0,0" Cursor="Hand"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Image x:Name="logo_img" Width="56" Height="56" Margin="0,0,0,8"/>
                <TextBlock Text="Update DeePack" FontSize="19" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,0,0,8"/>

                <TextBlock TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,12"
                           Text="Both sources carry exactly the same files. Use the mirror if your network blocks github.com."/>

                <GroupBox Header="Update from" Margin="0,0,0,10">
                    <StackPanel Margin="8">
                        <RadioButton x:Name="source_github_rb" GroupName="source" IsChecked="True"
                                     Content="GitHub  —  git pull (the normal route)"/>
                        <TextBlock Margin="22,2,0,8" Foreground="#888" FontSize="11" TextWrapping="Wrap"
                                   Text="Uses pyRevit's own updater. Only works if this copy was installed with 'pyrevit extend'."/>

                        <RadioButton x:Name="source_mirror_rb" GroupName="source"
                                     Content="Supabase mirror  —  direct download"/>
                        <TextBlock Margin="22,2,0,0" Foreground="#888" FontSize="11" TextWrapping="Wrap"
                                   Text="Downloads only the files that actually changed. Needs no git and no GitHub access."/>
                    </StackPanel>
                </GroupBox>

                <Border BorderBrush="#666" BorderThickness="1" Padding="8">
                    <TextBlock x:Name="status_tb" FontSize="11" TextWrapping="Wrap"
                               Text="Checking how this copy was installed..."/>
                </Border>
            </StackPanel>
        </ScrollViewer>

    </DockPanel>
</Window>

<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dee.extension — DeeIcon"
        ShowInTaskbar="False"
        Height="590" Width="440" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="14">
        <Button DockPanel.Dock="Bottom" x:Name="close_b" Content="Close" Click="close_click"
                Width="100" Height="28" HorizontalAlignment="Right" Margin="0,12,0,0"/>

        <StackPanel>
            <TextBlock Text="Brand the Real File Thumbnail" FontWeight="Bold" Margin="0,0,0,8"/>
            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#888" Margin="0,0,0,10"
                       Text="Shows the Revit version and your logo on the file's own thumbnail - the one Windows Explorer and Revit's Recent Files screen both show. Applied automatically whenever the project is opened or saved; no separate file is created."/>

            <Border BorderBrush="{DynamicResource DeeOrange}" BorderThickness="2" CornerRadius="4"
                    Padding="10" Margin="0,0,0,14">
                <DockPanel>
                    <Button x:Name="power_b" DockPanel.Dock="Right" Width="110" Height="30"
                            FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0"
                            Click="power_click"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="power_tb" FontWeight="Bold" FontSize="14"/>
                        <TextBlock x:Name="power_note_tb" TextWrapping="Wrap" FontSize="11"
                                   Foreground="#888" Margin="0,2,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <TextBlock Text="Custom logo:" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Border x:Name="logo_preview_border" Width="80" Height="80" BorderBrush="Gray"
                        BorderThickness="1" Margin="0,0,10,0" Visibility="Collapsed">
                    <Image x:Name="logo_preview_img" Stretch="Uniform" Margin="4"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <Button x:Name="pick_logo_b" Content="Pick Logo..." Width="120" Height="26"
                            Margin="0,0,0,6" Click="pick_logo_click"/>
                    <Button x:Name="remove_logo_b" Content="Remove Logo" Width="120" Height="26"
                            Click="remove_logo_click" Visibility="Collapsed"/>
                </StackPanel>
            </StackPanel>
            <TextBlock x:Name="logo_status_tb" Text="No logo selected." FontSize="11" Foreground="#888" Margin="0,0,0,14"/>

            <Border BorderBrush="#3a3f4d" BorderThickness="0,1,0,0" Padding="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="This document" FontWeight="Bold" Margin="0,0,0,6"/>
                    <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#888" Margin="0,0,0,8"
                               Text="Apply puts the branding in the open document now. Remove (while DeeIcon is off) deletes the DeeIcon view and gives the file its own thumbnail back at the next save."/>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="generate_now_b" Content="Apply To This Document" Width="180" Height="28"
                                Click="apply_now_click"/>
                        <Button x:Name="remove_now_b" Content="Remove From This Document" Width="190" Height="28"
                                Margin="10,0,0,0" Click="remove_now_click"/>
                    </StackPanel>
                    <TextBlock x:Name="generate_status_tb" TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </DockPanel>
</Window>

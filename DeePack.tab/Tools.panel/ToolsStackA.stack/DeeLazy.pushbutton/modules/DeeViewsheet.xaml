<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeeViewsheet — Write Sheet Info onto Views"
        ShowInTaskbar="False"
        MinHeight="600" MinWidth="1000" Height="680" Width="1080"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="10">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="Every view placed on a sheet, and the sheet it sits on. Pick what to write (Sheet Number, Sheet Name, or both) and which text parameter on the view to write it into - or create a new Shared parameter below. Views placed on MORE THAN ONE sheet (legends, some schedules) are skipped, since there is no single correct sheet for them."/>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="status_tb" Text="Ready."/>
            </StatusBarItem>
        </StatusBar>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,8">
            <Button x:Name="apply_b" Content="Write to Views" Width="150" Height="30" FontWeight="Bold" Click="apply_click"/>
            <Button x:Name="close_b" Content="Close" Width="90" Height="30" Margin="16,0,0,0" Click="close_click"/>
        </StackPanel>

        <GroupBox DockPanel.Dock="Top" Header="What to write" Margin="0,0,0,8">
            <Grid Margin="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Write:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox Grid.Column="1" x:Name="source_cb" Height="24" SelectionChanged="source_changed"/>

                <TextBlock Grid.Column="3" Text="Into parameter:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox Grid.Column="4" x:Name="param_cb" Height="24" SelectionChanged="param_changed"/>

                <Button Grid.Column="6" x:Name="rescan_b" Content="Rescan" Width="90" Height="24" Click="scan_click"/>
            </Grid>
        </GroupBox>

        <GroupBox DockPanel.Dock="Top" Header="Don't have a suitable parameter? Create one" Margin="0,0,0,8">
            <StackPanel Margin="6">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="New parameter name:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="new_param_tb" Width="240" Height="24" VerticalContentAlignment="Center"/>
                    <Button x:Name="create_param_b" Content="Create Shared Parameter" Width="190" Height="24"
                            Margin="10,0,0,0" Click="create_param_click"/>
                </StackPanel>
                <TextBlock TextWrapping="Wrap" Foreground="#888" FontSize="11" Margin="0,6,0,0"
                           Text="Creates a text Shared parameter bound to the Views category (instance), so it can be used in view lists, schedules, tags and view titles. It is added to your existing shared parameter file, or a new one is created next to the project if you have none set."/>
            </StackPanel>
        </GroupBox>

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <CheckBox x:Name="unlock_templates_cb" IsChecked="True"
                      Content="Exclude this parameter from the View Templates that control it (so it can be set per view)"/>
            <TextBlock TextWrapping="Wrap" Foreground="#888" FontSize="11" Margin="18,3,0,0"
                       Text="A parameter a View Template controls is read-only on every view using it, so writing would fail. This unticks it in the template's Include list - the template keeps controlling everything else. It changes those templates for the whole project, and the report lists exactly which ones were edited."/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="select_all_b" Content="Select All" Width="90" Height="24" Click="select_all_click"/>
            <Button x:Name="select_none_b" Content="Select None" Width="90" Height="24" Margin="6,0,0,0" Click="select_none_click"/>
        </StackPanel>

        <DataGrid x:Name="rows_grid" AutoGenerateColumns="False" CanUserAddRows="False"
                  CanUserSortColumns="True" SelectionMode="Extended" SelectionUnit="FullRow" RowHeaderWidth="0">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="Write" Binding="{Binding selected, Mode=TwoWay}" Width="55"/>
                <DataGridTextColumn Header="View" Binding="{Binding view_name}" IsReadOnly="True" Width="*"/>
                <DataGridTextColumn Header="View Type" Binding="{Binding view_type}" IsReadOnly="True" Width="110"/>
                <DataGridTextColumn Header="Sheet(s)" Binding="{Binding sheets_text}" IsReadOnly="True" Width="130"/>
                <DataGridTextColumn Header="Sheet Name" Binding="{Binding sheet_name}" IsReadOnly="True" Width="160"/>
                <DataGridTextColumn Header="View Template" Binding="{Binding template_name}" IsReadOnly="True" Width="130"/>
                <DataGridTextColumn Header="Current Value" Binding="{Binding current_value}" IsReadOnly="True" Width="140"/>
                <DataGridTextColumn Header="Will Write" Binding="{Binding new_value}" IsReadOnly="True" Width="140"/>
                <DataGridTextColumn Header="Status" Binding="{Binding status}" IsReadOnly="True" Width="180"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>

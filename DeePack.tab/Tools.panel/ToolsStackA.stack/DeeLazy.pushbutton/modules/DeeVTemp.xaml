<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeeLazy — DeeVTEMP: View Template Bulk Editor"
        ShowInTaskbar="False"
        MinHeight="560" MinWidth="980" Height="640" Width="1060"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="10">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="Applies ONE change to MANY View Templates at once. First action: set the Revit Links display setting (the same 'By Host View / By Linked View' choice you'd otherwise set one link at a time, in each template's own Visibility/Graphics Overrides dialog) across every selected View Template, for every selected Revit Link."/>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="status_tb" Text="Ready."/>
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.3*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- ===================== LEFT PANEL - View Templates ===================== -->
            <DockPanel Grid.Column="0" Margin="0,0,8,0">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="View Templates" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Button x:Name="refresh_templates_b" Content="Refresh" Click="refresh_templates_click" Width="80" Height="24" Margin="14,0,0,0"/>
                    <Button x:Name="templates_select_all_b" Content="Select All" Click="templates_select_all_click" Width="85" Height="24" Margin="6,0,0,0"/>
                    <Button x:Name="templates_select_none_b" Content="Select None" Click="templates_select_none_click" Width="90" Height="24" Margin="6,0,0,0"/>
                </StackPanel>
                <DataGrid x:Name="templates_grid" AutoGenerateColumns="False" CanUserAddRows="False"
                          CanUserSortColumns="True" SelectionMode="Extended" RowHeaderWidth="0">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="Select" Binding="{Binding selected, Mode=TwoWay}" Width="55"/>
                        <DataGridTextColumn Header="View Template" Binding="{Binding name}" Width="*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="View Type" Binding="{Binding view_type}" Width="110" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <!-- ===================== MIDDLE PANEL - Revit Links ===================== -->
            <DockPanel Grid.Column="1" Margin="0,0,8,0">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="Revit Links" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Button x:Name="refresh_links_b" Content="Refresh" Click="refresh_links_click" Width="80" Height="24" Margin="14,0,0,0"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                    <Button x:Name="links_select_all_b" Content="Select All" Click="links_select_all_click" Width="85" Height="24"/>
                    <Button x:Name="links_select_none_b" Content="Select None" Click="links_select_none_click" Width="90" Height="24" Margin="6,0,0,0"/>
                </StackPanel>
                <DataGrid x:Name="links_grid" AutoGenerateColumns="False" CanUserAddRows="False"
                          CanUserSortColumns="True" SelectionMode="Extended" RowHeaderWidth="0">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="Select" Binding="{Binding selected, Mode=TwoWay}" Width="55"/>
                        <DataGridTextColumn Header="Linked File" Binding="{Binding name}" Width="*" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <!-- ===================== RIGHT PANEL - Options + Report ===================== -->
            <DockPanel Grid.Column="2">
                <GroupBox DockPanel.Dock="Top" Header="Revit Links Display Setting" Margin="0,0,0,8">
                    <StackPanel Margin="6">
                        <RadioButton x:Name="option_host_rb" Content="By Host View" GroupName="link_display" IsChecked="True" Margin="0,2,0,4"/>
                        <RadioButton x:Name="option_linked_rb" Content="By Linked View" GroupName="link_display" Margin="0,2,0,4"/>
                        <TextBlock TextWrapping="Wrap" FontStyle="Italic" Margin="0,4,0,8"
                                   Text="Matches the per-link 'Display Settings' dropdown in a view's Visibility/Graphics Overrides &gt; Revit Links tab - applied to every selected link, in every selected View Template, in one go."/>
                        <Button x:Name="apply_b" Content="Apply to Selected" Click="apply_click" Height="28"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox DockPanel.Dock="Bottom" Header="Report" Height="260" Margin="0,8,0,0">
                    <DockPanel Margin="6">
                        <Button DockPanel.Dock="Bottom" x:Name="export_report_b" Content="Export Report..." Click="export_report_click" Height="26" Margin="0,6,0,0"/>
                        <Button DockPanel.Dock="Bottom" x:Name="close_b" Content="Close" Click="close_click" Height="26" Margin="0,6,0,0"/>
                        <DataGrid x:Name="report_grid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" RowHeaderWidth="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Template" Binding="{Binding template_name}" Width="*"/>
                                <DataGridTextColumn Header="Link" Binding="{Binding link_name}" Width="*"/>
                                <DataGridTextColumn Header="Result" Binding="{Binding result}" Width="60"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </GroupBox>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>

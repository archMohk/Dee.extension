<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeeLazy — DeeBulkRename"
        ShowInTaskbar="False"
        MinHeight="560" MinWidth="620" Height="700" Width="660"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="10">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="Every View, Sheet, Schedule, and Legend in the project (view/schedule TEMPLATES and Revit's own internal/titleblock-revision schedules are left out) - tick what you want renamed, set a Prefix and/or Suffix, and see the New Name update live before you run it."/>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="status_tb" Text="Ready."/>
            </StatusBarItem>
        </StatusBar>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,8">
            <TextBlock x:Name="summary_tb" FontSize="11" Foreground="#555" Margin="0,0,0,8" Text=""/>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Prefix:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Grid.Column="1" x:Name="prefix_tb" Height="24" Margin="0,0,16,0" TextChanged="prefix_suffix_changed"/>
                <TextBlock Grid.Column="2" Text="Suffix:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Grid.Column="3" x:Name="suffix_tb" Height="24" TextChanged="prefix_suffix_changed"/>
            </Grid>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="close_b" Content="Close" Width="90" Height="28" Click="close_click"/>
            </StackPanel>
            <Button x:Name="rename_b" Content="RENAME CHECKED ITEMS" Click="rename_click" Margin="0,10,0,0" Height="42"
                    Background="#1F6FB2" Foreground="White" BorderBrush="#1F6FB2"
                    FontSize="16" FontWeight="Bold" Cursor="Hand"/>
        </StackPanel>

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock FontSize="14" Margin="0,3,10,0" DockPanel.Dock="Left" Text="Filter:"/>
            <TextBox x:Name="search_tb" Height="25" TextChanged="search_changed"/>
        </DockPanel>

        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" x:Name="all_b" Content="All" Height="26" Margin="0,0,3,0" Click="all_click"/>
            <Button Grid.Column="1" x:Name="none_b" Content="None" Height="26" Margin="3,0,3,0" Click="none_click"/>
            <Button Grid.Column="2" x:Name="sheets_only_b" Content="Sheets Only" Height="26" Margin="3,0,3,0" Click="sheets_only_click"/>
            <Button Grid.Column="3" x:Name="views_only_b" Content="Views Only" Height="26" Margin="3,0,3,0" Click="views_only_click"/>
            <Button Grid.Column="4" x:Name="schedules_legends_b" Content="Schedules + Legends" Height="26" Margin="3,0,0,0" Click="schedules_legends_click"/>
        </Grid>

        <!-- Header row - same column widths AND same outer margins as the
             ListBox's own DataTemplate below, so labels sit directly above
             their column's values. -->
        <Grid DockPanel.Dock="Top" Margin="4,0,4,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Kind" FontWeight="Bold" FontSize="11" Foreground="#666"
                       Margin="24,0,0,0"/>
            <TextBlock Grid.Column="1" Text="Old Name" FontWeight="Bold" FontSize="11" Foreground="#666"/>
            <TextBlock Grid.Column="2" Text="New Name" FontWeight="Bold" FontSize="11" Foreground="#666"/>
        </Grid>
        <Border DockPanel.Dock="Top" BorderBrush="#BBBBBB" BorderThickness="0,0,0,1" Margin="4,4,4,6"/>

        <ListBox x:Name="rows_lb" HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,2,4,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <CheckBox IsChecked="{Binding checked}"
                                      Checked="row_toggled" Unchecked="row_toggled"/>
                            <TextBlock Text="{Binding kind}" Margin="8,0,0,0" Foreground="#888"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding old_name}" Margin="0,0,4,0" TextWrapping="Wrap"/>
                        <TextBlock Grid.Column="2" Text="{Binding new_name}" Foreground="#1F6FB2" TextWrapping="Wrap"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>

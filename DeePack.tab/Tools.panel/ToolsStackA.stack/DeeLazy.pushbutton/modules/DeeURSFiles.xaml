<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeeLazy - URS Files"
        ShowInTaskbar="False"
        MinHeight="560" MinWidth="760" Height="700" Width="900"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="10">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Button DockPanel.Dock="Right" x:Name="close_b" Content="Close" Click="close_click" Width="90" Height="28" Margin="8,0,0,0" VerticalAlignment="Bottom"/>
            <TextBox x:Name="log_tb" Height="120" IsReadOnly="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"/>
        </DockPanel>

        <TabControl x:Name="main_tabs">
            <!-- ================= Tab 1: Duplicate ================= -->
            <TabItem Header="Duplicate File">
                <StackPanel Margin="12">
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,12"
                               Text="Pick one Revit file from ACC and create any number of copies of it as new worksharing-enabled Cloud Models. The source file is never changed."/>

                    <TextBlock Text="1. Source file" FontWeight="Bold" Margin="0,0,0,4"/>
                    <DockPanel Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" x:Name="dup_pick_b" Content="Pick ACC File..." Click="dup_pick_click" Width="130" Height="26" Margin="8,0,0,0"/>
                        <TextBox x:Name="dup_source_tb" IsReadOnly="True" Height="26" VerticalContentAlignment="Center" Text="(none)"/>
                    </DockPanel>

                    <TextBlock Text="2. Copies" FontWeight="Bold" Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="Number of copies:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="dup_count_tb" Width="60" Height="26" VerticalContentAlignment="Center" Text="1" TextChanged="dup_names_changed"/>
                        <TextBlock Text="Base name:" VerticalAlignment="Center" Margin="18,0,6,0"/>
                        <TextBox x:Name="dup_base_tb" Width="360" Height="26" VerticalContentAlignment="Center" TextChanged="dup_names_changed"/>
                    </StackPanel>
                    <TextBlock x:Name="dup_preview_tb" TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,12"
                               Text="Copies are named &lt;base&gt;_01, &lt;base&gt;_02, ... (one copy keeps the base name)."/>

                    <TextBlock Text="3. Destination" FontWeight="Bold" Margin="0,0,0,4"/>
                    <DockPanel Margin="0,0,0,16">
                        <Button DockPanel.Dock="Right" x:Name="dup_dest_b" Content="Pick Destination..." Click="dup_dest_click" Width="130" Height="26" Margin="8,0,0,0"/>
                        <TextBox x:Name="dup_dest_tb" IsReadOnly="True" Height="26" VerticalContentAlignment="Center" Text="(none)"/>
                    </DockPanel>

                    <Button x:Name="dup_run_b" Content="Create Copies" Click="dup_run_click" Height="32"/>
                </StackPanel>
            </TabItem>

            <!-- ================= Tab 2: Levels & Grids ================= -->
            <TabItem Header="Levels &amp; Grids Only">
                <DockPanel Margin="12">
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="Scan ACC for Revit files, tick the ones you want, and each one is copied into a NEW worksharing Cloud Model that keeps only its Levels and Grids - everything else (elements, sheets, views, links, families...) is removed. The original files are never changed."/>

                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button x:Name="lg_scan_b" Content="Scan ACC Files..." Click="lg_scan_click" Width="130" Height="26"/>
                        <TextBlock Text="Search:" VerticalAlignment="Center" Margin="16,0,6,0"/>
                        <TextBox x:Name="lg_search_tb" Width="220" Height="26" VerticalContentAlignment="Center" TextChanged="lg_search_changed"/>
                        <Button x:Name="lg_all_b" Content="Select All" Click="lg_all_click" Width="80" Height="26" Margin="12,0,0,0"/>
                        <Button x:Name="lg_none_b" Content="Select None" Click="lg_none_click" Width="90" Height="26" Margin="6,0,0,0"/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top" x:Name="lg_source_tb" Opacity="0.75" Margin="0,0,0,6" Text="No files scanned yet."/>

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <CheckBox x:Name="lg_reset_cb" IsChecked="False" Margin="0,0,0,6"
                                  Content="Reset coordinates (move Project Base Point and Survey Point to the internal origin, angle to 0)"/>
                        <CheckBox x:Name="lg_keep_views_cb" IsChecked="True" Margin="0,0,0,6"
                                  Content="Keep floor plans and elevations (otherwise only one floor plan is kept)"/>
                        <CheckBox x:Name="lg_purge_cb" IsChecked="True" Margin="0,0,0,8"
                                  Content="Purge unused families, materials, templates and filters"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="New file name = original name +" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox x:Name="lg_suffix_tb" Width="160" Height="26" VerticalContentAlignment="Center" Text="_Levels-Grids"/>
                        </StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" x:Name="lg_dest_b" Content="Pick Destination..." Click="lg_dest_click" Width="130" Height="26" Margin="8,0,0,0"/>
                            <TextBox x:Name="lg_dest_tb" IsReadOnly="True" Height="26" VerticalContentAlignment="Center" Text="(none)"/>
                        </DockPanel>
                        <Button x:Name="lg_run_b" Content="Create Levels &amp; Grids Files" Click="lg_run_click" Height="32"/>
                    </StackPanel>

                    <DataGrid x:Name="lg_grid" AutoGenerateColumns="False" CanUserAddRows="False" RowHeaderWidth="0">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Select" Width="55"
                                                    Binding="{Binding selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <DataGridTextColumn Header="File" Binding="{Binding name}" Width="*" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>

<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lazy Line Tag — Fit Title Underlines &amp; Tags"
        ShowInTaskbar="False"
        MinHeight="600" MinWidth="1040" Height="680" Width="1120"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="previewRowStyle" TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding status}" Value="Ready">
                    <Setter Property="Background" Value="#C6E0B4"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding status}" Value="No line found">
                    <Setter Property="Background" Value="#FFE699"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding status}" Value="No tag found">
                    <Setter Property="Background" Value="#FFE699"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding status}" Value="No line or tag found">
                    <Setter Property="Background" Value="#F4C7C3"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <DockPanel Margin="10">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="Finds title text on the sheets you pick, pairs each with its nearby underline and tag bubble, and resizes/repositions them to fit the text - nothing else on the sheet is touched. Preview before Run; nothing changes until you click Run."/>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="scan_b" Content="Scan" Width="90" Height="28" Click="scan_click"/>
            <Button x:Name="run_b" Content="Run" Width="90" Height="28" Margin="8,0,0,0" Click="run_click"/>
            <Button x:Name="close_b" Content="Close" Width="90" Height="28" Margin="8,0,0,0" Click="close_click"/>
        </StackPanel>

        <TabControl x:Name="main_tabs">
            <!-- TAB 1: Sheets -->
            <TabItem Header="Sheets">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Pick which sheets to scan for title text/line/tag groups."/>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Search:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="sheet_search_tb" Width="220" Height="24"/>
                        <Button x:Name="sheet_filter_b" Content="Filter" Width="70" Height="24" Margin="6,0,0,0" Click="sheet_filter_click"/>
                        <Button x:Name="sheet_clear_filter_b" Content="Clear" Width="60" Height="24" Margin="4,0,0,0" Click="sheet_clear_filter_click"/>
                        <Button x:Name="select_all_b" Content="Select All" Width="90" Height="24" Margin="20,0,0,0" Click="select_all_click"/>
                        <Button x:Name="select_none_b" Content="Select None" Width="90" Height="24" Margin="6,0,0,0" Click="select_none_click"/>
                        <Button x:Name="select_current_b" Content="Current Sheet Only" Width="130" Height="24" Margin="6,0,0,0" Click="select_current_click"/>
                    </StackPanel>
                    <TextBlock x:Name="sheet_summary_tb" DockPanel.Dock="Bottom" Margin="0,8,0,0" FontStyle="Italic" Text="0 of 0 selected"/>
                    <DataGrid x:Name="sheet_grid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserSortColumns="True"
                              SelectionMode="Extended" RowHeaderWidth="0">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Include" Binding="{Binding selected, Mode=TwoWay}" Width="55"/>
                            <DataGridTextColumn Header="Number" Binding="{Binding number}" IsReadOnly="True" Width="90"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding name}" IsReadOnly="True" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- TAB 2: Settings & Presets -->
            <TabItem Header="Settings &amp; Presets">
                <StackPanel Margin="8">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Preset:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="preset_cb" Width="200" Height="24" IsEditable="True"
                                  ToolTip="Pick a saved preset to Load/Delete, or type a new name and click Save."/>
                        <Button x:Name="preset_save_b" Content="Save" Width="70" Height="24" Margin="6,0,0,0" Click="preset_save_click"/>
                        <Button x:Name="preset_load_b" Content="Load" Width="70" Height="24" Margin="4,0,0,0" Click="preset_load_click"/>
                        <Button x:Name="preset_delete_b" Content="Delete" Width="70" Height="24" Margin="4,0,0,0" Click="preset_delete_click"/>
                    </StackPanel>

                    <GroupBox Header="Line" Padding="6" Margin="0,0,0,10">
                        <StackPanel Margin="6">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="Padding each side (mm):" VerticalAlignment="Center" Width="170"/>
                                <TextBox x:Name="padding_tb" Text="2" Width="60" Height="22"/>
                            </StackPanel>
                            <TextBlock Text="Alignment:" Margin="0,0,0,4"/>
                            <RadioButton x:Name="align_left_rb" GroupName="align" IsChecked="True" Margin="0,0,0,4"
                                         Content="Start at the text's left edge, extend right (matches the screenshot's layout)"/>
                            <RadioButton x:Name="align_center_rb" GroupName="align"
                                         Content="Centered under the text"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Tag placement" Padding="6" Margin="0,0,0,10">
                        <StackPanel Margin="6">
                            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#888888" Margin="0,0,0,6"
                                       Text="The tag (numbered bubble) is moved so its center sits this far left of the text's left edge, and this far above/below the line's own height (0 = aligned with the line)."/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="Offset left of text (mm):" VerticalAlignment="Center" Width="170"/>
                                <TextBox x:Name="tag_offset_x_tb" Text="5" Width="60" Height="22"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Vertical offset from line (mm):" VerticalAlignment="Center" Width="170"/>
                                <TextBox x:Name="tag_offset_y_tb" Text="0" Width="60" Height="22"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Matching tolerance" Padding="6">
                        <StackPanel Margin="6">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="Max gap, text to line (mm):" VerticalAlignment="Center" Width="170"/>
                                <TextBox x:Name="max_gap_tb" Text="5" Width="60" Height="22"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Max search distance for tag (mm):" VerticalAlignment="Center" Width="190"/>
                                <TextBox x:Name="tag_search_tb" Text="50" Width="60" Height="22"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </TabItem>

            <!-- TAB 3: Preview & Run -->
            <TabItem Header="Preview">
                <DockPanel Margin="8">
                    <TextBlock x:Name="preview_summary_tb" DockPanel.Dock="Top" Margin="0,0,0,8" FontWeight="Bold"
                               Text="Click Scan on the Sheets tab (with sheets checked) to see matches here."/>
                    <DataGrid x:Name="preview_grid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserSortColumns="True"
                              SelectionMode="Extended" RowHeaderWidth="0" RowStyle="{StaticResource previewRowStyle}">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Include" Binding="{Binding included, Mode=TwoWay}" Width="55"/>
                            <DataGridTextColumn Header="Sheet" Binding="{Binding sheet_number}" IsReadOnly="True" Width="90"/>
                            <DataGridTextColumn Header="Text" Binding="{Binding text_preview}" IsReadOnly="True" Width="2*"/>
                            <DataGridTextColumn Header="Old Line (mm)" Binding="{Binding old_line_text}" IsReadOnly="True" Width="100"/>
                            <DataGridTextColumn Header="New Line (mm)" Binding="{Binding new_line_text}" IsReadOnly="True" Width="100"/>
                            <DataGridTextColumn Header="Tag Move" Binding="{Binding tag_move_text}" IsReadOnly="True" Width="140"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding status}" IsReadOnly="True" Width="140"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- TAB 4: Results -->
            <TabItem Header="Results">
                <DockPanel Margin="8">
                    <TextBlock x:Name="results_summary_tb" DockPanel.Dock="Top" Margin="0,0,0,8" FontWeight="Bold"
                               Text="Run to see results here."/>
                    <DataGrid x:Name="results_grid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" RowHeaderWidth="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Sheet" Binding="{Binding sheet_number}" Width="90"/>
                            <DataGridTextColumn Header="Text" Binding="{Binding text_preview}" Width="2*"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding status_text}" Width="90"/>
                            <DataGridTextColumn Header="Detail" Binding="{Binding detail}" Width="3*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>

<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeeParaValue — Batch Shared Parameter Value Audit/Edit"
        ShowInTaskbar="False"
        MinHeight="640" MinWidth="1080" Height="720" Width="1180"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="10">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="Scans a batch of Revit files (local and/or ACC cloud) for ONE shared parameter's current value, shows it per file, and lets you type corrected values before writing them all back in one run. A blank New Value always means 'leave this file alone' - only files you actually type into get changed."/>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="load_values_b" Content="Load Values" Click="load_values_click" Width="100" Height="28"/>
            <Button x:Name="save_b" Content="Save" Click="save_click" Width="90" Height="28" Margin="8,0,0,0"/>
            <Button x:Name="export_report_b" Content="Export Report" Click="export_report_click" Width="120" Height="28" Margin="8,0,0,0"/>
            <Button x:Name="close_b" Content="Close" Click="close_click" Width="90" Height="28" Margin="8,0,0,0"/>
        </StackPanel>

        <TabControl DockPanel.Dock="Top">
            <TabItem Header="Target Files">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Source:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,10,0"/>
                        <RadioButton x:Name="source_local_rb" GroupName="source_mode" Content="Local Files" IsChecked="True" Checked="source_mode_changed" VerticalAlignment="Center" Margin="0,0,20,0"/>
                        <RadioButton x:Name="source_acc_rb" GroupName="source_mode" Content="ACC Cloud Models" Checked="source_mode_changed" VerticalAlignment="Center"/>
                    </StackPanel>

                    <DockPanel x:Name="local_section" DockPanel.Dock="Top">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Source Folder:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox x:Name="source_folder_tb" Width="420" Height="24" VerticalContentAlignment="Center" IsReadOnly="True"/>
                            <Button x:Name="browse_b" Content="Browse..." Click="browse_click" Width="90" Height="24" Margin="8,0,0,0"/>
                            <Button x:Name="scan_b" Content="Scan Folder" Click="scan_click" Width="100" Height="24" Margin="8,0,0,0"/>
                            <CheckBox x:Name="recursive_cb" Content="Include subfolders" VerticalAlignment="Center" Margin="14,0,0,0" IsChecked="True"/>
                            <Button x:Name="add_files_b" Content="Add Files..." Click="add_files_click" Width="100" Height="24" Margin="14,0,0,0"/>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                            <Button x:Name="select_all_b" Content="Select All" Click="select_all_click" Width="90" Height="24"/>
                            <Button x:Name="select_none_b" Content="Select None" Click="select_none_click" Width="90" Height="24" Margin="6,0,0,0"/>
                            <TextBlock x:Name="scan_status_tb" Text="No files scanned yet." VerticalAlignment="Center" Margin="14,0,0,0" FontStyle="Italic"/>
                        </StackPanel>
                        <DataGrid x:Name="models_grid" AutoGenerateColumns="False" CanUserAddRows="False"
                                  CanUserSortColumns="True" SelectionMode="Extended" RowHeaderWidth="0">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="Select" Binding="{Binding selected, Mode=TwoWay}" Width="55"/>
                                <DataGridTextColumn Header="File Name" Binding="{Binding file_name}" Width="*" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Version" Binding="{Binding version}" Width="70" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Model Type" Binding="{Binding model_type}" Width="100" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Size" Binding="{Binding size_text}" Width="80" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding status}" Width="160" IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>

                    <DockPanel x:Name="cloud_section" DockPanel.Dock="Top" Visibility="Collapsed">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                            <Button x:Name="add_cloud_b" Content="Add Cloud Models..." Click="add_cloud_click" Width="150" Height="24"/>
                            <Button x:Name="select_all_cloud_b" Content="Select All" Click="select_all_cloud_click" Width="90" Height="24" Margin="14,0,0,0"/>
                            <Button x:Name="select_none_cloud_b" Content="Select None" Click="select_none_cloud_click" Width="90" Height="24" Margin="6,0,0,0"/>
                        </StackPanel>
                        <DataGrid x:Name="cloud_grid" AutoGenerateColumns="False" CanUserAddRows="False"
                                  CanUserSortColumns="True" SelectionMode="Extended" RowHeaderWidth="0">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="Select" Binding="{Binding selected, Mode=TwoWay}" Width="55"/>
                                <DataGridTextColumn Header="Model Name" Binding="{Binding display_name}" Width="*" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Hub" Binding="{Binding hub_name}" Width="140" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Project" Binding="{Binding project_name}" Width="160" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Region" Binding="{Binding region}" Width="70" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding status}" Width="160" IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </DockPanel>
            </TabItem>

            <TabItem Header="Parameter">
                <StackPanel Margin="8">
                    <GroupBox Header="Shared Parameter to Audit/Edit" Margin="0,0,0,10">
                        <StackPanel Margin="6">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Parameter Name:" VerticalAlignment="Center" Width="120"/>
                                <ComboBox x:Name="parameter_cb" Width="300" Height="24" IsEditable="True"/>
                                <Button x:Name="refresh_params_b" Content="Refresh from Current Document" Click="refresh_params_click" Width="190" Height="24" Margin="14,0,0,0"/>
                            </StackPanel>
                            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#888888"
                                       Text="The list is seeded only from shared parameters bound in the CURRENTLY ACTIVE document - a parameter that only exists in your target files can still be used, just type its exact name here."/>
                        </StackPanel>
                    </GroupBox>
                    <TextBlock x:Name="parameter_info_tb" TextWrapping="Wrap" FontStyle="Italic" Text="No parameter checked against the active document yet."/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Values">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button x:Name="select_all_values_b" Content="Select All" Click="select_all_values_click" Width="90" Height="24"/>
                        <Button x:Name="select_none_values_b" Content="Select None" Click="select_none_values_click" Width="90" Height="24" Margin="6,0,0,0"/>
                        <Button x:Name="clear_new_values_b" Content="Clear New Values" Click="clear_new_values_click" Width="120" Height="24" Margin="14,0,0,0"/>
                        <TextBox x:Name="fill_value_tb" Width="160" Height="24" VerticalContentAlignment="Center" Margin="20,0,0,0"/>
                        <Button x:Name="fill_selected_b" Content="Fill New Value for Checked Rows" Click="fill_selected_click" Width="190" Height="24" Margin="6,0,0,0"/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top" x:Name="values_status_tb" Text="Click Load Values after picking files and a parameter." FontStyle="Italic" Margin="0,0,0,8"/>
                    <DataGrid x:Name="values_grid" AutoGenerateColumns="False" CanUserAddRows="False"
                              CanUserSortColumns="True" SelectionMode="Extended" RowHeaderWidth="0">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Select" Binding="{Binding selected, Mode=TwoWay}" Width="55"/>
                            <DataGridTextColumn Header="File" Binding="{Binding file_name}" Width="*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Source" Binding="{Binding source}" Width="60" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding status}" Width="110" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Categories" Binding="{Binding categories_text}" Width="160" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Scope" Binding="{Binding scope_text}" Width="70" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Count" Binding="{Binding element_count}" Width="55" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Storage" Binding="{Binding storage_type_text}" Width="70" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Current Value" Binding="{Binding current_value_display}" Width="160" IsReadOnly="True"/>
                            <DataGridTextColumn Header="New Value" Binding="{Binding new_value, Mode=TwoWay}" Width="160"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Log &amp; Report">
                <Grid Margin="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1.4*"/>
                    </Grid.ColumnDefinitions>
                    <DockPanel Grid.Column="0" Margin="0,0,6,0">
                        <TextBlock DockPanel.Dock="Top" Text="Live Status" FontWeight="Bold" Margin="0,0,0,4"/>
                        <TextBox x:Name="status_tb" IsReadOnly="True" TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Consolas" FontSize="11"/>
                    </DockPanel>
                    <DockPanel Grid.Column="1" Margin="6,0,0,0">
                        <TextBlock DockPanel.Dock="Top" Text="Report" FontWeight="Bold" Margin="0,0,0,4"/>
                        <TextBlock x:Name="summary_tb" DockPanel.Dock="Top" Text="" Margin="0,0,0,6" FontStyle="Italic" TextWrapping="Wrap"/>
                        <DataGrid x:Name="report_grid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" RowHeaderWidth="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="File" Binding="{Binding file_name}" Width="140"/>
                                <DataGridTextColumn Header="Source" Binding="{Binding source}" Width="55"/>
                                <DataGridTextColumn Header="New Value" Binding="{Binding new_value}" Width="100"/>
                                <DataGridTextColumn Header="Updated" Binding="{Binding elements_updated}" Width="60"/>
                                <DataGridTextColumn Header="Skipped" Binding="{Binding elements_skipped}" Width="60"/>
                                <DataGridTextColumn Header="Save Status" Binding="{Binding save_status}" Width="140"/>
                                <DataGridTextColumn Header="Errors" Binding="{Binding errors}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>

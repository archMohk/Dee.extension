<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeeLazy — DeeASelect"
        ShowInTaskbar="False"
        MinHeight="640" MinWidth="600" Height="800" Width="640"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="10">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="Every element in the WHOLE project - model, annotation, links, everything - grouped by category below. All categories start CHECKED (select everything); untick what you don't want before pressing Select. Elements outside the active view are still genuinely selected, just not visibly highlighted until you open a view that shows them."/>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="status_tb" Text="Ready."/>
            </StatusBarItem>
        </StatusBar>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,8">
            <TextBlock x:Name="summary_tb" FontSize="11" Foreground="#555" Margin="0,0,0,8" Text=""/>
            <StackPanel Orientation="Horizontal">
                <CheckBox x:Name="close_after_cb" Content="Close after selecting" IsChecked="True"
                          VerticalAlignment="Center"/>
                <Button x:Name="close_b" Content="Close" Width="90" Height="28" Margin="20,0,0,0"
                        Click="close_click"/>
            </StackPanel>
            <Button x:Name="select_b" Content="SELECT IN REVIT" Click="select_click" Margin="0,10,0,0" Height="42"
                    Background="#1F6FB2" Foreground="White" BorderBrush="#1F6FB2"
                    FontSize="16" FontWeight="Bold" Cursor="Hand"/>
        </StackPanel>

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock FontSize="14" Margin="0,3,10,0" DockPanel.Dock="Left" Text="Filter:"/>
            <TextBox x:Name="search_tb" Height="25" TextChanged="search_changed"/>
        </DockPanel>

        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" x:Name="all_b" Content="All" Height="26" Margin="0,0,3,0" Click="all_click"
                    ToolTip="Ticks every category - model, annotation, and everything else (levels, grids, links, ...)."/>
            <Button Grid.Column="1" x:Name="none_b" Content="None" Height="26" Margin="3,0,3,0" Click="none_click"/>
            <Button Grid.Column="2" x:Name="model_only_b" Content="Model Only" Height="26" Margin="3,0,3,0"
                    Click="model_only_click"
                    ToolTip="Ticks every category whose type is Model, unticks everything else."/>
            <Button Grid.Column="3" x:Name="annotation_only_b" Content="Annotation Only" Height="26" Margin="3,0,3,0"
                    Click="annotation_only_click"
                    ToolTip="Ticks every category whose type is Annotation, unticks everything else."/>
            <Button Grid.Column="4" x:Name="model_and_annotation_b" Content="Model + Annotation" Height="26" Margin="3,0,0,0"
                    Click="model_and_annotation_click"
                    ToolTip="Ticks every Model AND every Annotation category together, unticks everything else (levels, grids, links, and other non-Model/Annotation categories)."/>
        </Grid>

        <GroupBox DockPanel.Dock="Top" Header="Move Selected Categories" Margin="0,0,0,8">
            <StackPanel Margin="5">
                <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#555" Margin="0,0,0,6"
                           Text="Moves every element in the TICKED categories by one offset, in a single Revit operation - moving model geometry and its annotation together this way is what keeps dimensions and tags intact instead of some being deleted."/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="90"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="X:" VerticalAlignment="Center" Margin="0,0,8,0" Width="16"/>
                            <TextBox Grid.Column="1" x:Name="move_x_tb" Height="24" Text="0" TextChanged="move_xy_changed"/>
                            <TextBlock Grid.Column="2" x:Name="move_x_unit_tb" VerticalAlignment="Center" Margin="6,0,0,0" Text="mm"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Y:" VerticalAlignment="Center" Margin="0,0,8,0" Width="16"/>
                            <TextBox Grid.Column="1" x:Name="move_y_tb" Height="24" Text="0" TextChanged="move_xy_changed"/>
                            <TextBlock Grid.Column="2" x:Name="move_y_unit_tb" VerticalAlignment="Center" Margin="6,0,0,0" Text="mm"/>
                        </Grid>
                        <TextBlock x:Name="move_preview_tb" FontSize="11" Foreground="#555" Margin="0,8,0,0"
                                   TextWrapping="Wrap" Text="No movement entered yet."/>
                    </StackPanel>
                    <Border Grid.Column="1" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="4"
                            Width="80" Height="80" Margin="10,0,0,0">
                        <Canvas x:Name="move_preview_cv" Width="80" Height="80"/>
                    </Border>
                </Grid>
                <Button x:Name="move_b" Content="MOVE SELECTED CATEGORIES" Click="move_click" Margin="0,10,0,0" Height="34"
                        Background="#B26A00" Foreground="White" BorderBrush="#B26A00"
                        FontSize="13" FontWeight="Bold" Cursor="Hand"
                        ToolTip="Moves every element in the ticked categories by the X/Y offset above. Asks for confirmation first - this changes the model, unlike Select."/>
            </StackPanel>
        </GroupBox>

        <!-- Header row - same column widths AND same outer margins as the
             ListBox's own DataTemplate below, so labels sit directly above
             their column's values. The Category header is inset by the
             checkbox's own width so it centers over the NAME text, not
             the checkbox next to it. -->
        <Grid DockPanel.Dock="Top" Margin="4,0,4,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="80"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Category" FontWeight="Bold" FontSize="11" Foreground="#666"
                       Margin="24,0,0,0"/>
            <TextBlock Grid.Column="1" Text="Type" FontWeight="Bold" FontSize="11" Foreground="#666"
                       HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="2" Text="Count" FontWeight="Bold" FontSize="11" Foreground="#666"
                       HorizontalAlignment="Center"/>
        </Grid>
        <Border DockPanel.Dock="Top" BorderBrush="#BBBBBB" BorderThickness="0,0,0,1" Margin="4,4,4,6"/>

        <ListBox x:Name="cats_lb" HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,2,4,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <CheckBox IsChecked="{Binding checked}"
                                      Checked="cat_toggled" Unchecked="cat_toggled"/>
                            <TextBlock Text="{Binding name}" Margin="8,0,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding type_label}" Foreground="#888"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding count_label}"
                                   HorizontalAlignment="Center"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>

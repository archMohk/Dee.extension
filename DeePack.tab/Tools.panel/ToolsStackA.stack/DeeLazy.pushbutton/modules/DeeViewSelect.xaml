<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeeViewSelect — Pick Sheets, Pick Their Views, Act on Them"
        ShowInTaskbar="False"
        MinHeight="700" MinWidth="1150" Height="800" Width="1240"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="10">

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem><TextBlock x:Name="status_tb" Text="Ready."/></StatusBarItem>
        </StatusBar>

        <Button DockPanel.Dock="Bottom" x:Name="close_b" Content="Close" Click="close_click"
                Width="100" Height="26" HorizontalAlignment="Right" Margin="0,8,0,4"/>

        <TabControl x:Name="main_tabs">

            <!-- ============ TAB 1: SHEETS ============ -->
            <TabItem Header="1. Sheets">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Tick the sheets you want to work on, then click Load Views From Checked Sheets. Only views actually placed on those sheets are loaded — nothing else in the model is touched."/>

                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="Filter:" VerticalAlignment="Center"/>
                        <TextBox x:Name="sheet_search_tb" Width="260" Height="24" Margin="6,0,0,0"
                                 TextChanged="sheet_search_changed"
                                 ToolTip="Type any number of words — a sheet must match all of them, in its number or its name."/>
                        <CheckBox x:Name="sheets_hide_empty_cb" Content="Hide sheets with no views"
                                  VerticalAlignment="Center" Margin="14,0,0,0" Click="sheet_search_changed"/>
                        <Button x:Name="sheets_all_b" Content="Check All" Width="90" Height="24" Margin="16,0,0,0" Click="sheets_all_click"/>
                        <Button x:Name="sheets_none_b" Content="Check None" Width="90" Height="24" Margin="6,0,0,0" Click="sheets_none_click"/>
                        <Button x:Name="sheets_shown_b" Content="Check Shown" Width="100" Height="24" Margin="6,0,0,0" Click="sheets_shown_click"
                                ToolTip="Ticks every sheet currently passing the filter above."/>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button x:Name="load_views_b" Content="Load Views From Checked Sheets" Width="240" Height="30"
                                FontWeight="Bold" Click="load_views_click"/>
                        <TextBlock x:Name="sheets_summary_tb" VerticalAlignment="Center" Margin="14,0,0,0" FontStyle="Italic" Text=""/>
                    </StackPanel>

                    <DataGrid x:Name="sheets_grid" AutoGenerateColumns="False" CanUserAddRows="False"
                              SelectionMode="Extended" SelectionUnit="FullRow">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Use" Binding="{Binding selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="50"/>
                            <DataGridTextColumn Header="Number" Binding="{Binding number}" IsReadOnly="True" Width="140"/>
                            <DataGridTextColumn Header="Sheet Name" Binding="{Binding name}" IsReadOnly="True" Width="*"/>
                            <DataGridTextColumn Header="Views" Binding="{Binding view_count}" IsReadOnly="True" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ============ TAB 2: VIEWS ============ -->
            <TabItem Header="2. Views">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="One row per placement. A view placed on more than one sheet appears once per sheet, so you can act on a specific placement — view-level actions still only touch each view once, and say so in the report."/>

                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="Filter:" VerticalAlignment="Center"/>
                        <TextBox x:Name="view_search_tb" Width="240" Height="24" Margin="6,0,0,0"
                                 TextChanged="view_search_changed"
                                 ToolTip="Matches on view name, view type, and sheet number/name."/>
                        <TextBlock Text="View type:" VerticalAlignment="Center" Margin="16,0,0,0"/>
                        <ComboBox x:Name="view_type_filter_cb" Width="170" Height="24" Margin="6,0,0,0"
                                  SelectionChanged="view_type_filter_changed"/>
                        <Button x:Name="views_all_b" Content="Check All" Width="90" Height="24" Margin="16,0,0,0" Click="views_all_click"/>
                        <Button x:Name="views_none_b" Content="Check None" Width="90" Height="24" Margin="6,0,0,0" Click="views_none_click"/>
                        <Button x:Name="views_shown_b" Content="Check Shown" Width="100" Height="24" Margin="6,0,0,0" Click="views_shown_click"/>
                    </StackPanel>

                    <TextBlock DockPanel.Dock="Bottom" x:Name="views_summary_tb" Margin="0,8,0,0" FontStyle="Italic" Text=""/>

                    <DataGrid x:Name="views_grid" AutoGenerateColumns="False" CanUserAddRows="False"
                              SelectionMode="Extended" SelectionUnit="FullRow">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Use" Binding="{Binding selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="50"/>
                            <DataGridTextColumn Header="View" Binding="{Binding name}" IsReadOnly="True" Width="2*"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding view_type}" IsReadOnly="True" Width="120"/>
                            <DataGridTextColumn Header="On Sheet" Binding="{Binding sheet_label}" IsReadOnly="True" Width="2*"/>
                            <DataGridTextColumn Header="Scale" Binding="{Binding scale_text}" IsReadOnly="True" Width="70"/>
                            <DataGridTextColumn Header="Detail" Binding="{Binding detail_text}" IsReadOnly="True" Width="80"/>
                            <DataGridTextColumn Header="View Template" Binding="{Binding template_name}" IsReadOnly="True" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ============ TAB 3: ACTIONS ============ -->
            <TabItem Header="3. Actions">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">

                        <Border BorderBrush="#4CAF50" BorderThickness="2" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Just select them" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
                                <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,0,0,8"
                                           Text="Selects the checked views' viewports in Revit and changes nothing else. Revit can only show a selection on the sheet that is currently open, so if your views span several sheets the others are still selected but not visible until you switch to them."/>
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="select_only_b" Content="Select Viewports in Revit" Width="200" Height="30"
                                            FontWeight="Bold" Click="select_only_click"/>
                                    <CheckBox x:Name="close_after_select_cb" Content="Close this window afterwards"
                                              VerticalAlignment="Center" Margin="14,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="action_target_tb" FontWeight="Bold" Margin="0,0,0,8" Text=""/>

                        <GroupBox Header="Display settings" Margin="0,0,0,8">
                            <StackPanel Margin="8">
                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                    <TextBlock Text="View template:" Width="120" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="template_cb" Width="260" Height="24"/>
                                    <Button Content="Apply" Tag="template_apply" Width="80" Height="24" Margin="8,0,0,0" Click="apply_click"/>
                                    <Button Content="Remove Template" Tag="template_remove" Width="130" Height="24" Margin="6,0,0,0" Click="apply_click"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                    <TextBlock Text="Scale:" Width="120" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="scale_cb" Width="260" Height="24"/>
                                    <Button Content="Apply" Tag="scale" Width="80" Height="24" Margin="8,0,0,0" Click="apply_click"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                    <TextBlock Text="Detail level:" Width="120" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="detail_cb" Width="260" Height="24"/>
                                    <Button Content="Apply" Tag="detail" Width="80" Height="24" Margin="8,0,0,0" Click="apply_click"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                    <TextBlock Text="Visual style:" Width="120" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="style_cb" Width="260" Height="24"/>
                                    <Button Content="Apply" Tag="style" Width="80" Height="24" Margin="8,0,0,0" Click="apply_click"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                    <TextBlock Text="Discipline:" Width="120" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="discipline_cb" Width="260" Height="24"/>
                                    <Button Content="Apply" Tag="discipline" Width="80" Height="24" Margin="8,0,0,0" Click="apply_click"/>
                                </StackPanel>
                                <TextBlock TextWrapping="Wrap" FontStyle="Italic" FontSize="11" Margin="0,8,0,0"
                                           Text="A view whose template controls one of these settings cannot have it changed directly. Every action reads the value back after writing it, so a view the template blocked is reported by name with the template that blocked it — never counted as a silent success."/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Crop and extents" Margin="0,0,0,8">
                            <StackPanel Margin="8">
                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                    <TextBlock Text="Crop view:" Width="120" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="crop_active_cb" Width="150" Height="24"/>
                                    <Button Content="Apply" Tag="crop_active" Width="80" Height="24" Margin="8,0,0,0" Click="apply_click"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                    <TextBlock Text="Crop region visible:" Width="120" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="crop_visible_cb" Width="150" Height="24"/>
                                    <Button Content="Apply" Tag="crop_visible" Width="80" Height="24" Margin="8,0,0,0" Click="apply_click"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                    <TextBlock Text="Annotation crop:" Width="120" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="anno_crop_cb" Width="150" Height="24"/>
                                    <Button Content="Apply" Tag="anno_crop" Width="80" Height="24" Margin="8,0,0,0" Click="apply_click"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Naming and parameters" Margin="0,0,0,8">
                            <StackPanel Margin="8">
                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                    <TextBlock Text="Rename views:" Width="120" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="rename_mode_cb" Width="150" Height="24"/>
                                    <TextBox x:Name="rename_find_tb" Width="140" Height="24" Margin="8,0,0,0"
                                             ToolTip="The prefix, the suffix, or the text to find — depending on the mode."/>
                                    <TextBox x:Name="rename_replace_tb" Width="140" Height="24" Margin="6,0,0,0"
                                             ToolTip="Only used by Find and replace."/>
                                    <Button Content="Apply" Tag="rename" Width="80" Height="24" Margin="8,0,0,0" Click="apply_click"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                    <TextBlock Text="Title on sheet:" Width="120" VerticalAlignment="Center"/>
                                    <TextBox x:Name="title_on_sheet_tb" Width="290" Height="24"/>
                                    <Button Content="Apply" Tag="title_on_sheet" Width="80" Height="24" Margin="8,0,0,0" Click="apply_click"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                    <TextBlock Text="Any parameter:" Width="120" VerticalAlignment="Center"/>
                                    <TextBox x:Name="param_name_tb" Width="140" Height="24"
                                             ToolTip="Exact parameter name as shown in Revit's Properties palette."/>
                                    <TextBox x:Name="param_value_tb" Width="140" Height="24" Margin="6,0,0,0"/>
                                    <Button Content="Apply" Tag="param" Width="80" Height="24" Margin="8,0,0,0" Click="apply_click"/>
                                </StackPanel>
                                <TextBlock TextWrapping="Wrap" FontStyle="Italic" FontSize="11" Margin="0,8,0,0"
                                           Text="Renaming uses the view's real name. Revit refuses duplicate view names, so a clash is reported per view and the rest of the batch still runs. Title on sheet writes the view's own Title on Sheet field."/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Viewport and sheet" Margin="0,0,0,8">
                            <StackPanel Margin="8">
                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                    <TextBlock Text="Viewport type:" Width="120" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="viewport_type_cb" Width="260" Height="24"/>
                                    <Button Content="Apply" Tag="viewport_type" Width="80" Height="24" Margin="8,0,0,0" Click="apply_click"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,3">
                                    <Button x:Name="remove_from_sheets_b" Content="Remove Checked Views From Their Sheets"
                                            Width="290" Height="28" Click="remove_from_sheets_click"
                                            Background="#8B2020" Foreground="White"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="11" Width="380" Margin="10,0,0,0"
                                               Text="Deletes the viewport only. The views themselves stay in the project and keep all their settings — but this cannot be undone from inside this window, so it asks first."/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ TAB 4: LOG ============ -->
            <TabItem Header="4. Log">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Every action appends its per-view result here — including anything skipped, blocked by a view template, or rejected by Revit."/>
                    <TextBox x:Name="log_tb" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="12" Background="#141414" Foreground="#DDDDDD"/>
                </DockPanel>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>

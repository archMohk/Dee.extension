<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeeLazy — Fill Pattern Conversion"
        ShowInTaskbar="False"
        MinHeight="500" MinWidth="900" Height="600" Width="1000"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="10">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="Converts Fill Patterns between Model Target (real-world size, scales with the view) and Drafting Target (fixed paper size, scale-independent) by creating a NEW pattern with scaled grid geometry - the original pattern is never changed, edited, or deleted. Set the Reference Scale per row (e.g. 100 for 1:100) before converting - it's the scale a Model pattern's real-world spacing is 'locked in' at when becoming a Drafting pattern, and vice versa."/>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="status_tb" Text="Ready."/>
            </StatusBarItem>
        </StatusBar>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,8">
            <Button x:Name="convert_b" Content="Convert Selected" Width="150" Height="30" FontWeight="Bold" Click="convert_click"/>
            <Button x:Name="close_b" Content="Close" Width="100" Height="30" Margin="10,0,0,0" Click="close_click"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Model Suffix:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="suffix_model_tb" Text=" (Model)" Width="110" Height="24" TextChanged="suffix_changed"/>
            <TextBlock Text="Drafting Suffix:" VerticalAlignment="Center" Margin="16,0,6,0"/>
            <TextBox x:Name="suffix_drafting_tb" Text=" (Drafting)" Width="110" Height="24" TextChanged="suffix_changed"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="select_all_b" Content="Select All" Width="90" Height="24" Click="select_all_click"/>
            <Button x:Name="select_none_b" Content="Select None" Width="90" Height="24" Margin="6,0,0,0" Click="select_none_click"/>
            <Button x:Name="invert_selection_b" Content="Invert Selection" Width="110" Height="24" Margin="6,0,0,0" Click="invert_selection_click"/>
            <Button x:Name="rescan_b" Content="Rescan" Width="90" Height="24" Margin="16,0,0,0" Click="scan_click"/>
        </StackPanel>

        <DataGrid x:Name="patterns_grid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserSortColumns="True"
                  SelectionMode="Extended" SelectionUnit="FullRow">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="Select" Binding="{Binding selected, Mode=TwoWay}" Width="50"/>
                <DataGridTextColumn Header="Name" Binding="{Binding name}" IsReadOnly="True" Width="2*"/>
                <DataGridTextColumn Header="Target" Binding="{Binding target_text}" IsReadOnly="True" Width="80"/>
                <DataGridTextColumn Header="Grid Count" Binding="{Binding grid_count}" IsReadOnly="True" Width="80"/>
                <DataGridTextColumn Header="Solid Fill" Binding="{Binding solid_text}" IsReadOnly="True" Width="80"/>
                <DataGridTextColumn Header="Convert To" Binding="{Binding convert_to_text}" IsReadOnly="True" Width="120"/>
                <DataGridTextColumn Header="Reference Scale (1:X)" Binding="{Binding scale_text, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="130"/>
                <DataGridTextColumn Header="New Name" Binding="{Binding new_name_text}" IsReadOnly="True" Width="2*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>

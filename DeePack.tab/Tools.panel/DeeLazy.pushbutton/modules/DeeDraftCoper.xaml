<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeeDraftCoper — Copy Sheet Annotation to Other Sheets"
        ShowInTaskbar="False"
        MinHeight="660" MinWidth="1050" Height="760" Width="1160"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="10">

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem><TextBlock x:Name="status_tb" Text="Ready."/></StatusBarItem>
        </StatusBar>

        <Grid DockPanel.Dock="Bottom" x:Name="progress_host" Height="24" Margin="0,4,0,4" Visibility="Collapsed">
            <ProgressBar x:Name="progress_bar" Minimum="0" Maximum="100" Height="24"/>
            <TextBlock x:Name="progress_text_tb" HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontWeight="Bold" FontSize="12" Text=""/>
        </Grid>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,6">
            <Button x:Name="run_b" Content="Copy to Checked Sheets" Width="200" Height="30"
                    FontWeight="Bold" Click="run_click"/>
            <TextBlock x:Name="run_summary_tb" VerticalAlignment="Center" Margin="14,0,0,0" FontStyle="Italic" Text=""/>
            <Button x:Name="close_b" Content="Close" Width="90" Height="30" Margin="16,0,0,0" Click="close_click"/>
        </StackPanel>

        <Border DockPanel.Dock="Top" BorderBrush="#F2994D" BorderThickness="2" CornerRadius="4"
                Padding="10" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock x:Name="source_tb" FontWeight="Bold" FontSize="13" Text=""/>
                <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0"
                           Text="These are the elements you had selected in Revit when this window opened. They are copied to each checked sheet at exactly the same position on the sheet, which is what Revit's own Paste Aligned to Selected Views does."/>
            </StackPanel>
        </Border>

        <TabControl x:Name="main_tabs">

            <!-- ============ TAB 1: WHAT TO COPY ============ -->
            <TabItem Header="1. What to Copy">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Untick anything you do not want carried over. Viewports, schedules and title blocks are listed but unticked — a viewport cannot be copied this way at all, and a title block almost certainly already exists on the target sheet."/>

                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                        <Button x:Name="src_all_b" Content="Check All" Width="90" Height="24" Click="src_all_click"/>
                        <Button x:Name="src_none_b" Content="Check None" Width="90" Height="24" Margin="6,0,0,0" Click="src_none_click"/>
                        <Button x:Name="src_copyable_b" Content="Check Only Copyable" Width="150" Height="24" Margin="6,0,0,0" Click="src_copyable_click"
                                ToolTip="Ticks everything except viewports, schedule placements and title blocks."/>
                        <TextBlock x:Name="src_summary_tb" VerticalAlignment="Center" Margin="16,0,0,0" FontStyle="Italic" Text=""/>
                    </StackPanel>

                    <DataGrid x:Name="source_grid" AutoGenerateColumns="False" CanUserAddRows="False"
                              SelectionMode="Extended" SelectionUnit="FullRow">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Copy" Binding="{Binding selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="55"/>
                            <DataGridTextColumn Header="Category" Binding="{Binding category}" IsReadOnly="True" Width="2*"/>
                            <DataGridTextColumn Header="Element" Binding="{Binding description}" IsReadOnly="True" Width="3*"/>
                            <DataGridTextColumn Header="Note" Binding="{Binding note}" IsReadOnly="True" Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ============ TAB 2: TARGET SHEETS ============ -->
            <TabItem Header="2. Target Sheets">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Tick every sheet that should receive a copy. The source sheet is not in this list — it already has the originals."/>

                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="Filter:" VerticalAlignment="Center"/>
                        <TextBox x:Name="sheet_search_tb" Width="260" Height="24" Margin="6,0,0,0"
                                 TextChanged="sheet_search_changed"
                                 ToolTip="Type any number of words — a sheet must match all of them, in its number or its name."/>
                        <Button x:Name="sheets_all_b" Content="Check All" Width="90" Height="24" Margin="16,0,0,0" Click="sheets_all_click"/>
                        <Button x:Name="sheets_none_b" Content="Check None" Width="90" Height="24" Margin="6,0,0,0" Click="sheets_none_click"/>
                        <Button x:Name="sheets_shown_b" Content="Check Shown" Width="100" Height="24" Margin="6,0,0,0" Click="sheets_shown_click"/>
                    </StackPanel>

                    <TextBlock DockPanel.Dock="Bottom" x:Name="sheets_summary_tb" Margin="0,8,0,0" FontStyle="Italic" Text=""/>

                    <DataGrid x:Name="sheets_grid" AutoGenerateColumns="False" CanUserAddRows="False"
                              SelectionMode="Extended" SelectionUnit="FullRow">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Copy To" Binding="{Binding selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="65"/>
                            <DataGridTextColumn Header="Number" Binding="{Binding number}" IsReadOnly="True" Width="150"/>
                            <DataGridTextColumn Header="Sheet Name" Binding="{Binding name}" IsReadOnly="True" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ============ TAB 3: POSITION ============ -->
            <TabItem Header="3. Position">
                <StackPanel Margin="12">
                    <GroupBox Header="Where the copies land" Margin="0,0,0,10">
                        <StackPanel Margin="10">
                            <RadioButton x:Name="pos_same_rb" Content="Same position as on the source sheet" IsChecked="True" Margin="0,4"/>
                            <TextBlock TextWrapping="Wrap" FontSize="11" Margin="20,0,0,8"
                                       Text="Every copy lands on exactly the same spot of each target sheet. This is what you want for a logo, a north arrow, a standard note or a border line that must sit identically on every drawing."/>
                            <RadioButton x:Name="pos_offset_rb" Content="Same position, shifted by:" Margin="0,4"/>
                            <StackPanel Orientation="Horizontal" Margin="20,4,0,0">
                                <TextBlock Text="X (mm):" VerticalAlignment="Center"/>
                                <TextBox x:Name="offset_x_tb" Width="80" Height="24" Margin="6,0,0,0" Text="0"/>
                                <TextBlock Text="Y (mm):" VerticalAlignment="Center" Margin="16,0,0,0"/>
                                <TextBox x:Name="offset_y_tb" Width="80" Height="24" Margin="6,0,0,0" Text="0"/>
                                <TextBlock Text="(positive Y is up the sheet)" VerticalAlignment="Center" Margin="12,0,0,0" FontStyle="Italic" FontSize="11"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <Border BorderBrush="#FFB300" BorderThickness="1" CornerRadius="4" Padding="10">
                        <TextBlock TextWrapping="Wrap" FontSize="12"
                                   Text="DeeDraftCoper cannot tell whether a target sheet already received these elements on an earlier run — Revit keeps no link between an original and its copy. Running it twice onto the same sheet therefore produces two overlapping sets. Check one sheet first if you are unsure."/>
                    </Border>
                </StackPanel>
            </TabItem>

            <!-- ============ TAB 4: LOG ============ -->
            <TabItem Header="4. Log">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Each target sheet is copied inside its own transaction, so if one sheet fails it is rolled back on its own and the rest still run."/>
                    <TextBox x:Name="log_tb" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="12" Background="#141414" Foreground="#DDDDDD"/>
                </DockPanel>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>

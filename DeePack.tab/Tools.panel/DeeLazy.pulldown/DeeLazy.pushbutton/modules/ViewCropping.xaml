<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeeLazy — View Cropping"
        ShowInTaskbar="False"
        MinHeight="640" MinWidth="1180" Height="720" Width="1280"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="10">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="Batch-edit Crop Region settings across many views at once: load views (current sheet, selected sheets, entire project, or the current selection), optionally filter/search, check the ones you want, then run a Crop Action. Each action applies immediately after a count confirmation - there is no separate Apply step."/>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="status_tb" Text="Ready."/>
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="1.6*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- ===================== LEFT PANEL - Selection + Filters ===================== -->
            <DockPanel Grid.Column="0" Margin="0,0,8,0">
                <GroupBox DockPanel.Dock="Top" Header="Load Views" Margin="0,0,0,8">
                    <StackPanel Margin="6">
                        <Button x:Name="load_current_sheet_b" Content="Current Sheet" Click="load_current_sheet_click" Height="26" Margin="0,2,0,2"/>
                        <Button x:Name="load_selected_sheets_b" Content="Selected Sheets..." Click="load_selected_sheets_click" Height="26" Margin="0,2,0,2"/>
                        <Button x:Name="load_entire_project_b" Content="Entire Project" Click="load_entire_project_click" Height="26" Margin="0,2,0,2"/>
                        <Button x:Name="load_current_selection_b" Content="Current Selection" Click="load_current_selection_click" Height="26" Margin="0,2,0,2"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox DockPanel.Dock="Top" Header="Filters" Margin="0,0,0,8">
                    <StackPanel Margin="6">
                        <TextBlock Text="View Type" Margin="0,0,0,2"/>
                        <ComboBox x:Name="filter_type_cb" Height="24" Margin="0,0,0,6"/>

                        <TextBlock Text="Discipline" Margin="0,0,0,2"/>
                        <ComboBox x:Name="filter_discipline_cb" Height="24" Margin="0,0,0,6"/>

                        <TextBlock Text="View Template" Margin="0,0,0,2"/>
                        <ComboBox x:Name="filter_template_cb" Height="24" Margin="0,0,0,6"/>

                        <TextBlock Text="Name / Sheet contains:" Margin="0,0,0,2"/>
                        <TextBox x:Name="filter_name_sheet_tb" Height="24" VerticalContentAlignment="Center" Margin="0,0,0,6"/>

                        <CheckBox x:Name="filter_dependent_only_cb" Content="Dependent views only" Margin="0,2,0,2"/>
                        <CheckBox x:Name="filter_parent_only_cb" Content="Primary (non-dependent) only" Margin="0,2,0,2"/>
                        <CheckBox x:Name="filter_crop_enabled_cb" Content="Crop Region active only" Margin="0,2,0,2"/>
                        <CheckBox x:Name="filter_crop_disabled_cb" Content="Crop Region inactive only" Margin="0,2,0,2"/>
                        <CheckBox x:Name="filter_annotation_crop_cb" Content="Annotation Crop = Yes only" Margin="0,2,0,2"/>

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button x:Name="apply_filters_b" Content="Apply Filters" Click="apply_filters_click" Width="100" Height="26"/>
                            <Button x:Name="clear_filters_b" Content="Clear" Click="clear_filters_click" Width="70" Height="26" Margin="6,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>
            </DockPanel>

            <!-- ===================== MIDDLE PANEL - View list ===================== -->
            <DockPanel Grid.Column="1" Margin="0,0,8,0">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="Search:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="search_tb" Width="220" Height="24" VerticalContentAlignment="Center"
                             TextChanged="search_text_changed"/>
                    <Button x:Name="select_all_b" Content="Select All" Click="select_all_click" Width="90" Height="24" Margin="14,0,0,0"/>
                    <Button x:Name="select_none_b" Content="Select None" Click="select_none_click" Width="90" Height="24" Margin="6,0,0,0"/>
                    <Button x:Name="invert_selection_b" Content="Invert Selection" Click="invert_selection_click" Width="110" Height="24" Margin="6,0,0,0"/>
                </StackPanel>

                <DataGrid x:Name="views_grid" AutoGenerateColumns="False" CanUserAddRows="False"
                          CanUserSortColumns="True" SelectionMode="Extended" RowHeaderWidth="0">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="Select" Binding="{Binding selected, Mode=TwoWay}" Width="55"/>
                        <DataGridTextColumn Header="View Name" Binding="{Binding name}" Width="*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Type" Binding="{Binding view_type}" Width="110" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Sheet" Binding="{Binding sheet_text}" Width="140" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Scale" Binding="{Binding scale}" Width="70" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Crop Active" Binding="{Binding crop_active_text}" Width="80" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Crop Visible" Binding="{Binding crop_visible_text}" Width="85" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Annotation Crop" Binding="{Binding annotation_crop_text}" Width="105" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <!-- ===================== RIGHT PANEL - Crop Actions ===================== -->
            <DockPanel Grid.Column="2">
                <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,0,8">
                    <GroupBox Header="Crop Region Active" Margin="0,0,0,8">
                        <StackPanel Margin="6" Orientation="Horizontal">
                            <Button x:Name="crop_active_enable_b" Content="Enable" Click="crop_active_enable_click" Width="90" Height="26"/>
                            <Button x:Name="crop_active_disable_b" Content="Disable" Click="crop_active_disable_click" Width="90" Height="26" Margin="6,0,0,0"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Crop Region Visibility" Margin="0,0,0,8">
                        <StackPanel Margin="6">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="crop_visible_show_b" Content="Show" Click="crop_visible_show_click" Width="90" Height="26"/>
                                <Button x:Name="crop_visible_hide_b" Content="Hide" Click="crop_visible_hide_click" Width="90" Height="26" Margin="6,0,0,0"/>
                            </StackPanel>
                            <Button x:Name="crop_visible_toggle_b" Content="Toggle" Click="crop_visible_toggle_click" Height="26" Margin="0,6,0,0"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Annotation Crop" Margin="0,0,0,8">
                        <StackPanel Margin="6" Orientation="Horizontal">
                            <Button x:Name="annotation_crop_enable_b" Content="Enable" Click="annotation_crop_enable_click" Width="90" Height="26"/>
                            <Button x:Name="annotation_crop_disable_b" Content="Disable" Click="annotation_crop_disable_click" Width="90" Height="26" Margin="6,0,0,0"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Crop Offset" Margin="0,0,0,8">
                        <StackPanel Margin="6">
                            <CheckBox x:Name="offset_uniform_cb" Content="Uniform (all sides)" Margin="0,0,0,6"/>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Uniform:" VerticalAlignment="Center" Margin="0,2,6,2"/>
                                <TextBox x:Name="offset_uniform_tb" Grid.Row="0" Grid.Column="1" Height="24" VerticalContentAlignment="Center" Text="0" Margin="0,2,4,2"/>
                                <TextBlock x:Name="offset_unit_tb0" Grid.Row="0" Grid.Column="2" Text="" VerticalAlignment="Center" Margin="0,2,0,2"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Top:" VerticalAlignment="Center" Margin="0,2,6,2"/>
                                <TextBox x:Name="offset_top_tb" Grid.Row="1" Grid.Column="1" Height="24" VerticalContentAlignment="Center" Text="0" Margin="0,2,4,2"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Bottom:" VerticalAlignment="Center" Margin="0,2,6,2"/>
                                <TextBox x:Name="offset_bottom_tb" Grid.Row="2" Grid.Column="1" Height="24" VerticalContentAlignment="Center" Text="0" Margin="0,2,4,2"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Left:" VerticalAlignment="Center" Margin="0,2,6,2"/>
                                <TextBox x:Name="offset_left_tb" Grid.Row="3" Grid.Column="1" Height="24" VerticalContentAlignment="Center" Text="0" Margin="0,2,4,2"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Right:" VerticalAlignment="Center" Margin="0,2,6,2"/>
                                <TextBox x:Name="offset_right_tb" Grid.Row="4" Grid.Column="1" Height="24" VerticalContentAlignment="Center" Text="0" Margin="0,2,4,2"/>
                                <TextBlock x:Name="offset_unit_tb" Grid.Row="4" Grid.Column="2" Text="" VerticalAlignment="Center" Margin="0,2,0,2"/>
                            </Grid>
                            <TextBlock Text="Positive values expand the crop outward; negative values shrink it inward." TextWrapping="Wrap" FontStyle="Italic" Margin="0,0,0,6"/>
                            <Button x:Name="apply_offset_b" Content="Apply Crop Offset" Click="apply_offset_click" Height="26"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Scope Box" Margin="0,0,0,8">
                        <StackPanel Margin="6">
                            <Button x:Name="assign_scope_box_b" Content="Assign Scope Box..." Click="assign_scope_box_click" Height="26" Margin="0,0,0,6"/>
                            <Button x:Name="remove_scope_box_b" Content="Remove Scope Box" Click="remove_scope_box_click" Height="26"/>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
                </ScrollViewer>

                <GroupBox DockPanel.Dock="Bottom" Header="Report" Height="220" Margin="0,8,0,0">
                    <DockPanel Margin="6">
                        <Button DockPanel.Dock="Bottom" x:Name="export_report_b" Content="Export Report..." Click="export_report_click" Height="26" Margin="0,6,0,0"/>
                        <Button DockPanel.Dock="Bottom" x:Name="close_b" Content="Close" Click="close_click" Height="26" Margin="0,6,0,0"/>
                        <DataGrid x:Name="report_grid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" RowHeaderWidth="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="View" Binding="{Binding view_name}" Width="*"/>
                                <DataGridTextColumn Header="Action" Binding="{Binding action}" Width="90"/>
                                <DataGridTextColumn Header="Result" Binding="{Binding result}" Width="60"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </GroupBox>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>

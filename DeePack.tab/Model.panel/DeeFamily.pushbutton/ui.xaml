<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeeFamily — Loaded Family Types"
        ShowInTaskbar="True"
        MinHeight="420" MinWidth="560" Height="620" Width="820"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Search:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="search_tb" Width="200" Height="24" TextChanged="search_text_changed"/>
            <Button x:Name="clear_filter_b" Content="Clear" Width="60" Height="24" Margin="6,0,0,0" Click="clear_filter_click"/>
            <TextBlock Text="Discipline:" VerticalAlignment="Center" Margin="16,0,6,0"/>
            <ComboBox x:Name="discipline_cb" Width="180" Height="24" SelectionChanged="discipline_changed"/>
            <Button x:Name="refresh_b" Content="Rescan" Width="80" Height="24" Margin="16,0,0,0" Click="refresh_click"/>
        </StackPanel>

        <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0" FontStyle="Italic" FontSize="10" Foreground="#888888"
                   Text="Drag a tile into the model view, then click to place it. Esc cancels."/>
        <TextBlock x:Name="summary_tb" DockPanel.Dock="Bottom" Margin="0,8,0,4" FontStyle="Italic" Text="Loading..."/>
        <Button DockPanel.Dock="Bottom" x:Name="close_b" Content="Close" Click="close_click"
                Width="100" Height="28" HorizontalAlignment="Right" Margin="0,0,0,4"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="groups_ic">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="{Binding family_name}" FontWeight="Bold" FontSize="13"/>
                                <TextBlock Text="{Binding subtitle}" FontSize="10" Foreground="#888888"
                                           VerticalAlignment="Bottom" Margin="8,0,0,1"/>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding types}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="4"
                                                Margin="4" Padding="6" Width="140" Background="#FAFAFA"
                                                Tag="{Binding}" Cursor="Hand"
                                                MouseLeftButtonDown="tile_mouse_down"
                                                MouseMove="tile_mouse_move"
                                                MouseLeftButtonUp="tile_mouse_up">
                                            <StackPanel>
                                                <Border Width="110" Height="110" Background="#F0F0F0" HorizontalAlignment="Center">
                                                    <Image Source="{Binding thumbnail}" Stretch="Uniform" Width="106" Height="106"/>
                                                </Border>
                                                <TextBlock Text="{Binding type_name}" FontWeight="Bold" TextWrapping="Wrap"
                                                           TextAlignment="Center" FontSize="11" Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>

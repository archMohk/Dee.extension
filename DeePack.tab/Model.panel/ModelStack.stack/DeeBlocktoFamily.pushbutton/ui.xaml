<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeeBlocktoFamily"
        ShowInTaskbar="False"
        MinHeight="560" MinWidth="900" Height="620" Width="960"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="10">
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="status_tb" Text="Ready."/>
            </StatusBarItem>
        </StatusBar>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,8">
            <Button x:Name="place_b" Content="Place Family at All Matches" Width="220" Height="32"
                    FontWeight="Bold" Click="place_click"/>
            <Button x:Name="close_b" Content="Close" Width="90" Height="32" Margin="14,0,0,0" Click="close_click"/>
        </StackPanel>

        <Border DockPanel.Dock="Top" Background="#EEF3F8" Padding="8" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock x:Name="summary_tb" FontWeight="Bold" TextWrapping="Wrap"
                           Text="Matched blocks"/>
                <TextBlock x:Name="cad_file_tb" TextWrapping="Wrap" Margin="0,3,0,0" Text=""/>
            </StackPanel>
        </Border>

        <GroupBox DockPanel.Dock="Top" Header="Revit Family to place" Margin="0,0,0,8">
            <StackPanel Margin="4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Category:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox Grid.Column="1" x:Name="category_cb" Height="24" SelectionChanged="category_cb_changed"/>
                    <TextBlock Grid.Column="3" Text="Family:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox Grid.Column="4" x:Name="family_cb" Height="24" SelectionChanged="family_cb_changed"/>
                    <TextBlock Grid.Column="6" Text="Type:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox Grid.Column="7" x:Name="type_cb" Height="24" SelectionChanged="type_cb_changed"/>
                </Grid>

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="240"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Level:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <StackPanel Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Left">
                        <ComboBox x:Name="level_cb" Height="24" Width="220"/>
                        <CheckBox x:Name="apply_rotation_cb" Margin="0,8,0,0" IsChecked="True"
                                  Content="Match each block's rotation"
                                  ToolTip="Unchecked: every family is placed at its default orientation (0°), ignoring how the CAD block was rotated."/>
                    </StackPanel>
                    <TextBlock Grid.Column="3" x:Name="fallback_label_tb" VerticalAlignment="Center" Margin="0,0,6,0"
                               Text="Fallback height above Level (if no ceiling found):"/>
                    <StackPanel Grid.Column="4" Orientation="Horizontal">
                        <TextBox x:Name="fallback_height_tb" Width="90" Height="24"
                                 VerticalContentAlignment="Center" Text="3000"/>
                        <TextBlock x:Name="fallback_unit_tb" VerticalAlignment="Center" Margin="6,0,0,0" Text="mm"/>
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="placement_warning_tb" TextWrapping="Wrap" Margin="0,8,0,0" Text=""/>
            </StackPanel>
        </GroupBox>

        <DataGrid x:Name="matches_grid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                  SelectionMode="Extended" SelectionUnit="FullRow">
            <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding index}" Width="50"/>
                <DataGridTextColumn Header="X" Binding="{Binding x_text}" Width="110"/>
                <DataGridTextColumn Header="Y" Binding="{Binding y_text}" Width="110"/>
                <DataGridTextColumn Header="Z" Binding="{Binding z_text}" Width="110"/>
                <DataGridTextColumn Header="Rotation (deg)" Binding="{Binding rotation_text}" Width="130"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>

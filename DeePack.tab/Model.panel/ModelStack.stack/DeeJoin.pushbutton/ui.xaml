<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dee.extension — DeeJoin"
        ShowInTaskbar="False"
        Height="700" Width="480" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,12,0,0">
            <Button x:Name="run_b" Content="Run Join" Width="120" Height="30" Click="run_click"/>
            <Button x:Name="close_b" Content="Close" Width="100" Height="28" Margin="10,0,0,0" Click="close_click"/>
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" x:Name="status_tb" TextWrapping="Wrap" FontSize="11"
                    Foreground="#666" Margin="0,8,0,0" Text=""/>

        <!-- ScrollViewer as a safety net, not just a taller Height - the
             hub window in NotificationCenter hit a silent-clip bug this
             exact way once already. -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <TextBlock TextWrapping="Wrap" FontWeight="Bold" Margin="0,0,0,10"
                       Text="Batch Join Geometry - joins overlapping elements using Revit's own Join Geometry, across many elements at once."/>

            <TextBlock Text="Mode:" Margin="0,0,0,4"/>
            <RadioButton x:Name="mode_view_rb" Content="Current View - join everything that overlaps"
                         GroupName="joinMode" Margin="0,0,0,4" Checked="mode_changed"/>
            <RadioButton x:Name="mode_category_rb" Content="By Category - pick categories to join with each other"
                         GroupName="joinMode" Margin="0,0,0,4" Checked="mode_changed"/>
            <RadioButton x:Name="mode_type_rb" Content="By Type - pick specific types to join with each other"
                         GroupName="joinMode" Margin="0,0,0,14" Checked="mode_changed"/>

            <StackPanel x:Name="view_panel" Visibility="Collapsed" Margin="0,0,0,10">
                <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#888"
                           Text="Scans every element visible in the active view and joins every pair that actually overlaps. No further setup needed - just click Run Join below."/>
            </StackPanel>

            <StackPanel x:Name="category_panel" Visibility="Collapsed" Margin="0,0,0,10">
                <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#888" Margin="0,0,0,8"
                           Text="Joins every element in Group A with every intersecting element in Group B - whole model, not just the current view."/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                        <TextBlock Text="Group A" FontWeight="Bold" Margin="0,0,0,4"/>
                        <TextBox x:Name="cat_a_filter_tb" Height="22" Margin="0,0,0,4" TextChanged="cat_a_filter_changed"/>
                        <Border BorderBrush="#3a3f4d" BorderThickness="1" CornerRadius="4" Height="170">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="cat_a_panel" Margin="6"/>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                        <TextBlock Text="Group B" FontWeight="Bold" Margin="0,0,0,4"/>
                        <TextBox x:Name="cat_b_filter_tb" Height="22" Margin="0,0,0,4" TextChanged="cat_b_filter_changed"/>
                        <Border BorderBrush="#3a3f4d" BorderThickness="1" CornerRadius="4" Height="170">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="cat_b_panel" Margin="6"/>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <StackPanel x:Name="type_panel" Visibility="Collapsed" Margin="0,0,0,10">
                <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#888" Margin="0,0,0,8"
                           Text="Joins every instance of the checked types in Group A with every intersecting instance of the checked types in Group B - whole model."/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                        <TextBlock Text="Group A" FontWeight="Bold" Margin="0,0,0,4"/>
                        <TextBox x:Name="type_a_filter_tb" Height="22" Margin="0,0,0,4" TextChanged="type_a_filter_changed"/>
                        <Border BorderBrush="#3a3f4d" BorderThickness="1" CornerRadius="4" Height="170">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="type_a_panel" Margin="6"/>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                        <TextBlock Text="Group B" FontWeight="Bold" Margin="0,0,0,4"/>
                        <TextBox x:Name="type_b_filter_tb" Height="22" Margin="0,0,0,4" TextChanged="type_b_filter_changed"/>
                        <Border BorderBrush="#3a3f4d" BorderThickness="1" CornerRadius="4" Height="170">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="type_b_panel" Margin="6"/>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>

<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dee.extension — Dee3DView"
        ShowInTaskbar="False"
        Height="330" Width="430" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="14">
        <Button DockPanel.Dock="Bottom" x:Name="close_b" Content="Close" Click="close_click"
                Width="100" Height="28" HorizontalAlignment="Right" Margin="0,12,0,0"/>

        <StackPanel>
            <TextBlock Text="3D view helpers" FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#888" Margin="0,0,0,12"
                       Text="Pick a tool. The window closes and the tool opens - same as clicking its own button."/>

            <!-- Hover-highlight cards, same whole-card click/hover pattern
                 as the Notification Center hub (wired in script.py, not
                 here - see _wire_card). -->
            <Border x:Name="mono_card_b" Height="58" Margin="0,0,0,10" CornerRadius="6"
                    BorderThickness="1" Background="Transparent">
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="DeeMono" FontWeight="Bold" FontSize="14"/>
                    <TextBlock Text="Recolour a 3D view into a single-hue presentation theme - 6 presets, live preview, restorable"
                               FontSize="11" Foreground="#888" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <Border x:Name="clear_card_b" Height="58" CornerRadius="6"
                    BorderThickness="1" Background="Transparent">
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="DeeClear3D" FontWeight="Bold" FontSize="14"/>
                    <TextBlock Text="Hide every non-model element (levels, grids, ref planes, analytical) from the 3D views you pick"
                               FontSize="11" Foreground="#888" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </DockPanel>
</Window>

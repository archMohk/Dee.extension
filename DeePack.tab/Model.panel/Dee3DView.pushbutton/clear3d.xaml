<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dee.extension — DeeClear3D"
        ShowInTaskbar="False"
        Height="560" Width="470" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Bottom">
            <TextBlock x:Name="status_tb" TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0" Text=""/>
            <Button x:Name="apply_b" Click="apply_click" Margin="0,10,0,0" Height="38"
                    Background="#1F6FB2" Foreground="White" BorderBrush="#1F6FB2"
                    FontSize="14" FontWeight="Bold" Content="HIDE NON-MODEL ELEMENTS" Cursor="Hand"/>
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" x:Name="restore_b" Content="Show Them Again" Height="26"
                        Margin="0,0,3,0" Click="restore_click"
                        ToolTip="Un-hides the same non-model categories in the checked views - the exact reverse of the blue button."/>
                <Button Grid.Column="1" x:Name="close_b" Content="Close" Height="26"
                        Margin="3,0,0,0" Click="close_click"/>
            </Grid>
        </StackPanel>

        <StackPanel DockPanel.Dock="Top">
            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#888" Margin="0,0,0,8"
                       Text="Tick the 3D views to clean. Hiding switches OFF every annotation and analytical category (levels, grids, reference planes, scope boxes...) in those views - model geometry is never touched. Views whose Visibility/Graphics are controlled by a view template are reported and skipped."/>
            <DockPanel Margin="0,0,0,6">
                <TextBlock DockPanel.Dock="Left" Text="Filter:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="filter_tb" Height="24" TextChanged="filter_changed"/>
            </DockPanel>
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" x:Name="check_all_b" Content="Check All" Height="24"
                        Margin="0,0,3,0" Click="check_all_click"/>
                <Button Grid.Column="1" x:Name="uncheck_all_b" Content="Uncheck All" Height="24"
                        Margin="3,0,0,0" Click="uncheck_all_click"/>
            </Grid>
        </StackPanel>

        <ListView x:Name="views_lb" SelectionMode="Extended">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <CheckBox IsChecked="{Binding state}"/>
                        <TextBlock Text="{Binding name}" Margin="8,0,0,0"/>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </DockPanel>
</Window>

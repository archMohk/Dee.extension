<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeeW.Clean — Batch Clean Local &amp; Cloud Models"
        ShowInTaskbar="False"
        MinHeight="640" MinWidth="1080" Height="720" Width="1160"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="10">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="Batch-cleans local and cloud Revit models: purges unused elements, deletes zero-area rooms and unused groups, flags in-place families for review - then saves or Synchronizes With Central so the cleanup reaches the real shared model."/>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="run_b" Content="Run" Click="run_click" Width="90" Height="28"/>
            <Button x:Name="export_report_b" Content="Export Report" Click="export_report_click" Width="120" Height="28" Margin="8,0,0,0"/>
            <Button x:Name="cancel_b" Content="Cancel" Click="cancel_click" Width="90" Height="28" Margin="8,0,0,0"/>
        </StackPanel>

        <TabControl DockPanel.Dock="Top">
            <TabItem Header="Source Models">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" Text="Local Files" FontWeight="Bold" Margin="0,4,0,4"/>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Source Folder:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="source_folder_tb" Width="420" Height="24" VerticalContentAlignment="Center" IsReadOnly="True"/>
                        <Button x:Name="browse_b" Content="Browse..." Click="browse_click" Width="90" Height="24" Margin="8,0,0,0"/>
                        <Button x:Name="scan_b" Content="Scan Folder" Click="scan_click" Width="100" Height="24" Margin="8,0,0,0"/>
                        <CheckBox x:Name="recursive_cb" Content="Include subfolders" VerticalAlignment="Center" Margin="14,0,0,0" IsChecked="True"/>
                        <Button x:Name="add_files_b" Content="Add Files..." Click="add_files_click" Width="100" Height="24" Margin="14,0,0,0"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button x:Name="select_all_b" Content="Select All" Click="select_all_click" Width="90" Height="24"/>
                        <Button x:Name="select_none_b" Content="Select None" Click="select_none_click" Width="90" Height="24" Margin="6,0,0,0"/>
                        <TextBlock x:Name="scan_status_tb" Text="No files scanned yet." VerticalAlignment="Center" Margin="14,0,0,0" FontStyle="Italic"/>
                    </StackPanel>
                    <DataGrid x:Name="models_grid" Height="220" DockPanel.Dock="Top" AutoGenerateColumns="False" CanUserAddRows="False"
                              CanUserSortColumns="True" SelectionMode="Extended" RowHeaderWidth="0" Margin="0,0,0,10">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Select" Binding="{Binding selected, Mode=TwoWay}" Width="55"/>
                            <DataGridTextColumn Header="File Name" Binding="{Binding file_name}" Width="*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Version" Binding="{Binding version}" Width="70" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Model Type" Binding="{Binding model_type}" Width="100" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Worksharing" Binding="{Binding worksharing_status}" Width="90" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Size" Binding="{Binding size_text}" Width="80" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding status}" Width="160" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Version Check" Binding="{Binding version_warning}" Width="180" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock DockPanel.Dock="Top" Text="Cloud Models" FontWeight="Bold" Margin="0,0,0,4"/>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button x:Name="add_cloud_b" Content="Add Cloud Models..." Click="add_cloud_click" Width="150" Height="24"/>
                        <Button x:Name="select_all_cloud_b" Content="Select All" Click="select_all_cloud_click" Width="90" Height="24" Margin="14,0,0,0"/>
                        <Button x:Name="select_none_cloud_b" Content="Select None" Click="select_none_cloud_click" Width="90" Height="24" Margin="6,0,0,0"/>
                    </StackPanel>
                    <DataGrid x:Name="cloud_grid" AutoGenerateColumns="False" CanUserAddRows="False"
                              CanUserSortColumns="True" SelectionMode="Extended" RowHeaderWidth="0">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Select" Binding="{Binding selected, Mode=TwoWay}" Width="55"/>
                            <DataGridTextColumn Header="Model Name" Binding="{Binding display_name}" Width="*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Hub" Binding="{Binding hub_name}" Width="140" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Project" Binding="{Binding project_name}" Width="160" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Region" Binding="{Binding region}" Width="70" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding status}" Width="160" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Options">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8">
                    <GroupBox Header="What to Clean" Margin="0,0,0,10">
                        <StackPanel Margin="6">
                            <CheckBox x:Name="purge_unused_cb" Content="Purge Unused Elements (needs Revit 2024 or later)" Margin="0,4,0,4" IsChecked="True"/>
                            <CheckBox x:Name="delete_rooms_cb" Content="Delete Zero-Area Rooms (Unplaced / Not Enclosed)" Margin="0,4,0,4" IsChecked="True"/>
                            <CheckBox x:Name="delete_groups_cb" Content="Delete Unused Groups (Model / Detail Group types with no placed instances)" Margin="0,4,0,4" IsChecked="True"/>
                            <CheckBox x:Name="flag_inplace_cb" Content="Flag In-Place Families (report only - never deleted automatically)" Margin="0,4,0,4" IsChecked="True"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Save / Synchronize" Margin="0,0,0,10">
                        <StackPanel Margin="6">
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6"
                                       Text="Workshared local files and cloud models are opened WITHOUT detaching, cleaned, then pushed back to the real central via Synchronize With Central - not a disconnected copy. Standalone files are simply saved in place."/>
                            <TextBlock Text="Synchronize Comment:" Margin="0,0,0,4"/>
                            <TextBox x:Name="sync_comment_tb" Height="24" VerticalContentAlignment="Center" Text="DeeW.Clean - automated batch cleanup"/>
                            <CheckBox x:Name="compact_on_sync_cb" Content="Compact Central File on Synchronize" Margin="0,8,0,4"/>
                            <CheckBox x:Name="audit_cb" Content="Audit on Open (local files)" Margin="0,4,0,4"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Options" Margin="0,0,0,10">
                        <StackPanel Margin="6">
                            <CheckBox x:Name="auto_resolve_dialogs_cb" Content="Automatically Resolve Dialogs" Margin="0,4,0,4" IsChecked="True"/>
                            <CheckBox x:Name="generate_report_cb" Content="Generate Report" Margin="0,4,0,4" IsChecked="True"/>
                            <CheckBox x:Name="close_after_cb" Content="Close File After Processing" Margin="0,4,0,4" IsChecked="True"/>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Log &amp; Report">
                <Grid Margin="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1.4*"/>
                    </Grid.ColumnDefinitions>
                    <DockPanel Grid.Column="0" Margin="0,0,6,0">
                        <TextBlock DockPanel.Dock="Top" Text="Live Status" FontWeight="Bold" Margin="0,0,0,4"/>
                        <TextBox x:Name="status_tb" IsReadOnly="True" TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Consolas" FontSize="11"/>
                    </DockPanel>
                    <DockPanel Grid.Column="1" Margin="6,0,0,0">
                        <TextBlock DockPanel.Dock="Top" Text="Report" FontWeight="Bold" Margin="0,0,0,4"/>
                        <TextBlock x:Name="summary_tb" DockPanel.Dock="Top" Text="" Margin="0,0,0,6" FontStyle="Italic" TextWrapping="Wrap"/>
                        <DataGrid x:Name="report_grid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" RowHeaderWidth="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="File" Binding="{Binding file_name}" Width="140"/>
                                <DataGridTextColumn Header="Source" Binding="{Binding source}" Width="60"/>
                                <DataGridTextColumn Header="Purged" Binding="{Binding purged_count}" Width="60"/>
                                <DataGridTextColumn Header="Rooms Deleted" Binding="{Binding zero_area_rooms_deleted}" Width="90"/>
                                <DataGridTextColumn Header="Groups Deleted" Binding="{Binding unused_groups_deleted}" Width="95"/>
                                <DataGridTextColumn Header="In-Place Found" Binding="{Binding inplace_families_found}" Width="95"/>
                                <DataGridTextColumn Header="Save/Sync Status" Binding="{Binding save_status}" Width="150"/>
                                <DataGridTextColumn Header="Warnings" Binding="{Binding warnings}" Width="130"/>
                                <DataGridTextColumn Header="Errors" Binding="{Binding errors}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>

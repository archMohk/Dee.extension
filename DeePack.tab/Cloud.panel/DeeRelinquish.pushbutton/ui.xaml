<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeeRelinquish — Who Owns What in ACC, and Release Yours"
        ShowInTaskbar="False"
        MinHeight="700" MinWidth="1100" Height="800" Width="1220"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="10">

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem><TextBlock x:Name="status_tb" Text="Ready."/></StatusBarItem>
        </StatusBar>

        <Grid DockPanel.Dock="Bottom" x:Name="progress_host" Height="26" Margin="0,4,0,4" Visibility="Collapsed">
            <ProgressBar x:Name="progress_bar" Minimum="0" Maximum="100" Height="26"/>
            <TextBlock x:Name="progress_text_tb" HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontWeight="Bold" FontSize="12" Text=""/>
        </Grid>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,6">
            <Button x:Name="run_b" Content="Relinquish My Ownership" Width="200" Height="30"
                    FontWeight="Bold" Click="run_click"/>
            <TextBlock x:Name="run_summary_tb" VerticalAlignment="Center" Margin="14,0,0,0"
                       FontStyle="Italic" Text=""/>
            <Button x:Name="close_b" Content="Close" Width="90" Height="30" Margin="16,0,0,0" Click="close_click"/>
        </StackPanel>

        <GroupBox DockPanel.Dock="Top" Header="1. ACC Project" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" Margin="6">
                <Button x:Name="pick_project_b" Content="Pick Hub / Project..." Width="160" Height="26" Click="pick_project_click"/>
                <TextBlock x:Name="project_tb" VerticalAlignment="Center" Margin="12,0,0,0"
                           Text="No project selected." FontStyle="Italic"/>
                <Button x:Name="scan_b" Content="Scan Ownership" Width="140" Height="26" Margin="16,0,0,0"
                        Click="scan_click" FontWeight="Bold"
                        ToolTip="Reads workset ownership straight off each model without opening it. Fast, and it changes nothing."/>
                <TextBlock x:Name="user_tb" VerticalAlignment="Center" Margin="16,0,0,0" Text=""/>
            </StackPanel>
        </GroupBox>

        <TabControl x:Name="main_tabs">

            <!-- ============ TAB 1: MODELS ============ -->
            <TabItem Header="Models">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Scan Ownership reads every model's worksets without opening anything. Then tick the models you want released — only what YOU own is touched. Anything held by a colleague is reported and left alone; the Revit API cannot release another person's ownership."/>

                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="Filter:" VerticalAlignment="Center"/>
                        <TextBox x:Name="model_search_tb" Width="240" Height="24" Margin="6,0,0,0" TextChanged="model_search_changed"/>
                        <Button x:Name="models_all_b" Content="Check All" Width="90" Height="24" Margin="16,0,0,0" Click="models_all_click"/>
                        <Button x:Name="models_none_b" Content="Check None" Width="90" Height="24" Margin="6,0,0,0" Click="models_none_click"/>
                        <Button x:Name="models_mine_b" Content="Check Only Ones I Hold" Width="170" Height="24" Margin="6,0,0,0" Click="models_mine_click"
                                ToolTip="Ticks every model where you personally own at least one workset — the ones this tool can actually act on."/>
                    </StackPanel>

                    <TextBlock DockPanel.Dock="Bottom" x:Name="models_summary_tb" Margin="0,8,0,0" FontStyle="Italic" Text=""/>

                    <DataGrid x:Name="models_grid" AutoGenerateColumns="False" CanUserAddRows="False"
                              SelectionMode="Extended" SelectionUnit="FullRow">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Use" Width="45">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Click="model_toggle_click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Model" Binding="{Binding name}" IsReadOnly="True" Width="2*"/>
                            <DataGridTextColumn Header="Ownership" Binding="{Binding status}" IsReadOnly="True" Width="2*"/>
                            <DataGridTextColumn Header="Held by others" Binding="{Binding owners_display}" IsReadOnly="True" Width="*"/>
                            <DataGridTextColumn Header="Result" Binding="{Binding result}" IsReadOnly="True" Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ============ TAB 2: WHO OWNS WHAT ============ -->
            <TabItem Header="Who Owns What">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Every workset found, across every scanned model. This is workset-level ownership — individual borrowed elements are not listed, because reading those would mean opening each model."/>

                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="Filter:" VerticalAlignment="Center"/>
                        <TextBox x:Name="own_search_tb" Width="240" Height="24" Margin="6,0,0,0" TextChanged="own_filter_changed"/>
                        <ComboBox x:Name="own_filter_cb" Width="180" Height="24" Margin="16,0,0,0" SelectionChanged="own_filter_changed"/>
                        <TextBlock x:Name="own_summary_tb" VerticalAlignment="Center" Margin="16,0,0,0" FontStyle="Italic" Text=""/>
                    </StackPanel>

                    <DataGrid x:Name="ownership_grid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              SelectionMode="Extended" SelectionUnit="FullRow">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Model" Binding="{Binding model_name}" Width="2*"/>
                            <DataGridTextColumn Header="Workset" Binding="{Binding workset_name}" Width="2*"/>
                            <DataGridTextColumn Header="Owner" Binding="{Binding owner_display}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ============ TAB 3: WHAT TO RELEASE ============ -->
            <TabItem Header="What to Release">
                <StackPanel Margin="12">
                    <GroupBox Header="Categories to relinquish" Margin="0,0,0,10">
                        <StackPanel Margin="10">
                            <CheckBox x:Name="cat_CheckedOutElements_cb" Content="Checked-out elements" IsChecked="True" Margin="0,4"
                                      ToolTip="Individual elements you borrowed while editing."/>
                            <CheckBox x:Name="cat_UserWorksets_cb" Content="User worksets" IsChecked="True" Margin="0,4"
                                      ToolTip="The normal worksets people create for model content."/>
                            <CheckBox x:Name="cat_ViewWorksets_cb" Content="View worksets" IsChecked="True" Margin="0,4"
                                      ToolTip="One per view - held when you edit a view's properties."/>
                            <CheckBox x:Name="cat_FamilyWorksets_cb" Content="Family worksets" IsChecked="True" Margin="0,4"
                                      ToolTip="Held when you load or edit a family in the project."/>
                            <CheckBox x:Name="cat_StandardWorksets_cb" Content="Project standards worksets" IsChecked="True" Margin="0,4"
                                      ToolTip="Materials, line styles, browser organisation and similar."/>
                            <TextBlock TextWrapping="Wrap" FontStyle="Italic" FontSize="11" Margin="0,10,0,0"
                                       Text="All five are ticked by default, which matches what Revit's own Relinquish All Mine does. Untick any you want to keep hold of."/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Models with unsynchronized changes" Margin="0,0,0,10">
                        <StackPanel Margin="10">
                            <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,0,0,8"
                                       Text="Revit will only relinquish elements that are already in central. If a model still holds changes you never synchronized, those elements stay owned by you no matter what is ticked above."/>
                            <CheckBox x:Name="sync_first_cb" Content="Synchronize first, so the release is complete" Margin="0,2"/>
                            <Border BorderBrush="#FFB300" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,8,0,0">
                                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#FFB300"
                                           Text="Leave this OFF unless you mean it. Ticking it PUBLISHES whatever local changes those models hold to everyone on the project — it is not a tidy-up, it is a decision to share work. Left off, DeeRelinquish releases what it can and tells you exactly which models it could not finish and why."/>
                            </Border>
                            <TextBlock TextWrapping="Wrap" FontStyle="Italic" FontSize="11" Margin="0,8,0,0"
                                       Text="The synchronize used here deliberately relinquishes nothing on its own, so your category choices above still decide exactly what gets released."/>
                        </StackPanel>
                    </GroupBox>

                    <Border BorderBrush="#555" BorderThickness="1" CornerRadius="4" Padding="10">
                        <TextBlock TextWrapping="Wrap" FontSize="12"
                                   Text="Worksets held by other people cannot be released from here — the Revit API ignores them by design. They are listed on the Who Owns What tab so you know who to ask. To force one, the owner must relinquish, or someone with the right permission uses Collaborate > Manage Model > Manage Cloud Models."/>
                    </Border>
                </StackPanel>
            </TabItem>

            <!-- ============ TAB 4: LOG ============ -->
            <TabItem Header="Log">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Each model is opened, released and closed on its own, so one failure never stops the rest."/>
                    <TextBox x:Name="log_tb" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="12" Background="#141414" Foreground="#DDDDDD"/>
                </DockPanel>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>

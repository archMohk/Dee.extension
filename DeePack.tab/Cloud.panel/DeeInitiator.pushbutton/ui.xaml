<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeeInitiator — Batch-Create &amp; Publish to ACC"
        ShowInTaskbar="False"
        MinHeight="700" MinWidth="1200" Height="880" Width="1360"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="10">
        <Border DockPanel.Dock="Right" Width="360" Margin="8,0,0,0"
                BorderBrush="#666" BorderThickness="1,0,0,0" Padding="8,0,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="LINK MATCHES  (Source → Target)"
                           FontWeight="Bold" Foreground="#F2994D" Margin="0,0,0,6"/>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                    <Button x:Name="link_remove_match_b" Content="Remove" Width="70" Height="24"
                            Click="link_remove_match_click"
                            ToolTip="Removes the selected row(s) from MATCHES below."/>
                </StackPanel>
                <Button DockPanel.Dock="Bottom" x:Name="link_clear_matches_b" Content="Clear All"
                        Height="24" Margin="0,6,0,0" Click="link_clear_matches_click"/>
                <Border DockPanel.Dock="Bottom" BorderBrush="#666" BorderThickness="1"
                        Margin="0,8,0,0" Padding="6">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="ANALYSIS" FontWeight="Bold"
                                   Foreground="#F2994D" Margin="0,0,0,4"/>
                        <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto">
                            <TextBlock x:Name="link_analysis_tb" FontFamily="Consolas" FontSize="10"
                                       Text="No matches yet. Wire two files together on Link Management."/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
                <DataGrid x:Name="link_matches_grid" AutoGenerateColumns="False" CanUserAddRows="False"
                          CanUserSortColumns="True" SelectionMode="Extended" RowHeaderWidth="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Source (linked)" Binding="{Binding source}" IsReadOnly="True" Width="*"/>
                        <DataGridTextColumn Header="Target (host)" Binding="{Binding target}" IsReadOnly="True" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="Click '+ Add Delivery Party' for each template you want to batch from - a Delivery Party pairs a name (e.g. Architecture), one Template/RVT file, a bulk list of new file names, and its own ACC destination. As soon as you type names and pick a destination, those planned files already show up on Link Management - build your link matches there whenever you like, even before Run. Validate every party (file + ACC), pick an Output Root Folder, then click Run ONCE: it creates, uploads, AND creates the Revit Links you've already wired up, all in one go. 'Run Links' is only needed afterward if you add more matches or want to retry linking on its own."/>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Output Root Folder:" VerticalAlignment="Center"/>
            <TextBox x:Name="root_folder_tb" Width="360" Height="24" Margin="8,0,0,0" IsReadOnly="True" VerticalContentAlignment="Center"/>
            <Button x:Name="browse_root_b" Content="Browse..." Click="browse_root_click" Width="90" Height="24" Margin="8,0,0,0"/>
            <CheckBox x:Name="delete_after_upload_cb" Content="Delete local copy after successful upload" VerticalAlignment="Center" Margin="24,0,0,0"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="add_party_b" Content="+ Add Delivery Party" Click="add_party_click" Width="150" Height="28" FontWeight="Bold"/>
            <Button x:Name="validate_all_b" Content="Validate All Parties" Click="validate_all_click" Width="140" Height="28" Margin="8,0,0,0"/>
            <Button x:Name="run_b" Content="Run" Click="run_click" Width="90" Height="28" Margin="8,0,0,0" FontWeight="Bold" IsEnabled="False"
                    ToolTip="Creates, uploads, AND creates any link matches already set up on Link Management - one click does all of it."/>
            <Button x:Name="export_report_b" Content="Export Report" Click="export_report_click" Width="120" Height="28" Margin="8,0,0,0"/>
            <Button x:Name="save_set_b" Content="Save Set..." Click="save_set_click" Width="100" Height="28" Margin="16,0,0,0"
                    ToolTip="Saves every Delivery Party (name, template, file names, ACC destination), the Output Root Folder, link options, and the current link matches to one file you can re-open later."/>
            <Button x:Name="load_set_b" Content="Load Set..." Click="load_set_click" Width="100" Height="28" Margin="6,0,0,0"
                    ToolTip="Loads a previously saved set - replaces every Delivery Party and link match currently defined here. ACC sign-in isn't saved, so Validate All Parties again after loading."/>
            <Button x:Name="cancel_b" Content="Close" Click="cancel_click" Width="90" Height="28" Margin="16,0,0,0"/>
        </StackPanel>

        <TextBlock x:Name="summary_tb" DockPanel.Dock="Top" Text="" FontStyle="Italic" Margin="0,0,0,8" TextWrapping="Wrap"/>

        <GroupBox DockPanel.Dock="Top" Header="Link Setup (Link Management tab)" Margin="0,0,0,8">
            <StackPanel Margin="6">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button x:Name="refresh_link_files_b" Content="Refresh File List" Click="refresh_link_files_click" Width="140" Height="26"/>
                    <TextBlock x:Name="link_files_count_tb" VerticalAlignment="Center" Margin="12,0,0,0" FontStyle="Italic"
                               Text="No files planned yet - type bulk names and pick an ACC destination on a Delivery Party."/>
                </StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Link Type:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox Grid.Column="1" x:Name="link_placement_cb" Height="24"/>
                    <TextBlock Grid.Column="3" Text="Sync comment:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Grid.Column="4" x:Name="link_sync_comment_tb" Height="24" VerticalContentAlignment="Center" Text="Synchronize"/>
                    <CheckBox Grid.Column="5" x:Name="link_skip_existing_cb" Content="Skip if already linked" IsChecked="True" VerticalAlignment="Center" Margin="20,0,0,0"/>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Link as:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <RadioButton x:Name="link_attachment_overlay_rb" GroupName="link_attachment" IsChecked="True" Content="Overlay" VerticalAlignment="Center"/>
                    <RadioButton x:Name="link_attachment_attachment_rb" GroupName="link_attachment" Margin="20,0,0,0" Content="Attachment" VerticalAlignment="Center"/>
                    <CheckBox x:Name="link_skip_completed_cb" Content="Skip hosts already synchronized in a previous Run Links" IsChecked="True" VerticalAlignment="Center" Margin="30,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="run_links_b" Content="Run Links" Click="run_links_click" Width="110" Height="28" FontWeight="Bold"
                            ToolTip="Manual/retry only - the main Run button above already does this automatically right after upload."/>
                    <Button x:Name="clear_link_progress_b" Content="Clear History" Click="clear_link_progress_click" Width="110" Height="24" Margin="8,0,0,0"/>
                    <TextBlock x:Name="link_run_status_tb" VerticalAlignment="Center" Margin="16,0,0,0" FontStyle="Italic"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <TabControl x:Name="main_tabs">
            <TabItem Header="Delivery Parties">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="4">
                    <StackPanel x:Name="zones_panel" Orientation="Vertical"/>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Link Management">
                <DockPanel Margin="6">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                        <Button x:Name="link_map_refresh_b" Content="Redraw" Width="70" Height="22" Click="link_map_refresh_click"/>
                        <Button x:Name="link_map_clear_wires_b" Content="Clear Wires" Width="90" Height="22"
                                Margin="6,0,0,0" Click="link_map_clear_wires_click"/>
                        <TextBlock x:Name="link_map_count_tb" VerticalAlignment="Center" Margin="14,0,0,0"
                                   Foreground="#888" Text=""/>
                    </StackPanel>

                    <Border DockPanel.Dock="Bottom" Background="#2B2B2B" BorderBrush="#555"
                            BorderThickness="1" Padding="6,4" Margin="0,6,0,0">
                        <TextBlock x:Name="link_map_hint_tb" FontSize="11" Foreground="#CCC"
                                   Text="Click a file on the left, then a file on the right, to link the first into the second."/>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" MinWidth="220"/>
                            <ColumnDefinition Width="170" MinWidth="80"/>
                            <ColumnDefinition Width="1*" MinWidth="220"/>
                        </Grid.ColumnDefinitions>

                        <DockPanel Grid.Column="0">
                            <TextBlock DockPanel.Dock="Top" Foreground="#F2994D" FontWeight="Bold"
                                       Margin="0,0,0,3" Text="SOURCES — click one to start"/>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,3">
                                <TextBox x:Name="link_map_left_search_tb" Width="140" Height="22"
                                         VerticalContentAlignment="Center" TextChanged="link_map_left_search_changed"/>
                                <Button x:Name="link_map_left_clear_b" Content="Clear" Width="46" Height="22"
                                        Margin="4,0,0,0" Click="link_map_left_clear_click"/>
                                <TextBlock x:Name="link_map_left_count_tb" VerticalAlignment="Center"
                                           Margin="8,0,0,0" Foreground="#888" Text=""/>
                            </StackPanel>
                            <Border BorderBrush="#555" BorderThickness="1">
                                <ScrollViewer x:Name="link_map_left_scroll" VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel x:Name="link_map_left_panel" Background="#1E1E1E"/>
                                </ScrollViewer>
                            </Border>
                        </DockPanel>

                        <Canvas Grid.Column="1" x:Name="link_map_canvas" Background="#161616"
                                ClipToBounds="True"/>

                        <DockPanel Grid.Column="2">
                            <TextBlock DockPanel.Dock="Top" Foreground="#F2994D" FontWeight="Bold"
                                       Margin="0,0,0,3" Text="TARGETS — click one to finish"/>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,3">
                                <TextBox x:Name="link_map_right_search_tb" Width="140" Height="22"
                                         VerticalContentAlignment="Center" TextChanged="link_map_right_search_changed"/>
                                <Button x:Name="link_map_right_clear_b" Content="Clear" Width="46" Height="22"
                                        Margin="4,0,0,0" Click="link_map_right_clear_click"/>
                                <TextBlock x:Name="link_map_right_count_tb" VerticalAlignment="Center"
                                           Margin="8,0,0,0" Foreground="#888" Text=""/>
                            </StackPanel>
                            <Border BorderBrush="#555" BorderThickness="1">
                                <ScrollViewer x:Name="link_map_right_scroll" VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel x:Name="link_map_right_panel" Background="#1E1E1E"/>
                                </ScrollViewer>
                            </Border>
                        </DockPanel>
                    </Grid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Log &amp; Report">
                <Grid Margin="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1.6*"/>
                    </Grid.ColumnDefinitions>
                    <DockPanel Grid.Column="0" Margin="0,0,6,0">
                        <TextBlock DockPanel.Dock="Top" Text="Live Status" FontWeight="Bold" Margin="0,0,0,4"/>
                        <TextBox x:Name="status_tb" IsReadOnly="True" TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Consolas" FontSize="11"/>
                    </DockPanel>
                    <DockPanel Grid.Column="1" Margin="6,0,0,0">
                        <TextBlock DockPanel.Dock="Top" Text="Report" FontWeight="Bold" Margin="0,0,0,4"/>
                        <DataGrid x:Name="report_grid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" RowHeaderWidth="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Delivery Party" Binding="{Binding party_id}" Width="90"/>
                                <DataGridTextColumn Header="New File Name" Binding="{Binding new_file_name}" Width="140"/>
                                <DataGridTextColumn Header="Output Folder" Binding="{Binding output_folder}" Width="180"/>
                                <DataGridTextColumn Header="ACC Destination" Binding="{Binding acc_destination_text}" Width="200"/>
                                <DataGridTextColumn Header="Upload Status" Binding="{Binding upload_status}" Width="140"/>
                                <DataGridTextColumn Header="Worksharing" Binding="{Binding worksharing_enabled}" Width="90"/>
                                <DataGridTextColumn Header="Local Copy" Binding="{Binding local_copy}" Width="90"/>
                                <DataGridTextColumn Header="Errors" Binding="{Binding errors}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>

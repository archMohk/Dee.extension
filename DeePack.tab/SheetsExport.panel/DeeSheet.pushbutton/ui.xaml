<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="DeeSheet — Create &amp; Manage Sheets" Height="780" Width="1320"
    MinHeight="650" MinWidth="1050"
    WindowStartupLocation="CenterScreen"
    ResizeMode="CanResize"
    ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="superRowStyle" TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding status_key}" Value="new">
                    <Setter Property="Background" Value="#C6E0B4"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding status_key}" Value="modified">
                    <Setter Property="Background" Value="#FFE699"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding status_key}" Value="delete">
                    <Setter Property="Background" Value="#F4C7C3"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding status_key}" Value="discarded">
                    <Setter Property="Background" Value="#E0E0E0"/>
                    <Setter Property="Foreground" Value="#808080"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="renameRowStyle" TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding status}" Value="Ready">
                    <Setter Property="Background" Value="#C6E0B4"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding status}" Value="Unchanged">
                    <Setter Property="Background" Value="#E0E0E0"/>
                    <Setter Property="Foreground" Value="#808080"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding status}" Value="Empty">
                    <Setter Property="Background" Value="#FFE699"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding status}" Value="Duplicate">
                    <Setter Property="Background" Value="#F4C7C3"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding status}" Value="Invalid">
                    <Setter Property="Background" Value="#F1948A"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <DockPanel Margin="10">
        <Button DockPanel.Dock="Bottom" x:Name="close_b" Content="Close" Click="close_click"
                Width="100" Height="28" HorizontalAlignment="Right" Margin="0,10,0,0"/>

        <TabControl x:Name="main_tabs">
            <!-- TAB 1: Normal Creation -->
            <TabItem Header="Normal Creation">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,10" FontSize="13"
                               Text="Copy the Sheet Number column from Excel and paste it into the left box. Copy the Sheet Name column and paste it into the right box. Line 1 in both boxes = one sheet, line 2 = the next one, and so on. Numbers that already exist in the project are skipped."/>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Title Block:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="titleblock_cb" Width="320" Height="24"/>
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <DockPanel Grid.Column="0">
                            <TextBlock DockPanel.Dock="Top" Text="Sheet Number" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBox x:Name="numbers_box" AcceptsReturn="True" AcceptsTab="False"
                                     TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="13"/>
                        </DockPanel>

                        <DockPanel Grid.Column="2">
                            <TextBlock DockPanel.Dock="Top" Text="Sheet Name" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBox x:Name="names_box" AcceptsReturn="True" AcceptsTab="False"
                                     TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="13"/>
                        </DockPanel>
                    </Grid>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button x:Name="export_results_b" Content="Export Last Results to Excel" Click="export_results_click"
                                Width="190" Height="32" Margin="0,0,10,0"/>
                        <Button x:Name="create_btn" Content="Create Sheets" Width="130" Height="32" Click="create_click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- TAB 2: Super Sheet -->
            <TabItem Header="Super Sheet">
                <DockPanel Margin="10">
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Every Sheet in the project, in one editable grid (starts sorted by Number). Edit Number/Name directly in a cell. Add Row appends a new, not-yet-created sheet - click it, then Move Up/Move Down to place it wherever you want in this list (this reorders the view only, not Revit's own sheet numbering/browser order). The Delete checkbox marks an existing sheet for deletion, or just drops a not-yet-created row. Apply Changes creates/renames/deletes everything at once. Nothing changes until Apply Changes or Apply to All Sheets is clicked."/>

                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                        <TextBlock Text="Title Block:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="Bold"/>
                        <ComboBox x:Name="super_titleblock_cb" Width="320" Height="26"/>
                        <Button x:Name="super_apply_titleblock_b" Content="Apply to All Sheets" Click="super_apply_titleblock_click"
                                Width="150" Height="26" Margin="10,0,0,0"/>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button x:Name="super_scan_b" Content="Refresh Sheets" Click="super_scan_click" Width="110" Height="24"/>
                        <Button x:Name="super_add_row_b" Content="Add Row" Click="super_add_row_click" Width="90" Height="24" Margin="8,0,0,0"/>
                        <Button x:Name="super_remove_selected_b" Content="Remove Highlighted Row(s)" Click="super_remove_selected_click" Width="180" Height="24" Margin="8,0,0,0"
                                ToolTip="Click a row then Shift-click another to highlight a range (or Ctrl-click to add rows), then click this to remove/mark them."/>
                        <Button x:Name="super_move_up_b" Content="Move Up" Click="super_move_up_click" Width="80" Height="24" Margin="16,0,0,0"/>
                        <Button x:Name="super_move_down_b" Content="Move Down" Click="super_move_down_click" Width="90" Height="24" Margin="6,0,0,0"/>
                        <Button x:Name="super_apply_b" Content="Apply Changes" Click="super_apply_click" Width="130" Height="24" Margin="16,0,0,0" FontWeight="Bold"/>
                        <TextBlock x:Name="super_status_tb" Text="0 sheet(s)." VerticalAlignment="Center" Margin="16,0,0,0" FontStyle="Italic"/>
                    </StackPanel>

                    <DataGrid x:Name="super_grid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserSortColumns="False"
                              SelectionMode="Extended" SelectionUnit="FullRow" RowEditEnding="super_grid_row_edit_ending"
                              RowStyle="{StaticResource superRowStyle}">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Delete" Binding="{Binding marked_delete, Mode=TwoWay}" Width="55"/>
                            <DataGridTextColumn Header="Sheet Number" Binding="{Binding number, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="140"/>
                            <DataGridTextColumn Header="Sheet Name" Binding="{Binding name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="*"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding status_text}" IsReadOnly="True" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- TAB 3: Sheet Renamer -->
            <TabItem Header="Sheet Renamer">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: rule builder -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,8" FontSize="12"
                                       Text="Build the new Sheet Number / Sheet Name from tokens, e.g. A-{Serial|PAD3} or {Parameter:Discipline|UPPER}-{SheetNumber|LAST3}. Plain text outside {} is copied as-is, so it doubles as prefix/suffix. Pick a token below and click Insert to add it at the end of the selected box."/>

                            <GroupBox Header="Rule" Padding="6" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="New Sheet Number rule:" FontWeight="Bold" Margin="0,0,0,2"/>
                                    <TextBox x:Name="number_rule_tb" FontFamily="Consolas" FontSize="12" Margin="0,0,0,6"/>
                                    <TextBlock Text="New Sheet Name rule:" FontWeight="Bold" Margin="0,0,0,2"/>
                                    <TextBox x:Name="name_rule_tb" FontFamily="Consolas" FontSize="12" Margin="0,0,0,6"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <ComboBox x:Name="token_cb" Width="150" Height="24"/>
                                        <Button x:Name="insert_number_token_b" Content="Insert -&gt; Number" Width="120" Height="24" Margin="6,0,0,0" Click="insert_number_token_click"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <ComboBox x:Name="param_token_cb" Width="150" Height="24" ToolTip="Parameter to insert as {Parameter:Name}"/>
                                        <Button x:Name="insert_number_param_b" Content="Insert -&gt; Number" Width="120" Height="24" Margin="6,0,0,0" Click="insert_number_param_click"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <Button x:Name="insert_name_token_b" Content="Insert token -&gt; Name" Width="150" Height="24" Click="insert_name_token_click"/>
                                        <Button x:Name="insert_name_param_b" Content="Insert param -&gt; Name" Width="150" Height="24" Margin="6,0,0,0" Click="insert_name_param_click"/>
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Sequence ({Serial} / {Alpha})" Padding="6" Margin="0,0,0,8">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="Start:" VerticalAlignment="Center" Width="45"/>
                                        <TextBox x:Name="seq_start_tb" Text="1" Width="60" Height="22"/>
                                        <TextBlock Text="Step:" VerticalAlignment="Center" Width="40" Margin="12,0,0,0"/>
                                        <TextBox x:Name="seq_step_tb" Text="1" Width="60" Height="22"/>
                                    </StackPanel>
                                    <TextBlock Text="Order rows by:" Margin="0,4,0,2"/>
                                    <ComboBox x:Name="sort_by_cb" Height="24" Margin="0,0,0,4"/>
                                    <TextBlock Text="Reset sequence when this changes:" Margin="0,4,0,2"/>
                                    <ComboBox x:Name="reset_by_cb" Height="24" Margin="0,0,0,4"/>

                                    <TextBlock Text="Format:" Margin="0,4,0,2"/>
                                    <ComboBox x:Name="seq_format_cb" Height="24" Margin="0,0,0,4"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="Pad width:" VerticalAlignment="Center" Width="70"
                                                   ToolTip="Only used by Padded Number, e.g. width 2 = 01, 02, 03..."/>
                                        <TextBox x:Name="seq_pad_tb" Text="2" Width="40" Height="22"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="insert_seq_number_b" Content="Insert -&gt; Number" Width="120" Height="24" Click="insert_seq_number_click"/>
                                        <Button x:Name="insert_seq_name_b" Content="Insert -&gt; Name" Width="120" Height="24" Margin="6,0,0,0" Click="insert_seq_name_click"/>
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Find &amp; Replace" Padding="6" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="Find:" Margin="0,0,0,2"/>
                                    <TextBox x:Name="find_tb" Height="22" Margin="0,0,0,4"/>
                                    <TextBlock Text="Replace with:" Margin="0,0,0,2"/>
                                    <TextBox x:Name="replace_tb" Height="22" Margin="0,0,0,4"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <CheckBox x:Name="fr_case_cb" Content="Case sensitive" VerticalAlignment="Center"/>
                                        <CheckBox x:Name="fr_word_cb" Content="Whole word" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <ComboBox x:Name="fr_target_cb" Width="100" Height="24"/>
                                        <Button x:Name="find_replace_b" Content="Apply" Width="90" Height="24" Margin="8,0,0,0" Click="find_replace_click"/>
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Add Text" Padding="6" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBox x:Name="add_text_tb" Height="22" Margin="0,0,0,4"/>
                                    <StackPanel Orientation="Horizontal">
                                        <ComboBox x:Name="add_target_cb" Width="90" Height="24"/>
                                        <ComboBox x:Name="add_position_cb" Width="90" Height="24" Margin="6,0,0,0"/>
                                        <Button x:Name="add_text_b" Content="Apply" Width="70" Height="24" Margin="6,0,0,0" Click="add_text_click"/>
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Extract Segment" Padding="6" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="Split by:" Margin="0,0,0,2"/>
                                    <TextBox x:Name="seg_delim_tb" Height="22" Margin="0,0,0,4" ToolTip="The delimiter to split on, e.g. a dash -"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="Count from:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <ComboBox x:Name="seg_direction_cb" Width="80" Height="24"/>
                                        <TextBlock Text="Segment #:" VerticalAlignment="Center" Margin="10,0,6,0"/>
                                        <TextBox x:Name="seg_number_tb" Text="1" Width="40" Height="22"/>
                                    </StackPanel>
                                    <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#888888" Margin="0,0,0,4"
                                               Text="E.g. Split by &quot;-&quot;, Right, Segment 1 keeps whatever comes after the last dash."/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <Button x:Name="insert_seg_number_b" Content="Insert -&gt; Number" Width="120" Height="24" Click="insert_seg_number_click"/>
                                        <Button x:Name="insert_seg_name_b" Content="Insert -&gt; Name" Width="120" Height="24" Margin="6,0,0,0" Click="insert_seg_name_click"/>
                                    </StackPanel>
                                    <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#888888" Margin="0,0,0,4"
                                               Text="Insert adds this as a token in the rule above (Number uses {SheetNumber}, Name uses {SheetName}) so it combines with Sequence/other tokens in one Generate Preview - use this instead of Apply below if you're also using {Serial}/{Alpha}, since Apply overwrites whatever the current New Number/New Name already is."/>
                                    <StackPanel Orientation="Horizontal">
                                        <ComboBox x:Name="seg_target_cb" Width="100" Height="24"/>
                                        <Button x:Name="seg_extract_b" Content="Apply" Width="90" Height="24" Margin="8,0,0,0" Click="extract_segment_click"/>
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Case" Padding="6" Margin="0,0,0,8">
                                <StackPanel>
                                    <ComboBox x:Name="case_target_cb" Height="24" Margin="0,0,0,4"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="case_upper_b" Content="UPPER" Width="80" Height="24" Click="case_upper_click"/>
                                        <Button x:Name="case_lower_b" Content="lower" Width="80" Height="24" Margin="6,0,0,0" Click="case_lower_click"/>
                                        <Button x:Name="case_title_b" Content="Title" Width="80" Height="24" Margin="6,0,0,0" Click="case_title_click"/>
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Presets" Padding="6" Margin="0,0,0,8">
                                <StackPanel>
                                    <ComboBox x:Name="preset_cb" Height="24" Margin="0,0,0,4"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="preset_load_b" Content="Load" Width="80" Height="24" Click="preset_load_click"/>
                                        <Button x:Name="preset_save_b" Content="Save As..." Width="90" Height="24" Margin="6,0,0,0" Click="preset_save_click"/>
                                        <Button x:Name="preset_delete_b" Content="Delete" Width="80" Height="24" Margin="6,0,0,0" Click="preset_delete_click"/>
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Right: sheet table + apply -->
                    <DockPanel Grid.Column="2">
                        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,6" FontSize="12"
                                   Text="Check the sheets to rename, build a rule on the left, then Generate Preview. Review New Number / New Name / Status before applying - Duplicate/Empty rows are skipped automatically, never overwritten silently. New Number/New Name cells are also editable directly for a one-off tweak."/>

                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Search:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox x:Name="rn_search_tb" Width="180" Height="24"/>
                            <Button x:Name="rn_filter_b" Content="Filter" Width="70" Height="24" Margin="6,0,0,0" Click="rn_filter_click"/>
                            <Button x:Name="rn_clear_filter_b" Content="Clear" Width="60" Height="24" Margin="4,0,0,0" Click="rn_clear_filter_click"/>
                            <Button x:Name="rn_refresh_b" Content="Rescan Sheets" Width="110" Height="24" Margin="16,0,0,0" Click="rn_refresh_click"/>
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                            <Button x:Name="rn_select_all_b" Content="Select All" Width="90" Height="24" Click="rn_select_all_click"/>
                            <Button x:Name="rn_select_none_b" Content="Select None" Width="90" Height="24" Margin="6,0,0,0" Click="rn_select_none_click"/>
                            <Button x:Name="rn_select_highlighted_b" Content="Select Highlighted" Width="120" Height="24" Margin="6,0,0,0" Click="rn_select_highlighted_click"/>
                            <Button x:Name="rn_deselect_highlighted_b" Content="Deselect Highlighted" Width="130" Height="24" Margin="6,0,0,0" Click="rn_deselect_highlighted_click"/>
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                            <Button x:Name="generate_preview_b" Content="Generate Preview" Width="150" Height="32" FontWeight="Bold" Click="generate_preview_click"
                                    ToolTip="Run this once you're done building the rule and adjusting Sequence/Find &amp; Replace/etc."/>
                            <Button x:Name="reset_preview_b" Content="Reset Preview" Width="110" Height="32" Margin="6,0,0,0" Click="reset_preview_click"/>
                            <Button x:Name="rn_apply_b" Content="Apply Renumbering" Width="170" Height="32" FontWeight="Bold" Margin="16,0,0,0" Click="rn_apply_click"/>
                            <TextBlock x:Name="rn_status_tb" Text="0 sheet(s)." VerticalAlignment="Center" Margin="16,0,0,0" FontStyle="Italic"/>
                        </StackPanel>

                        <Border DockPanel.Dock="Top" Background="#F5F5F5" BorderBrush="#CCCCCC" BorderThickness="0,1,0,1"
                                Padding="8,6,8,6" Margin="0,0,0,6">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock x:Name="rn_preview_counts_tb" HorizontalAlignment="Center" FontWeight="Bold" FontSize="12"
                                           Text="Check sheets and click Generate Preview to see Ready/Duplicate/Empty counts here."/>
                                <TextBlock x:Name="rn_preview_example_tb" HorizontalAlignment="Center" FontSize="11" Foreground="#555555"
                                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis" Text=""/>
                            </StackPanel>
                        </Border>

                        <DataGrid x:Name="rn_grid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserSortColumns="True"
                                  SelectionMode="Extended" SelectionUnit="FullRow" RowEditEnding="rn_grid_row_edit_ending"
                                  RowStyle="{StaticResource renameRowStyle}">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="Select" Binding="{Binding selected, Mode=TwoWay}" Width="50"/>
                                <DataGridTextColumn Header="Sheet Number" Binding="{Binding original_number}" IsReadOnly="True" Width="110"/>
                                <DataGridTextColumn Header="Sheet Name" Binding="{Binding original_name}" IsReadOnly="True" Width="2*"/>
                                <DataGridTextColumn Header="New Number" Binding="{Binding new_number, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="110"/>
                                <DataGridTextColumn Header="New Name" Binding="{Binding new_name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="2*"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding status}" IsReadOnly="True" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>

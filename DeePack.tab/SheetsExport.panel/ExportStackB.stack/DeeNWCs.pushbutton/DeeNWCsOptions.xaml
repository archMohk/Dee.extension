<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeeNWCs — Export Options"
        ShowInTaskbar="False"
        MinHeight="560" MinWidth="620" Height="700" Width="640"
        WindowStartupLocation="CenterScreen">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,10"
                       Text="Batch-export views to NWC - pick where the Revit file(s) come from, which views to export, and how the Navisworks exporter itself should behave. Settings are remembered for next time."/>

            <GroupBox Header="Source" Margin="0,0,0,10">
                <StackPanel Margin="5">
                    <RadioButton x:Name="source_local_rb" Content="Local - export the currently open document(s)"
                                 GroupName="source" Margin="0,2,0,4"/>
                    <RadioButton x:Name="source_acc_rb" Content="ACC / BIM360 - browse a cloud project and batch-open files"
                                 GroupName="source" Margin="0,2,0,2"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="View Selection" Margin="0,0,0,10">
                <StackPanel Margin="5">
                    <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#555" Margin="0,0,0,6"
                               Text="Every non-template, graphical view whose name contains this text (case-insensitive) gets its own NWC file."/>
                    <DockPanel>
                        <TextBlock Text="View name contains:" VerticalAlignment="Center" Margin="0,0,8,0" DockPanel.Dock="Left"/>
                        <TextBox x:Name="view_contains_tb" Height="24" Text="NAVIS"/>
                    </DockPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="NWC Export Options" Margin="0,0,0,10">
                <StackPanel Margin="5">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                            <RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>
                        <CheckBox x:Name="opt_convert_element_properties" Grid.Row="0" Grid.Column="0" Content="Convert element properties" Margin="0,2"/>
                        <CheckBox x:Name="opt_convert_lights" Grid.Row="1" Grid.Column="0" Content="Convert lights" Margin="0,2"/>
                        <CheckBox x:Name="opt_convert_linked_cad" Grid.Row="2" Grid.Column="0" Content="Convert linked CAD formats" Margin="0,2" IsChecked="True"/>
                        <CheckBox x:Name="opt_export_links" Grid.Row="3" Grid.Column="0" Content="Convert linked files" Margin="0,2"/>
                        <CheckBox x:Name="opt_export_parts" Grid.Row="4" Grid.Column="0" Content="Convert construction parts" Margin="0,2"/>
                        <CheckBox x:Name="opt_export_element_ids" Grid.Row="5" Grid.Column="0" Content="Convert element Ids" Margin="0,2" IsChecked="True"/>

                        <CheckBox x:Name="opt_export_room_attribute" Grid.Row="0" Grid.Column="1" Content="Convert room as attribute" Margin="0,2" IsChecked="True"/>
                        <CheckBox x:Name="opt_export_urls" Grid.Row="1" Grid.Column="1" Content="Convert URLs" Margin="0,2" IsChecked="True"/>
                        <CheckBox x:Name="opt_divide_levels" Grid.Row="2" Grid.Column="1" Content="Divide File into Levels" Margin="0,2" IsChecked="True"/>
                        <CheckBox x:Name="opt_export_room_geometry" Grid.Row="3" Grid.Column="1" Content="Export room geometry" Margin="0,2" IsChecked="True"/>
                        <CheckBox x:Name="opt_find_missing_materials" Grid.Row="4" Grid.Column="1" Content="Try and find missing materials" Margin="0,2" IsChecked="True"/>
                    </Grid>

                    <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#888" Margin="0,0,0,4"
                               Text="The four below have no documented Revit API property on this tool's own research - they are applied best-effort. If your Revit version doesn't support one, it is silently skipped (noted in the results) rather than failing the whole export."/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>
                        <CheckBox x:Name="opt_embed_textures" Grid.Row="0" Grid.Column="0" Content="Embed Textures (best-effort)" Margin="0,2" Foreground="#666"/>
                        <CheckBox x:Name="opt_separate_custom_props" Grid.Row="1" Grid.Column="0" Content="Separate Custom properties (best-effort)" Margin="0,2" Foreground="#666"/>
                        <CheckBox x:Name="opt_strict_sectioning" Grid.Row="0" Grid.Column="1" Content="Strict Sectioning (best-effort)" Margin="0,2" Foreground="#666"/>
                        <CheckBox x:Name="opt_type_properties" Grid.Row="1" Grid.Column="1" Content="Type properties on Elements (best-effort)" Margin="0,2" Foreground="#666"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Coordinates:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="opt_coordinates_cb" Grid.Column="1" Height="24" Margin="0,0,12,0" SelectedIndex="0">
                            <ComboBoxItem Content="Shared"/>
                            <ComboBoxItem Content="Internal"/>
                        </ComboBox>
                        <TextBlock Grid.Column="2" Text="Parameters:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="opt_parameters_cb" Grid.Column="3" Height="24" SelectedIndex="2">
                            <ComboBoxItem Content="None"/>
                            <ComboBoxItem Content="Elements"/>
                            <ComboBoxItem Content="All"/>
                        </ComboBox>
                    </Grid>
                    <DockPanel Margin="0,8,0,0">
                        <TextBlock Text="Faceting Factor:" VerticalAlignment="Center" Margin="0,0,8,0" DockPanel.Dock="Left"/>
                        <TextBox x:Name="opt_faceting_factor_tb" Height="24" Text="1" Width="80" HorizontalAlignment="Left"/>
                    </DockPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Super Config" Margin="0,0,0,10">
                <StackPanel Margin="5">
                    <CheckBox x:Name="super_config_cb" Content="Enable Super Config"
                              FontWeight="Bold" Margin="0,0,0,6"
                              Checked="super_config_toggled" Unchecked="super_config_toggled"
                              ToolTip="Instead of relying on pre-named views, scan the document and create (or reuse) a dedicated export view - hides Levels and Grids automatically."/>
                    <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#555" Margin="0,0,0,8"
                               Text="When enabled, the View Selection filter above is ignored - exactly ONE view per document is used: created fresh (or reused/updated, per the setting below) with Levels and Grids hidden."/>

                    <StackPanel x:Name="super_config_panel" IsEnabled="False">
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="Created view name:" VerticalAlignment="Center" Margin="0,0,8,0" DockPanel.Dock="Left"/>
                            <TextBox x:Name="sc_view_name_tb" Height="24" Text="NWC Export View"/>
                        </DockPanel>

                        <CheckBox x:Name="sc_with_links_cb" Content="Include linked models in the created view" Margin="0,0,0,6"/>

                        <TextBlock Text="If a view with that name already exists:" Margin="0,0,0,2"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <RadioButton x:Name="sc_reuse_rb" Content="Reuse it (update settings)" GroupName="sc_view_mode" Margin="0,0,16,0"/>
                            <RadioButton x:Name="sc_delete_rb" Content="Delete after each export (always start fresh)" GroupName="sc_view_mode"/>
                        </StackPanel>

                        <CheckBox x:Name="sc_hide_clutter_cb" Content="Also hide Scope Boxes, Reference Planes, and Sun Path" Margin="0,0,0,6"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Discipline:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox x:Name="sc_discipline_cb" Grid.Column="1" Height="24" Margin="0,0,12,0" SelectedIndex="0">
                                <ComboBoxItem Content="Coordination"/>
                                <ComboBoxItem Content="Architectural"/>
                                <ComboBoxItem Content="Structural"/>
                                <ComboBoxItem Content="Mechanical"/>
                                <ComboBoxItem Content="Electrical"/>
                                <ComboBoxItem Content="Plumbing"/>
                            </ComboBox>
                            <TextBlock Grid.Column="2" Text="Phase:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox x:Name="sc_phase_cb" Grid.Column="3" Height="24" SelectedIndex="0">
                                <ComboBoxItem Content="Last phase in the project"/>
                                <ComboBoxItem Content="Leave default"/>
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <TextBlock x:Name="status_tb" FontSize="11" Foreground="#a00" Margin="0,0,0,8" TextWrapping="Wrap" Text=""/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="close_b" Content="Cancel" Width="90" Height="30" Margin="0,0,8,0" Click="close_click"/>
                <Button x:Name="continue_b" Content="CONTINUE" Width="120" Height="30"
                        Background="#1F6FB2" Foreground="White" BorderBrush="#1F6FB2"
                        FontWeight="Bold" Cursor="Hand" Click="continue_click"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>

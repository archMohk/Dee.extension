<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeeCleaner — Rooms, Families, Groups, Views &amp; Sheets Cleanup"
        ShowInTaskbar="False"
        MinHeight="640" MinWidth="1000" Height="720" Width="1080"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="scan_b" Content="Scan Project" Click="scan_click" Width="120" Height="26"/>
            <TextBlock x:Name="status_tb" Text="Nothing scanned yet." VerticalAlignment="Center" Margin="14,0,0,0" FontStyle="Italic"/>
        </StackPanel>

        <Button DockPanel.Dock="Bottom" x:Name="close_b" Content="Close" Click="close_click"
                Width="100" Height="26" HorizontalAlignment="Right" Margin="0,10,0,0"/>

        <TabControl x:Name="main_tabs">
            <!-- TAB 1: Zero-Area Rooms -->
            <TabItem Header="Zero-Area Rooms">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Rooms with zero Area are typically Unplaced or Not Enclosed. Review the list, check the ones to remove, then Delete Selected."/>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button x:Name="rooms_select_all_b" Content="Select All" Click="rooms_select_all_click" Width="90" Height="24"/>
                        <Button x:Name="rooms_deselect_all_b" Content="Deselect All" Click="rooms_deselect_all_click" Width="90" Height="24" Margin="6,0,0,0"/>
                        <Button x:Name="rooms_select_highlighted_b" Content="Select Highlighted" Click="rooms_select_highlighted_click" Width="130" Height="24" Margin="16,0,0,0"
                                ToolTip="Click a row then Shift-click another to highlight a range (or Ctrl-click to add rows), then click this to check them."/>
                        <Button x:Name="rooms_deselect_highlighted_b" Content="Deselect Highlighted" Click="rooms_deselect_highlighted_click" Width="140" Height="24" Margin="6,0,0,0"/>
                        <Button x:Name="rooms_delete_b" Content="Delete Selected" Click="rooms_delete_click" Width="120" Height="24" Margin="20,0,0,0"/>
                        <TextBlock x:Name="rooms_count_tb" Text="0 zero-area room(s)" VerticalAlignment="Center" Margin="20,0,0,0" FontStyle="Italic"/>
                    </StackPanel>
                    <DataGrid x:Name="rooms_grid" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Extended" SelectionUnit="FullRow">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Select" Binding="{Binding selected, Mode=TwoWay}" Width="60"/>
                            <DataGridTextColumn Header="Number" Binding="{Binding number}" IsReadOnly="True" Width="90"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding name}" IsReadOnly="True" Width="200"/>
                            <DataGridTextColumn Header="Level" Binding="{Binding level_name}" IsReadOnly="True" Width="140"/>
                            <DataGridTextColumn Header="Area" Binding="{Binding area_text}" IsReadOnly="True" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- TAB 2: In-Place Families -->
            <TabItem Header="In-Place Families">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Model in-place family instances found in the project, with their location. Check the ones you want to inspect, then Isolate Selected in 3D View - this creates/reuses a dedicated 3D view named 'DeeCleaner - In-Place Families' and temporarily isolates just those elements (Revit's own Temporary Hide/Isolate - reset it from the View Control Bar when done, or make it permanent from there too)."/>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button x:Name="inplace_select_all_b" Content="Select All" Click="inplace_select_all_click" Width="90" Height="24"/>
                        <Button x:Name="inplace_deselect_all_b" Content="Deselect All" Click="inplace_deselect_all_click" Width="90" Height="24" Margin="6,0,0,0"/>
                        <Button x:Name="inplace_select_highlighted_b" Content="Select Highlighted" Click="inplace_select_highlighted_click" Width="130" Height="24" Margin="16,0,0,0"
                                ToolTip="Click a row then Shift-click another to highlight a range (or Ctrl-click to add rows), then click this to check them."/>
                        <Button x:Name="inplace_deselect_highlighted_b" Content="Deselect Highlighted" Click="inplace_deselect_highlighted_click" Width="140" Height="24" Margin="6,0,0,0"/>
                        <Button x:Name="inplace_isolate_b" Content="Isolate Selected in 3D View" Click="inplace_isolate_click" Width="180" Height="24" Margin="20,0,0,0"/>
                        <TextBlock x:Name="inplace_count_tb" Text="0 in-place familie(s)" VerticalAlignment="Center" Margin="20,0,0,0" FontStyle="Italic"/>
                    </StackPanel>
                    <DataGrid x:Name="inplace_grid" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Extended" SelectionUnit="FullRow">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Select" Binding="{Binding selected, Mode=TwoWay}" Width="60"/>
                            <DataGridTextColumn Header="Family Name" Binding="{Binding name}" IsReadOnly="True" Width="220"/>
                            <DataGridTextColumn Header="Category" Binding="{Binding category_name}" IsReadOnly="True" Width="140"/>
                            <DataGridTextColumn Header="Level" Binding="{Binding level_name}" IsReadOnly="True" Width="120"/>
                            <DataGridTextColumn Header="Location (X, Y, Z)" Binding="{Binding location_text}" IsReadOnly="True" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- TAB 3: Unused Groups -->
            <TabItem Header="Unused Groups">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Model Group and Detail Group types with zero placed instances anywhere in the project. Check the ones to remove, then Delete Selected."/>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button x:Name="groups_select_all_b" Content="Select All" Click="groups_select_all_click" Width="90" Height="24"/>
                        <Button x:Name="groups_deselect_all_b" Content="Deselect All" Click="groups_deselect_all_click" Width="90" Height="24" Margin="6,0,0,0"/>
                        <Button x:Name="groups_select_highlighted_b" Content="Select Highlighted" Click="groups_select_highlighted_click" Width="130" Height="24" Margin="16,0,0,0"
                                ToolTip="Click a row then Shift-click another to highlight a range (or Ctrl-click to add rows), then click this to check them."/>
                        <Button x:Name="groups_deselect_highlighted_b" Content="Deselect Highlighted" Click="groups_deselect_highlighted_click" Width="140" Height="24" Margin="6,0,0,0"/>
                        <Button x:Name="groups_delete_b" Content="Delete Selected" Click="groups_delete_click" Width="120" Height="24" Margin="20,0,0,0"/>
                        <TextBlock x:Name="groups_count_tb" Text="0 unused group(s)" VerticalAlignment="Center" Margin="20,0,0,0" FontStyle="Italic"/>
                    </StackPanel>
                    <DataGrid x:Name="groups_grid" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Extended" SelectionUnit="FullRow">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Select" Binding="{Binding selected, Mode=TwoWay}" Width="60"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding name}" IsReadOnly="True" Width="260"/>
                            <DataGridTextColumn Header="Kind" Binding="{Binding kind}" IsReadOnly="True" Width="140"/>
                            <DataGridTextColumn Header="Placed Instances" Binding="{Binding instance_count_text}" IsReadOnly="True" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- TAB 4: Views -->
            <TabItem Header="Views">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Every View in the project (Sheets excluded - see the Sheets tab), flagged whether it's placed on any Sheet. Select All Not On Sheet is a shortcut to check the common cleanup candidates. Check the ones to remove, then Delete Selected."/>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button x:Name="views_select_all_b" Content="Select All" Click="views_select_all_click" Width="90" Height="24"/>
                        <Button x:Name="views_deselect_all_b" Content="Deselect All" Click="views_deselect_all_click" Width="90" Height="24" Margin="6,0,0,0"/>
                        <Button x:Name="views_select_highlighted_b" Content="Select Highlighted" Click="views_select_highlighted_click" Width="130" Height="24" Margin="16,0,0,0"
                                ToolTip="Click a row then Shift-click another to highlight a range (or Ctrl-click to add rows), then click this to check them."/>
                        <Button x:Name="views_deselect_highlighted_b" Content="Deselect Highlighted" Click="views_deselect_highlighted_click" Width="140" Height="24" Margin="6,0,0,0"/>
                        <Button x:Name="views_select_not_on_sheet_b" Content="Select All Not On Sheet" Click="views_select_not_on_sheet_click" Width="160" Height="24" Margin="16,0,0,0"/>
                        <Button x:Name="views_delete_b" Content="Delete Selected" Click="views_delete_click" Width="120" Height="24" Margin="16,0,0,0"/>
                        <TextBlock x:Name="views_count_tb" Text="0 view(s)" VerticalAlignment="Center" Margin="20,0,0,0" FontStyle="Italic"/>
                    </StackPanel>
                    <DataGrid x:Name="views_grid" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Extended" SelectionUnit="FullRow">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Select" Binding="{Binding selected, Mode=TwoWay}" Width="60"/>
                            <DataGridTextColumn Header="View Name" Binding="{Binding name}" IsReadOnly="True" Width="*"/>
                            <DataGridTextColumn Header="View Type" Binding="{Binding view_type}" IsReadOnly="True" Width="140"/>
                            <DataGridTextColumn Header="On Sheet?" Binding="{Binding on_sheet_text}" IsReadOnly="True" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- TAB 5: Sheets -->
            <TabItem Header="Sheets">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Every Sheet in the project, flagged whether it contains any View or Schedule. Select All Empty Sheets is a shortcut to check the common cleanup candidates. Check the ones to remove, then Delete Selected."/>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button x:Name="sheets_select_all_b" Content="Select All" Click="sheets_select_all_click" Width="90" Height="24"/>
                        <Button x:Name="sheets_deselect_all_b" Content="Deselect All" Click="sheets_deselect_all_click" Width="90" Height="24" Margin="6,0,0,0"/>
                        <Button x:Name="sheets_select_highlighted_b" Content="Select Highlighted" Click="sheets_select_highlighted_click" Width="130" Height="24" Margin="16,0,0,0"
                                ToolTip="Click a row then Shift-click another to highlight a range (or Ctrl-click to add rows), then click this to check them."/>
                        <Button x:Name="sheets_deselect_highlighted_b" Content="Deselect Highlighted" Click="sheets_deselect_highlighted_click" Width="140" Height="24" Margin="6,0,0,0"/>
                        <Button x:Name="sheets_select_empty_b" Content="Select All Empty Sheets" Click="sheets_select_empty_click" Width="160" Height="24" Margin="16,0,0,0"/>
                        <Button x:Name="sheets_delete_b" Content="Delete Selected" Click="sheets_delete_click" Width="120" Height="24" Margin="16,0,0,0"/>
                        <TextBlock x:Name="sheets_count_tb" Text="0 sheet(s)" VerticalAlignment="Center" Margin="20,0,0,0" FontStyle="Italic"/>
                    </StackPanel>
                    <DataGrid x:Name="sheets_grid" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Extended" SelectionUnit="FullRow">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Select" Binding="{Binding selected, Mode=TwoWay}" Width="60"/>
                            <DataGridTextColumn Header="Number" Binding="{Binding number}" IsReadOnly="True" Width="100"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding name}" IsReadOnly="True" Width="*"/>
                            <DataGridTextColumn Header="Contains Views?" Binding="{Binding has_views_text}" IsReadOnly="True" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>

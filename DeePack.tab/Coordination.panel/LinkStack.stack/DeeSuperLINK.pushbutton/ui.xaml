<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeeSuperLINK — Link ACC Models Into Each Other (no file open)"
        ShowInTaskbar="False"
        MinHeight="640" MinWidth="1060" Height="720" Width="1140"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="10">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="Links ACC/BIM360 cloud models into each other without opening anything first. Pick a project, choose a direction, then pick the single file on one side and tick the many files on the other. Each host model is opened in the background, the link is created, and the host is synchronized back to ACC."/>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem><TextBlock x:Name="status_tb" Text="Ready."/></StatusBarItem>
        </StatusBar>

        <Grid DockPanel.Dock="Bottom" x:Name="progress_host" Height="26" Margin="0,4,0,4" Visibility="Collapsed">
            <ProgressBar x:Name="progress_bar" Minimum="0" Maximum="100" Height="26"/>
            <TextBlock x:Name="progress_text_tb" HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontWeight="Bold" FontSize="12" Text=""/>
        </Grid>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,8">
            <Button x:Name="run_b" Content="Create Links" Width="150" Height="30" FontWeight="Bold" Click="run_click"/>
            <Button x:Name="close_b" Content="Close" Width="90" Height="30" Margin="16,0,0,0" Click="close_click"/>
        </StackPanel>

        <GroupBox DockPanel.Dock="Top" Header="1. ACC Project" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" Margin="6">
                <Button x:Name="pick_project_b" Content="Pick Hub / Project..." Width="160" Height="26" Click="pick_project_click"/>
                <TextBlock x:Name="project_tb" VerticalAlignment="Center" Margin="12,0,0,0"
                           Text="No project selected." FontStyle="Italic"/>
            </StackPanel>
        </GroupBox>

        <GroupBox DockPanel.Dock="Top" Header="2. Direction and placement" Margin="0,0,0,8">
            <StackPanel Margin="6">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="mode_one_to_many_rb" GroupName="mode" IsChecked="True"
                                 Content="Link ONE model into MANY hosts" Checked="mode_changed"/>
                    <RadioButton x:Name="mode_many_to_one_rb" GroupName="mode" Margin="24,0,0,0"
                                 Content="Link MANY models into ONE host" Checked="mode_changed"/>
                </StackPanel>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="single_label_tb" Text="Model to link:"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox Grid.Column="1" x:Name="single_cb" Height="24" SelectionChanged="single_changed"/>
                    <TextBlock Grid.Column="3" Text="Placement:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox Grid.Column="4" x:Name="placement_cb" Height="24"/>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="Sync comment:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="sync_comment_tb" Width="420" Height="24" VerticalContentAlignment="Center"
                             Text="Synchronize"/>
                    <CheckBox x:Name="skip_existing_cb" Content="Skip if already linked" IsChecked="True"
                              VerticalAlignment="Center" Margin="20,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <TextBlock x:Name="many_label_tb" FontWeight="Bold" Text="3. Host models to link INTO (tick them):"/>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock Text="Search:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="search_tb" Width="260" Height="24" VerticalContentAlignment="Center"
                         TextChanged="search_changed"
                         ToolTip="Type part of a file name. Multiple words all have to match, in any order - e.g. &quot;vil cor&quot; finds 25-036-NAG-BIM-VIL-00A-COR-AR."/>
                <Button x:Name="clear_search_b" Content="Clear" Width="60" Height="24" Margin="6,0,0,0" Click="clear_search_click"/>
                <Button x:Name="select_all_b" Content="Select All" Width="90" Height="24" Margin="16,0,0,0" Click="select_all_click"/>
                <Button x:Name="select_none_b" Content="Select None" Width="90" Height="24" Margin="6,0,0,0" Click="select_none_click"/>
                <Button x:Name="refresh_b" Content="Refresh List" Width="100" Height="24" Margin="6,0,0,0" Click="refresh_click"/>
                <TextBlock x:Name="hidden_warning_tb" VerticalAlignment="Center" Margin="16,0,0,0"
                           Foreground="#C62828" FontWeight="Bold" Text=""/>
            </StackPanel>
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.3*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <DataGrid Grid.Column="0" x:Name="files_grid" AutoGenerateColumns="False" CanUserAddRows="False"
                      CanUserSortColumns="True" SelectionMode="Extended" RowHeaderWidth="0">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="Use" Binding="{Binding selected, Mode=TwoWay}" Width="50"/>
                    <DataGridTextColumn Header="Revit File" Binding="{Binding name}" IsReadOnly="True" Width="*"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding status}" IsReadOnly="True" Width="200"/>
                </DataGrid.Columns>
            </DataGrid>

            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Text="Live status" FontWeight="Bold" Margin="0,0,0,4"/>
                <TextBox x:Name="log_tb" IsReadOnly="True" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas" FontSize="11"/>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>

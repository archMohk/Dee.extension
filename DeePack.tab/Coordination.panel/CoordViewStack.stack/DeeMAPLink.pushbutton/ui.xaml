<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeeMAPLink — Scan ACC/Local, Map Links, Batch-Create (no file open)"
        ShowInTaskbar="False"
        MinHeight="780" MinWidth="1300" Height="860" Width="1380"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="10">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="Scans an ACC project or a local folder for worksharing Revit files, pools them into two lists, and lets you build a many-to-many link map: tick files in List 1 (sources), tick files in List 2 (targets), press Add Match. Each target host is then opened in the background, every matched source is linked into it, and the host is synchronized back - no file ever opened by hand."/>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem><TextBlock x:Name="status_tb" Text="Ready."/></StatusBarItem>
        </StatusBar>

        <Grid DockPanel.Dock="Bottom" x:Name="progress_host" Height="26" Margin="0,4,0,4" Visibility="Collapsed">
            <ProgressBar x:Name="progress_bar" Minimum="0" Maximum="100" Height="26"/>
            <TextBlock x:Name="progress_text_tb" HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontWeight="Bold" FontSize="12" Text=""/>
        </Grid>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,8">
            <Button x:Name="run_b" Content="Create Links" Width="150" Height="30" FontWeight="Bold" Click="run_click"/>
            <Button x:Name="close_b" Content="Close" Width="90" Height="30" Margin="16,0,0,0" Click="close_click"/>
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Height="130" Margin="0,8,0,0">
            <TextBlock DockPanel.Dock="Top" Text="Live status" FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBox x:Name="log_tb" IsReadOnly="True" TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas" FontSize="11"/>
        </DockPanel>

        <GroupBox DockPanel.Dock="Top" Header="1. Source" Margin="0,0,0,8">
            <StackPanel Margin="6">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="source_acc_rb" GroupName="source" IsChecked="True"
                                 Content="ACC / BIM360 project" Checked="source_mode_changed"/>
                    <RadioButton x:Name="source_local_rb" GroupName="source" Margin="24,0,0,0"
                                 Content="Local folder" Checked="source_mode_changed"/>
                </StackPanel>

                <Grid x:Name="acc_row" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" x:Name="pick_project_b" Content="Pick Hub / Project..." Width="160" Height="26" Click="pick_project_click"/>
                    <TextBlock Grid.Column="1" x:Name="project_tb" VerticalAlignment="Center" Margin="12,0,0,0"
                               Text="No project selected." FontStyle="Italic"/>
                </Grid>

                <Grid x:Name="local_row" Margin="0,10,0,0" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" x:Name="pick_folder_b" Content="Pick Folder..." Width="160" Height="26" Click="pick_folder_click"/>
                    <TextBlock Grid.Column="1" x:Name="folder_tb" VerticalAlignment="Center" Margin="12,0,0,0"
                               Text="No folder selected." FontStyle="Italic"/>
                    <CheckBox Grid.Column="2" x:Name="recursive_cb" Content="Include subfolders"
                              VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <Button Grid.Column="3" x:Name="scan_folder_b" Content="Scan Folder" Width="110" Height="26"
                            Margin="12,0,0,0" Click="scan_folder_click"/>
                </Grid>
            </StackPanel>
        </GroupBox>

        <GroupBox DockPanel.Dock="Top" Header="2. Link Type and options" Margin="0,0,0,8">
            <Grid Margin="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Link Type:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox Grid.Column="1" x:Name="placement_cb" Height="24"/>
                <TextBlock Grid.Column="3" Text="Sync comment:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox Grid.Column="4" x:Name="sync_comment_tb" Height="24" VerticalContentAlignment="Center"
                         Text="DeeMAPLink - automated link creation"/>
                <CheckBox Grid.Column="5" x:Name="skip_existing_cb" Content="Skip if already linked" IsChecked="True"
                          VerticalAlignment="Center" Margin="20,0,0,0"/>
            </Grid>
        </GroupBox>

        <TextBlock DockPanel.Dock="Top" Text="3. Match files" FontWeight="Bold" Margin="0,0,0,4"/>

        <Border DockPanel.Dock="Top" BorderBrush="#888888" BorderThickness="1" Margin="0,0,0,8" Padding="8">
            <StackPanel>
                <TextBlock Text="Analysis" FontWeight="Bold" Margin="0,0,0,4"/>
                <TextBlock x:Name="analysis_tb" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11"
                           Text="No matches yet. Tick files in both lists and press Add Match."/>
            </StackPanel>
        </Border>

        <TabControl x:Name="mode_tabs">
            <TabItem Header="Two Lists">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.95*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="1.1*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="0.95*"/>
                </Grid.ColumnDefinitions>

                <DockPanel Grid.Column="0">
                    <TextBlock DockPanel.Dock="Top" Text="List 1 — Sources (will be linked)" FontWeight="Bold" Margin="0,0,0,4"/>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBox x:Name="search1_tb" Width="150" Height="22" VerticalContentAlignment="Center"
                                 TextChanged="search1_changed" ToolTip="Type part of a file name - multiple words all have to match, in any order."/>
                        <Button x:Name="clear_search1_b" Content="Clear" Width="50" Height="22" Margin="4,0,0,0" Click="clear_search1_click"/>
                        <Button x:Name="select_all1_b" Content="All" Width="40" Height="22" Margin="8,0,0,0" Click="select_all1_click"/>
                        <Button x:Name="select_none1_b" Content="None" Width="46" Height="22" Margin="4,0,0,0" Click="select_none1_click"/>
                    </StackPanel>
                    <DataGrid x:Name="list1_grid" AutoGenerateColumns="False" CanUserAddRows="False"
                              CanUserSortColumns="True" SelectionMode="Extended" RowHeaderWidth="0">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Use" Binding="{Binding selected, Mode=TwoWay}" Width="40"/>
                            <DataGridTextColumn Header="Revit File" Binding="{Binding name}" IsReadOnly="True" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>

                <DockPanel Grid.Column="2">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4" HorizontalAlignment="Center">
                        <Button x:Name="add_match_b" Content="Add Match  -&gt;" Width="120" Height="26" FontWeight="Bold" Click="add_match_click"/>
                        <Button x:Name="remove_match_b" Content="Remove Selected" Width="120" Height="26" Margin="8,0,0,0" Click="remove_match_click"/>
                        <Button x:Name="clear_matches_b" Content="Clear All" Width="80" Height="26" Margin="8,0,0,0" Click="clear_matches_click"/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Matches (Source -&gt; Target)" FontWeight="Bold" Margin="0,4,0,4" HorizontalAlignment="Center"/>
                    <DataGrid x:Name="matches_grid" AutoGenerateColumns="False" CanUserAddRows="False"
                              CanUserSortColumns="True" SelectionMode="Extended" RowHeaderWidth="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Source (linked)" Binding="{Binding source}" IsReadOnly="True" Width="*"/>
                            <DataGridTextColumn Header="Target (host)" Binding="{Binding target}" IsReadOnly="True" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>

                <DockPanel Grid.Column="4">
                    <TextBlock DockPanel.Dock="Top" Text="List 2 — Targets (hosts)" FontWeight="Bold" Margin="0,0,0,4"/>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBox x:Name="search2_tb" Width="150" Height="22" VerticalContentAlignment="Center"
                                 TextChanged="search2_changed" ToolTip="Type part of a file name - multiple words all have to match, in any order."/>
                        <Button x:Name="clear_search2_b" Content="Clear" Width="50" Height="22" Margin="4,0,0,0" Click="clear_search2_click"/>
                        <Button x:Name="select_all2_b" Content="All" Width="40" Height="22" Margin="8,0,0,0" Click="select_all2_click"/>
                        <Button x:Name="select_none2_b" Content="None" Width="46" Height="22" Margin="4,0,0,0" Click="select_none2_click"/>
                    </StackPanel>
                    <DataGrid x:Name="list2_grid" AutoGenerateColumns="False" CanUserAddRows="False"
                              CanUserSortColumns="True" SelectionMode="Extended" RowHeaderWidth="0">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Use" Binding="{Binding selected, Mode=TwoWay}" Width="40"/>
                            <DataGridTextColumn Header="Revit File" Binding="{Binding name}" IsReadOnly="True" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Grid>
            </TabItem>
            <TabItem Header="Wire Map">
                <DockPanel Margin="6">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="Show:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="map_search_tb" Width="190" Height="22"
                                 VerticalContentAlignment="Center" TextChanged="map_search_changed"
                                 ToolTip="Type part of a file name - multiple words all have to match, in any order."/>
                        <Button x:Name="map_clear_search_b" Content="Clear" Width="50" Height="22"
                                Margin="4,0,0,0" Click="map_clear_search_click"/>
                        <Button x:Name="map_refresh_b" Content="Re-arrange" Width="90" Height="22"
                                Margin="14,0,0,0" Click="map_refresh_click"
                                ToolTip="Lay the boxes out again from scratch."/>
                        <Button x:Name="map_clear_wires_b" Content="Clear Wires" Width="90" Height="22"
                                Margin="6,0,0,0" Click="map_clear_wires_click"/>
                        <TextBlock x:Name="map_count_tb" VerticalAlignment="Center" Margin="14,0,0,0"
                                   Foreground="#888" Text=""/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Bottom" Margin="0,6,0,0" Foreground="#888" FontSize="11"
                               Text="Drag from one file to another to link the first INTO the second. Click a wire to remove it. Drag a box to move it."/>
                    <Border BorderBrush="#555" BorderThickness="1">
                        <ScrollViewer x:Name="map_scroll"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto">
                            <Canvas x:Name="map_canvas" Background="#1E1E1E"
                                    Width="2600" Height="1600"/>
                        </ScrollViewer>
                    </Border>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>

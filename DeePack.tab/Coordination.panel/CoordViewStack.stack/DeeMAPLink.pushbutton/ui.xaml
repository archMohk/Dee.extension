<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeeMAPLink — Scan ACC/Local, Map Links, Batch-Create (no file open)"
        ShowInTaskbar="False"
        MinHeight="780" MinWidth="1300" Height="860" Width="1380"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="10">
        <Border DockPanel.Dock="Right" Width="380" Margin="8,0,0,0"
                BorderBrush="#666" BorderThickness="1,0,0,0" Padding="8,0,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="MATCHES  (Source → Target)"
                           FontWeight="Bold" Foreground="#F2994D"
                           Margin="0,0,0,6"/>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                    <Button x:Name="add_match_b" Content="Add from ticked lists" Width="150"
                            Height="24" FontWeight="Bold" Click="add_match_click"
                            ToolTip="Adds every ticked file in List 1 into every ticked file in List 2."/>
                    <Button x:Name="remove_match_b" Content="Remove" Width="70" Height="24"
                            Margin="6,0,0,0" Click="remove_match_click"/>
                </StackPanel>
                <Button DockPanel.Dock="Bottom" x:Name="clear_matches_b" Content="Clear All"
                        Height="24" Margin="0,6,0,0" Click="clear_matches_click"/>
                <Border DockPanel.Dock="Bottom" BorderBrush="#666" BorderThickness="1"
                        Margin="0,8,0,0" Padding="6">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="ANALYSIS" FontWeight="Bold"
                                   Foreground="#F2994D" Margin="0,0,0,4"/>
                        <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto">
                            <TextBlock x:Name="analysis_tb" FontFamily="Consolas" FontSize="10"
                                       Text="No matches yet. Tick files in both lists, or wire two files on the map."/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
                <DataGrid x:Name="matches_grid" AutoGenerateColumns="False" CanUserAddRows="False"
                          CanUserSortColumns="True" SelectionMode="Extended" RowHeaderWidth="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Source (linked)" Binding="{Binding source}" IsReadOnly="True" Width="*"/>
                        <DataGridTextColumn Header="Target (host)" Binding="{Binding target}" IsReadOnly="True" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="Scans an ACC project or a local folder for worksharing Revit files and builds a many-to-many link map. Two tabs, two ways to build the same list, shown in MATCHES down the right: Two Lists to tick files and press Add, or Wire Map to click a source then a target. Each target host is then opened in the background, every matched source is linked into it, and the host is synchronized back - no file ever opened by hand."/>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem><TextBlock x:Name="status_tb" Text="Ready."/></StatusBarItem>
        </StatusBar>

        <Grid DockPanel.Dock="Bottom" x:Name="progress_host" Height="26" Margin="0,4,0,4" Visibility="Collapsed">
            <ProgressBar x:Name="progress_bar" Minimum="0" Maximum="100" Height="26"/>
            <TextBlock x:Name="progress_text_tb" HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontWeight="Bold" FontSize="12" Text=""/>
        </Grid>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,8">
            <Button x:Name="run_b" Content="Create Links" Width="150" Height="30" FontWeight="Bold" Click="run_click"/>
            <Button x:Name="close_b" Content="Close" Width="90" Height="30" Margin="16,0,0,0" Click="close_click"/>
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Height="130" Margin="0,8,0,0">
            <TextBlock DockPanel.Dock="Top" Text="Live status" FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBox x:Name="log_tb" IsReadOnly="True" TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas" FontSize="11"/>
        </DockPanel>

        <GroupBox DockPanel.Dock="Top" Header="1. Source" Margin="0,0,0,8">
            <StackPanel Margin="6">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="source_acc_rb" GroupName="source" IsChecked="True"
                                 Content="ACC / BIM360 project" Checked="source_mode_changed"/>
                    <RadioButton x:Name="source_local_rb" GroupName="source" Margin="24,0,0,0"
                                 Content="Local folder" Checked="source_mode_changed"/>
                </StackPanel>

                <Grid x:Name="acc_row" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" x:Name="pick_project_b" Content="Pick Hub / Project..." Width="160" Height="26" Click="pick_project_click"/>
                    <TextBlock Grid.Column="1" x:Name="project_tb" VerticalAlignment="Center" Margin="12,0,0,0"
                               Text="No project selected." FontStyle="Italic"/>
                </Grid>

                <Grid x:Name="local_row" Margin="0,10,0,0" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" x:Name="pick_folder_b" Content="Pick Folder..." Width="160" Height="26" Click="pick_folder_click"/>
                    <TextBlock Grid.Column="1" x:Name="folder_tb" VerticalAlignment="Center" Margin="12,0,0,0"
                               Text="No folder selected." FontStyle="Italic"/>
                    <CheckBox Grid.Column="2" x:Name="recursive_cb" Content="Include subfolders"
                              VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <Button Grid.Column="3" x:Name="scan_folder_b" Content="Scan Folder" Width="110" Height="26"
                            Margin="12,0,0,0" Click="scan_folder_click"/>
                </Grid>
            </StackPanel>
        </GroupBox>

        <GroupBox DockPanel.Dock="Top" Header="2. Link Type and options" Margin="0,0,0,8">
            <Grid Margin="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Link Type:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox Grid.Row="0" Grid.Column="1" x:Name="placement_cb" Height="24"/>
                <TextBlock Grid.Row="0" Grid.Column="3" Text="Sync comment:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox Grid.Row="0" Grid.Column="4" x:Name="sync_comment_tb" Height="24" VerticalContentAlignment="Center"
                         Text="Synchronize"/>
                <CheckBox Grid.Row="0" Grid.Column="5" x:Name="skip_existing_cb" Content="Skip if already linked" IsChecked="True"
                          VerticalAlignment="Center" Margin="20,0,0,0"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Link as:" VerticalAlignment="Center" Margin="0,8,6,0"/>
                <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,8,0,0">
                    <RadioButton x:Name="attachment_overlay_rb" GroupName="attachment" IsChecked="True"
                                 Content="Overlay" VerticalAlignment="Center"
                                 ToolTip="Default. This link does NOT pass through if the host is itself linked into a third model."/>
                    <RadioButton x:Name="attachment_attachment_rb" GroupName="attachment" Margin="20,0,0,0"
                                 Content="Attachment" VerticalAlignment="Center"
                                 ToolTip="This link DOES pass through if the host is itself linked into a third model."/>
                </StackPanel>

                <CheckBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4" x:Name="skip_completed_cb"
                          Content="Skip hosts already synchronized in a previous run of this batch (recommended - lets a crash mid-batch resume without redoing finished hosts)"
                          IsChecked="True" VerticalAlignment="Center" Margin="0,8,0,0"/>
                <Button Grid.Row="2" Grid.Column="5" x:Name="clear_progress_b" Content="Clear History" Width="110" Height="22"
                        Margin="20,8,0,0" Click="clear_progress_click"
                        ToolTip="Forget which hosts were already completed for this project/folder, so the next run processes everything again."/>
            </Grid>
        </GroupBox>

        <TabControl x:Name="mode_tabs">

            <TabItem Header="Two Lists">
                <Grid Margin="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" MinWidth="200"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="1*" MinWidth="200"/>
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0">
                        <TextBlock DockPanel.Dock="Top" Text="List 1 — Sources (will be linked)" FontWeight="Bold" Margin="0,0,0,4"/>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBox x:Name="search1_tb" Width="130" Height="22" VerticalContentAlignment="Center"
                                     TextChanged="search1_changed" ToolTip="Type part of a file name - multiple words all have to match, in any order."/>
                            <Button x:Name="clear_search1_b" Content="Clear" Width="46" Height="22" Margin="4,0,0,0" Click="clear_search1_click"/>
                            <Button x:Name="select_all1_b" Content="All" Width="36" Height="22" Margin="6,0,0,0" Click="select_all1_click"/>
                            <Button x:Name="select_none1_b" Content="None" Width="44" Height="22" Margin="4,0,0,0" Click="select_none1_click"/>
                        </StackPanel>
                        <DataGrid x:Name="list1_grid" AutoGenerateColumns="False" CanUserAddRows="False"
                                  CanUserSortColumns="True" SelectionMode="Extended" RowHeaderWidth="0">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="Use" Binding="{Binding selected, Mode=TwoWay}" Width="36"/>
                                <DataGridTextColumn Header="Revit File" Binding="{Binding name}" IsReadOnly="True" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>

                    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                                  Background="#444" ResizeBehavior="PreviousAndNext"/>

                    <DockPanel Grid.Column="2">
                        <TextBlock DockPanel.Dock="Top" Text="List 2 — Targets (hosts)" FontWeight="Bold" Margin="0,0,0,4"/>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBox x:Name="search2_tb" Width="130" Height="22" VerticalContentAlignment="Center"
                                     TextChanged="search2_changed" ToolTip="Type part of a file name - multiple words all have to match, in any order."/>
                            <Button x:Name="clear_search2_b" Content="Clear" Width="46" Height="22" Margin="4,0,0,0" Click="clear_search2_click"/>
                            <Button x:Name="select_all2_b" Content="All" Width="36" Height="22" Margin="6,0,0,0" Click="select_all2_click"/>
                            <Button x:Name="select_none2_b" Content="None" Width="44" Height="22" Margin="4,0,0,0" Click="select_none2_click"/>
                        </StackPanel>
                        <DataGrid x:Name="list2_grid" AutoGenerateColumns="False" CanUserAddRows="False"
                                  CanUserSortColumns="True" SelectionMode="Extended" RowHeaderWidth="0">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="Use" Binding="{Binding selected, Mode=TwoWay}" Width="36"/>
                                <DataGridTextColumn Header="Revit File" Binding="{Binding name}" IsReadOnly="True" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Wire Map">
                <DockPanel Margin="6">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                        <Button x:Name="map_refresh_b" Content="Redraw" Width="70" Height="22"
                                Click="map_refresh_click"/>
                        <Button x:Name="map_clear_wires_b" Content="Clear Wires" Width="90" Height="22"
                                Margin="6,0,0,0" Click="map_clear_wires_click"/>
                        <TextBlock x:Name="map_count_tb" VerticalAlignment="Center" Margin="14,0,0,0"
                                   Foreground="#888" Text=""/>
                    </StackPanel>

                    <Border DockPanel.Dock="Bottom" Background="#2B2B2B" BorderBrush="#555"
                            BorderThickness="1" Padding="6,4" Margin="0,6,0,0">
                        <TextBlock x:Name="map_hint_tb" FontSize="11" Foreground="#CCC"
                                   Text="Click a file on the left, then a file on the right, to link the first into the second."/>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" MinWidth="220"/>
                            <ColumnDefinition Width="170" MinWidth="80"/>
                            <ColumnDefinition Width="1*" MinWidth="220"/>
                        </Grid.ColumnDefinitions>

                        <DockPanel Grid.Column="0">
                            <TextBlock DockPanel.Dock="Top" Foreground="#F2994D" FontWeight="Bold"
                                       Margin="0,0,0,3" Text="SOURCES — click one to start"/>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,3">
                                <TextBox x:Name="map_left_search_tb" Width="140" Height="22"
                                         VerticalContentAlignment="Center" TextChanged="map_left_search_changed"
                                         ToolTip="Filter the SOURCES column only."/>
                                <Button x:Name="map_left_clear_b" Content="Clear" Width="46" Height="22"
                                        Margin="4,0,0,0" Click="map_left_clear_click"/>
                                <TextBlock x:Name="map_left_count_tb" VerticalAlignment="Center"
                                           Margin="8,0,0,0" Foreground="#888" Text=""/>
                            </StackPanel>
                            <WrapPanel DockPanel.Dock="Top" x:Name="map_left_filters_panel" Margin="0,0,0,3"/>
                            <Border BorderBrush="#555" BorderThickness="1">
                                <ScrollViewer x:Name="map_left_scroll" VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel x:Name="map_left_panel" Background="#1E1E1E"/>
                                </ScrollViewer>
                            </Border>
                        </DockPanel>

                        <Canvas Grid.Column="1" x:Name="map_canvas" Background="#161616"
                                ClipToBounds="True"/>

                        <DockPanel Grid.Column="2">
                            <TextBlock DockPanel.Dock="Top" Foreground="#F2994D" FontWeight="Bold"
                                       Margin="0,0,0,3" Text="TARGETS — click one to finish"/>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,3">
                                <TextBox x:Name="map_right_search_tb" Width="140" Height="22"
                                         VerticalContentAlignment="Center" TextChanged="map_right_search_changed"
                                         ToolTip="Filter the TARGETS column only."/>
                                <Button x:Name="map_right_clear_b" Content="Clear" Width="46" Height="22"
                                        Margin="4,0,0,0" Click="map_right_clear_click"/>
                                <TextBlock x:Name="map_right_count_tb" VerticalAlignment="Center"
                                           Margin="8,0,0,0" Foreground="#888" Text=""/>
                            </StackPanel>
                            <WrapPanel DockPanel.Dock="Top" x:Name="map_right_filters_panel" Margin="0,0,0,3"/>
                            <Border BorderBrush="#555" BorderThickness="1">
                                <ScrollViewer x:Name="map_right_scroll" VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel x:Name="map_right_panel" Background="#1E1E1E"/>
                                </ScrollViewer>
                            </Border>
                        </DockPanel>
                    </Grid>
                </DockPanel>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>

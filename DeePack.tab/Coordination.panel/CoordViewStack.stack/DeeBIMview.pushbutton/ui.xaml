<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeeBIMview — BIM Coordination &amp; NAVIS views, in batch"
        ShowInTaskbar="False"
        MinHeight="760" MinWidth="980" Height="860" Width="1060"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="10">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="Choose where the models are, tick the ones to process, tick the steps to run, set the names, then press Run. Views-only is the default - Publish Settings, Sync, Close and Publish are opt-in."/>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="status_tb" Text="Ready."/>
            </StatusBarItem>
        </StatusBar>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,8">
            <Button x:Name="run_b" Content="Run" Width="170" Height="32" FontWeight="Bold" Click="run_click"/>
            <Button x:Name="close_b" Content="Close" Width="90" Height="32" Margin="14,0,0,0" Click="close_click"/>
        </StackPanel>

        <!-- ===================== OPTIONS (steps / modes / names) ===================== -->
        <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1.2*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="3. Steps to run" Margin="0,0,8,0">
                <StackPanel Margin="8">
                    <CheckBox x:Name="step_views_cb" Content="Create / Update Views" IsChecked="True" Margin="0,2,0,2" Click="step_changed"/>
                    <CheckBox x:Name="step_pubset_cb" Content="Configure Publish Settings" Margin="0,2,0,2" Click="step_changed"/>
                    <CheckBox x:Name="step_sync_cb" Content="Synchronize With Central" Margin="0,2,0,2" Click="step_changed"/>
                    <CheckBox x:Name="step_close_cb" Content="Close After Sync  (ACC only)" Margin="0,2,0,2" Click="step_changed"/>
                    <CheckBox x:Name="step_publish_cb" Content="Publish  (ACC only)" Margin="0,2,0,2" Click="step_changed"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Grid.Column="1" Header="4. ACC file handling" Margin="0,0,8,0">
                <StackPanel Margin="8">
                    <TextBlock Text="How each file is opened:" Margin="0,0,0,2"/>
                    <RadioButton x:Name="open_regular_rb" GroupName="open_mode" Content="Regular open" IsChecked="True" Margin="8,2,0,2"/>
                    <RadioButton x:Name="open_closed_rb" GroupName="open_mode" Content="Open with all worksets closed" Margin="8,2,0,8"/>
                    <TextBlock Text="Publish mode:" Margin="0,0,0,2"/>
                    <RadioButton x:Name="publish_normal_rb" GroupName="publish_mode" Content="Normal publish" IsChecked="True" Margin="8,2,0,2"/>
                    <RadioButton x:Name="publish_nolinks_rb" GroupName="publish_mode" Content="Publish without links" Margin="8,2,0,2"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Grid.Column="2" Header="5. Names">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="3D view type:" VerticalAlignment="Center" Margin="0,2,8,2"/>
                    <TextBox x:Name="viewtype_tb" Grid.Row="0" Grid.Column="1" Height="24" VerticalContentAlignment="Center" Margin="0,2,0,2"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Coordination view:" VerticalAlignment="Center" Margin="0,2,8,2"/>
                    <TextBox x:Name="coord_tb" Grid.Row="1" Grid.Column="1" Height="24" VerticalContentAlignment="Center" Margin="0,2,0,2"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="NAVIS view:" VerticalAlignment="Center" Margin="0,2,8,2"/>
                    <TextBox x:Name="navis_tb" Grid.Row="2" Grid.Column="1" Height="24" VerticalContentAlignment="Center" Margin="0,2,0,2"/>
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Publish set:" VerticalAlignment="Center" Margin="0,2,8,2"/>
                    <TextBox x:Name="pubset_tb" Grid.Row="3" Grid.Column="1" Height="24" VerticalContentAlignment="Center" Margin="0,2,0,2"/>
                </Grid>
            </GroupBox>
        </Grid>

        <!-- ===================== MODELS (source + list) ===================== -->
        <GroupBox DockPanel.Dock="Top" Header="1. Models" Margin="0,0,0,8">
            <StackPanel Margin="8">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="source_acc_rb" GroupName="source" Content="ACC project  (open cloud files in batch)"
                                 Margin="0,0,28,0" Checked="source_changed"/>
                    <RadioButton x:Name="source_session_rb" GroupName="source" Content="Opened Revit session  (documents already open)"
                                 Checked="source_changed"/>
                </StackPanel>

                <StackPanel x:Name="acc_panel" Margin="0,8,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="connect_b" Content="Connect / Load Hubs" Width="150" Height="26" Click="connect_click"/>
                        <TextBlock Text="Hub:" VerticalAlignment="Center" Margin="14,0,6,0"/>
                        <ComboBox x:Name="hub_cb" Width="260" Height="26" SelectionChanged="hub_changed"/>
                        <TextBlock Text="Project:" VerticalAlignment="Center" Margin="14,0,6,0"/>
                        <ComboBox x:Name="project_cb" Width="300" Height="26" SelectionChanged="project_changed"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button x:Name="load_files_b" Content="Load Files" Width="150" Height="26" Click="load_files_click"/>
                        <CheckBox x:Name="rescan_cb" Content="Rescan project (ignore the cached list)" VerticalAlignment="Center" Margin="14,0,0,0"/>
                        <TextBlock x:Name="cache_tb" VerticalAlignment="Center" Margin="14,0,0,0" FontStyle="Italic"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="session_panel" Orientation="Horizontal" Margin="0,8,0,0" Visibility="Collapsed">
                    <Button x:Name="refresh_docs_b" Content="Refresh open documents" Width="170" Height="26" Click="refresh_docs_click"/>
                    <TextBlock Margin="14,0,0,0" VerticalAlignment="Center" FontStyle="Italic"
                               Text="Linked copies and family documents are not listed. Open, Close and Publish do not apply to files that are already open."/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
            <TextBlock Text="2. Tick the models to process.  Search:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="search_tb" Width="220" Height="24" VerticalContentAlignment="Center" TextChanged="search_changed"
                     ToolTip="Type part of a file name - several words must all match, in any order."/>
            <Button x:Name="select_all_b" Content="Select All" Width="90" Height="24" Margin="14,0,0,0" Click="select_all_click"/>
            <Button x:Name="select_none_b" Content="Select None" Width="90" Height="24" Margin="6,0,0,0" Click="select_none_click"/>
        </StackPanel>

        <DataGrid x:Name="files_grid" AutoGenerateColumns="False" CanUserAddRows="False"
                  CanUserSortColumns="True" SelectionMode="Extended" RowHeaderWidth="0">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="Process" Binding="{Binding selected, Mode=TwoWay}" Width="65"/>
                <DataGridTextColumn Header="Model" Binding="{Binding name}" Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Kind" Binding="{Binding kind}" Width="140" IsReadOnly="True"/>
                <DataGridTextColumn Header="Note" Binding="{Binding note}" Width="100" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>

<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeeParam — Shared &amp; Project Parameter Audit"
        ShowInTaskbar="False"
        MinHeight="680" MinWidth="1100" Height="780" Width="1240"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="10">

        <!-- top bar: scan, filter, grouping -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="scan_b" Content="Scan Parameters" Click="scan_click" Width="130" Height="26"
                    Style="{DynamicResource DeePrimary}"/>
            <TextBlock Text="Probe up to" VerticalAlignment="Center" Margin="14,0,4,0"/>
            <TextBox x:Name="probe_tb" Text="5000" Width="60" Height="24" VerticalContentAlignment="Center"
                     ToolTip="How many elements to read per parameter when counting usage. Bigger is more accurate on large models, but slower."/>
            <TextBlock Text="elements each" VerticalAlignment="Center" Margin="4,0,0,0"/>
            <TextBlock Text="Filter" VerticalAlignment="Center" Margin="20,0,4,0"/>
            <TextBox x:Name="filter_tb" Width="170" Height="24" VerticalContentAlignment="Center"
                     TextChanged="filter_changed" ToolTip="Type part of a name, category or GUID."/>
            <TextBlock Text="Kind" VerticalAlignment="Center" Margin="14,0,4,0"/>
            <ComboBox x:Name="kind_cb" Width="130" Height="24" SelectionChanged="filter_changed">
                <ComboBoxItem Content="All" IsSelected="True"/>
                <ComboBoxItem Content="Shared"/>
                <ComboBoxItem Content="Project"/>
                <ComboBoxItem Content="Unbound"/>
                <ComboBoxItem Content="Unused"/>
            </ComboBox>
            <TextBlock Text="Group by" VerticalAlignment="Center" Margin="14,0,4,0"/>
            <ComboBox x:Name="group_cb" Width="120" Height="24" SelectionChanged="filter_changed">
                <ComboBoxItem Content="None" IsSelected="True"/>
                <ComboBoxItem Content="Kind"/>
                <ComboBoxItem Content="Scope"/>
                <ComboBoxItem Content="Group"/>
                <ComboBoxItem Content="File status"/>
            </ComboBox>
            <TextBlock x:Name="status_tb" Text="Nothing scanned yet." VerticalAlignment="Center"
                       Margin="16,0,0,0" FontStyle="Italic"/>
        </StackPanel>

        <!-- bottom: close -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="export_b" Content="Export to Excel..." Click="export_click" Width="130" Height="26" Margin="0,0,8,0"/>
            <Button x:Name="close_b" Content="Close" Click="close_click" Width="100" Height="26"/>
        </StackPanel>

        <!-- bottom: log -->
        <GroupBox DockPanel.Dock="Bottom" Header="Log" Margin="0,8,0,0">
            <TextBox x:Name="log_tb" IsReadOnly="True" TextWrapping="NoWrap" Height="110"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas" FontSize="11"/>
        </GroupBox>

        <!-- bottom: actions -->
        <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="Delete / Purge">
                <StackPanel Margin="6">
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,6"
                               Text="Removing a binding takes the parameter off its categories and discards every value stored in it. Deleting an orphan removes the shared parameter element that nothing is bound to. Both preview first and ask before running."/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Button x:Name="check_all_b" Content="Check All Shown" Click="check_all_click" Width="110" Height="24"/>
                        <Button x:Name="check_none_b" Content="Uncheck All" Click="check_none_click" Width="90" Height="24" Margin="6,0,0,0"/>
                        <Button x:Name="check_unused_b" Content="Check Unused" Click="check_unused_click" Width="100" Height="24" Margin="12,0,0,0"
                                ToolTip="Checks every bound parameter whose Used count is zero across the probed elements."/>
                        <Button x:Name="check_orphans_b" Content="Check Orphans" Click="check_orphans_click" Width="100" Height="24" Margin="6,0,0,0"
                                ToolTip="Checks every shared parameter that is in the model but bound to nothing."/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="remove_binding_b" Content="Remove Binding (checked)" Click="remove_binding_click" Width="170" Height="26"
                                Style="{DynamicResource DeeDanger}"/>
                        <Button x:Name="delete_orphans_b" Content="Delete Orphaned Shared (checked)" Click="delete_orphans_click" Width="210" Height="26" Margin="8,0,0,0"
                                Style="{DynamicResource DeeDanger}"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Grid.Column="2" Header="Rebind / Repair">
                <Grid Margin="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <DockPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock DockPanel.Dock="Top" Text="Categories to bind to" FontWeight="Bold" Margin="0,0,0,4"/>
                        <TextBox DockPanel.Dock="Top" x:Name="cat_filter_tb" Height="22" Margin="0,0,0,4"
                                 TextChanged="cat_filter_changed" ToolTip="Type to narrow the category list."/>
                        <ListBox x:Name="cat_lb" Height="96" SelectionMode="Extended"/>
                    </DockPanel>
                    <StackPanel Grid.Column="1">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Button x:Name="load_file_b" Content="Load Shared Parameter File" Click="load_file_click" Width="180" Height="24"
                                    ToolTip="Reads the shared parameter file set under Manage > Shared Parameters and fills the File Status column."/>
                            <TextBlock x:Name="file_tb" Text="(not loaded)" VerticalAlignment="Center" Margin="8,0,0,0"
                                       FontStyle="Italic" TextTrimming="CharacterEllipsis" MaxWidth="260"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="New bindings as" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <RadioButton x:Name="instance_rb" Content="Instance" IsChecked="True" VerticalAlignment="Center"/>
                            <RadioButton x:Name="type_rb" Content="Type" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                        <Button x:Name="extend_b" Content="Extend Checked to Selected Categories" Click="extend_click" Height="26" Margin="0,0,0,6"
                                ToolTip="Adds the selected categories to each checked parameter's existing binding. Instance stays instance, type stays type."/>
                        <Button x:Name="bind_file_b" Content="Bind Checked Orphans from File" Click="bind_file_click" Height="26" Margin="0,0,0,6"
                                ToolTip="Binds each checked unbound shared parameter (found in the shared parameter file by GUID) to the selected categories."/>
                        <Button x:Name="bind_missing_b" Content="Bind File-Only Parameters..." Click="bind_missing_click" Height="26"
                                ToolTip="Lists the shared parameters that are in the file but not in this model, and binds the ones you pick to the selected categories."/>
                    </StackPanel>
                </Grid>
            </GroupBox>
        </Grid>

        <!-- main grid -->
        <DataGrid x:Name="grid" AutoGenerateColumns="False" CanUserAddRows="False"
                  SelectionMode="Extended" SelectionUnit="FullRow" RowHeaderWidth="0"
                  MouseDoubleClick="grid_double_click">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding highlight}" Value="orphan">
                            <Setter Property="Background" Value="#FFE0B2"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding highlight}" Value="missing">
                            <Setter Property="Background" Value="#FFCDD2"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding highlight}" Value="differs">
                            <Setter Property="Background" Value="#FFF9C4"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding highlight}" Value="unused">
                            <Setter Property="Background" Value="#ECEFF1"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Background="#E0E0E0" Margin="0,2,0,2">
                                <TextBlock Text="{Binding Path=Name}" FontWeight="Bold" Margin="4,2,4,2"/>
                                <TextBlock Text="{Binding Path=ItemCount, StringFormat=' ({0})'}" Margin="0,2,4,2" Foreground="#555555"/>
                            </StackPanel>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </DataGrid.GroupStyle>
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="" Binding="{Binding selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="34"/>
                <DataGridTextColumn Header="Name" Binding="{Binding name}" IsReadOnly="True" Width="190"/>
                <DataGridTextColumn Header="Kind" Binding="{Binding kind}" IsReadOnly="True" Width="110"/>
                <DataGridTextColumn Header="Scope" Binding="{Binding scope}" IsReadOnly="True" Width="64"/>
                <DataGridTextColumn Header="Categories" Binding="{Binding categories_text}" IsReadOnly="True" Width="230"/>
                <DataGridTextColumn Header="Storage" Binding="{Binding storage}" IsReadOnly="True" Width="70"/>
                <DataGridTextColumn Header="Data Type" Binding="{Binding datatype}" IsReadOnly="True" Width="90"/>
                <DataGridTextColumn Header="Group" Binding="{Binding group}" IsReadOnly="True" Width="110"/>
                <DataGridTextColumn Header="Elements" Binding="{Binding elements}" IsReadOnly="True" Width="66"/>
                <DataGridTextColumn Header="Used" Binding="{Binding used_text}" IsReadOnly="True" Width="80"/>
                <DataGridTextColumn Header="Distinct" Binding="{Binding distinct}" IsReadOnly="True" Width="58"/>
                <DataGridTextColumn Header="File Status" Binding="{Binding file_status_text}" IsReadOnly="True" Width="150"/>
                <DataGridTextColumn Header="GUID" Binding="{Binding guid}" IsReadOnly="True" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>

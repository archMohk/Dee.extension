<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeeGetDWG — Bring Far CAD Files Back to Origin"
        ShowInTaskbar="False"
        MinHeight="520" MinWidth="900" Height="580" Width="980"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="10">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="Finds every CAD Import/Link (DWG, DXF, etc.) in this document and shows how far its placement point is from the Internal Origin (0,0,0) - a common cause of Revit's &quot;very far from the origin&quot; warning and view/performance problems. Check the ones to fix, then click Move Selected to Internal Origin - this unpins each one (if needed) and translates it back to (0,0,0), keeping its rotation and scale exactly as-is."/>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="scan_b" Content="Rescan" Click="scan_click" Width="100" Height="26"/>
            <TextBlock Text="Auto-check items farther than:" VerticalAlignment="Center" Margin="20,0,6,0"/>
            <TextBox x:Name="threshold_tb" Width="70" Height="24" VerticalContentAlignment="Center" Text="1000"/>
            <TextBlock x:Name="threshold_unit_tb" Text="ft" VerticalAlignment="Center" Margin="4,0,0,0"/>
            <Button x:Name="apply_threshold_b" Content="Apply Threshold" Click="apply_threshold_click" Width="120" Height="24" Margin="8,0,0,0"/>
            <TextBlock x:Name="status_tb" Text="Nothing scanned yet." VerticalAlignment="Center" Margin="20,0,0,0" FontStyle="Italic"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="select_all_b" Content="Select All" Click="select_all_click" Width="90" Height="24"/>
            <Button x:Name="select_none_b" Content="Select None" Click="select_none_click" Width="90" Height="24" Margin="6,0,0,0"/>
            <Button x:Name="move_selected_b" Content="Move Selected to Internal Origin" Click="move_selected_click" Width="230" Height="24" Margin="20,0,0,0"/>
        </StackPanel>

        <Button DockPanel.Dock="Bottom" x:Name="close_b" Content="Close" Click="close_click"
                Width="100" Height="26" HorizontalAlignment="Right" Margin="0,10,0,0"/>

        <DataGrid x:Name="cad_grid" AutoGenerateColumns="False" CanUserAddRows="False"
                  CanUserSortColumns="True" SelectionMode="Extended" RowHeaderWidth="0">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="Select" Binding="{Binding selected, Mode=TwoWay}" Width="55"/>
                <DataGridTextColumn Header="File Name" Binding="{Binding file_name}" Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Kind" Binding="{Binding kind_text}" Width="80" IsReadOnly="True"/>
                <DataGridTextColumn Header="Pinned" Binding="{Binding pinned_text}" Width="70" IsReadOnly="True"/>
                <DataGridTextColumn Header="Distance from Origin" Binding="{Binding distance_text}" Width="160" IsReadOnly="True"/>
                <DataGridTextColumn Header="Position" Binding="{Binding position_text}" Width="240" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>

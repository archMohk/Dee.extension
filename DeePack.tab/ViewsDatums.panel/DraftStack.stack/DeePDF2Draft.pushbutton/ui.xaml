<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeePDF2Draft - PDF to Drafting Views"
        ShowInTaskbar="False"
        MinHeight="700" MinWidth="1100" Height="830" Width="1260"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="10">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="Creates one Drafting View per PDF page. Lines and fills rebuilds the drawing as Detail Lines and Filled Regions (hatching comes through as lines); Picture places the page as an image. Import embeds the page in the model; Link keeps it as an external reference to the file on disk. Tick 'Remove border and title block' to cut those off each page first."/>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Add Files..." Click="add_files_click" Width="100" Height="26"/>
            <Button Content="Add Folder..." Click="add_folder_click" Width="110" Height="26" Margin="6,0,0,0"/>
            <CheckBox x:Name="subfolders_cb" Content="include subfolders" VerticalAlignment="Center" Margin="10,0,0,0"/>
            <Button Content="Select All" Click="select_all_click" Width="80" Height="26" Margin="20,0,0,0"/>
            <Button Content="Select None" Click="select_none_click" Width="90" Height="26" Margin="6,0,0,0"/>
            <Button Content="Remove Unchecked" Click="remove_unchecked_click" Width="130" Height="26" Margin="6,0,0,0"/>
        </StackPanel>

        <Button DockPanel.Dock="Bottom" x:Name="close_b" Content="Close" Click="close_click"
                Width="100" Height="26" HorizontalAlignment="Right" Margin="0,10,0,0"/>
        <TextBlock DockPanel.Dock="Bottom" x:Name="status_tb" Text="Add PDF files to begin." FontStyle="Italic" Margin="0,8,0,0"/>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="Convert as:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="convert_cb" Height="24" Width="250" SelectedIndex="0">
                    <ComboBoxItem Content="Lines and fills (editable linework)"/>
                    <ComboBoxItem Content="Picture (image)"/>
                </ComboBox>
                <TextBlock Text="Drawing scale 1:" VerticalAlignment="Center" Margin="16,0,6,0"
                           ToolTip="Auto = smallest scale at which no line is too short for Revit. Or type your own (10, 20, 50...)."/>
                <ComboBox x:Name="scale_n_cb" IsEditable="True" Text="Auto" Width="70" Height="24">
                    <ComboBoxItem Content="Auto"/>
                    <ComboBoxItem Content="1"/>
                    <ComboBoxItem Content="2"/>
                    <ComboBoxItem Content="5"/>
                    <ComboBoxItem Content="10"/>
                    <ComboBoxItem Content="20"/>
                    <ComboBoxItem Content="25"/>
                    <ComboBoxItem Content="50"/>
                    <ComboBoxItem Content="100"/>
                </ComboBox>
                <TextBlock Text="Skip lines under (mm on paper, 0 = keep all):" VerticalAlignment="Center" Margin="16,0,6,0"/>
                <TextBox x:Name="min_mm_tb" Text="0" Width="40" Height="24" VerticalContentAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <CheckBox x:Name="fills_cb" Content="Create filled regions" VerticalAlignment="Center" IsChecked="True"/>
                <CheckBox x:Name="hatch_cb" Content="Join close parallel lines into one hatch region" VerticalAlignment="Center" Margin="16,0,0,0" IsChecked="True"/>
                <CheckBox x:Name="colors_cb" Content="Keep colours of coloured lines (override)" VerticalAlignment="Center" Margin="16,0,0,0" IsChecked="True"/>
                <TextBlock Text="(Picture mode only:)" VerticalAlignment="Center" Margin="24,0,0,0" FontStyle="Italic"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="Mode:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="mode_cb" Height="24" Width="170" SelectedIndex="0">
                    <ComboBoxItem Content="Import (embed in model)"/>
                    <ComboBoxItem Content="Link (external reference)"/>
                </ComboBox>
                <TextBlock Text="Resolution (dpi):" VerticalAlignment="Center" Margin="16,0,6,0"/>
                <TextBox x:Name="dpi_tb" Text="200" Width="60" Height="24" VerticalContentAlignment="Center"/>
                <TextBlock Text="View scale 1:" VerticalAlignment="Center" Margin="16,0,6,0"/>
                <TextBox x:Name="scale_tb" Text="1" Width="50" Height="24" VerticalContentAlignment="Center"/>
                <TextBlock Text="If name exists:" VerticalAlignment="Center" Margin="16,0,6,0"/>
                <ComboBox x:Name="exists_cb" Height="24" Width="120" SelectedIndex="0">
                    <ComboBoxItem Content="Skip the file"/>
                    <ComboBoxItem Content="Add a number"/>
                </ComboBox>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <CheckBox x:Name="allpages_cb" Content="All pages (one view per page)" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <CheckBox x:Name="crop_cb" Content="Remove border and title block" VerticalAlignment="Center" IsChecked="True"/>
                <TextBlock Text="trim (points):  left" VerticalAlignment="Center" Margin="16,0,4,0"/>
                <TextBox x:Name="crop_left_tb" Text="38" Width="45" Height="24" VerticalContentAlignment="Center"/>
                <TextBlock Text="top" VerticalAlignment="Center" Margin="10,0,4,0"/>
                <TextBox x:Name="crop_top_tb" Text="42" Width="45" Height="24" VerticalContentAlignment="Center"/>
                <TextBlock Text="right" VerticalAlignment="Center" Margin="10,0,4,0"/>
                <TextBox x:Name="crop_right_tb" Text="38" Width="45" Height="24" VerticalContentAlignment="Center"/>
                <TextBlock Text="bottom" VerticalAlignment="Center" Margin="10,0,4,0"/>
                <TextBox x:Name="crop_bottom_tb" Text="120" Width="45" Height="24" VerticalContentAlignment="Center"/>
            </StackPanel>
            <TextBlock TextWrapping="Wrap" FontStyle="Italic" Margin="0,0,0,6"
                       Text="Defaults fit the DAR A4 detail sheets (title block along the bottom, 1 pt = 1/72 in). Cropped copies are written to a _NoTitleblock folder beside the PDFs and those are what Revit places. Needs Python with PyMuPDF (py -m pip install pymupdf)."/>
            <Button x:Name="create_b" Content="Create Drafting Views" Click="create_click"
                    Height="26" Width="230" HorizontalAlignment="Left"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Right" Width="340" Margin="10,0,0,0">
            <TextBlock Text="Preview and orientation" FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBlock TextWrapping="Wrap" FontStyle="Italic" Margin="0,0,0,6"
                       Text="Click a file in the list, then turn the drawing the way it should sit in Revit. The same turn is applied to every checked file."/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="Turn:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="rot_cb" Width="130" Height="24" SelectedIndex="0" SelectionChanged="preview_changed">
                    <ComboBoxItem Content="0 (as drawn)"/>
                    <ComboBoxItem Content="90 clockwise"/>
                    <ComboBoxItem Content="180"/>
                    <ComboBoxItem Content="270 clockwise"/>
                </ComboBox>
                <CheckBox x:Name="mirror_cb" Content="Mirror left-right" VerticalAlignment="Center" Margin="10,0,0,0"
                          Checked="preview_changed" Unchecked="preview_changed"/>
            </StackPanel>
            <Button Content="Refresh preview" Click="refresh_preview_click" Width="120" Height="24" HorizontalAlignment="Left" Margin="0,0,0,6"/>
            <Border BorderBrush="Gray" BorderThickness="1" Height="250" Background="White">
                <Image x:Name="preview_img" Stretch="Uniform"/>
            </Border>
            <TextBlock x:Name="preview_tb" TextWrapping="Wrap" FontStyle="Italic" Margin="0,4,0,0" Text="No preview yet."/>
            <TextBlock Text="Line weights" FontWeight="Bold" Margin="0,10,0,2"/>
            <TextBlock TextWrapping="Wrap" FontStyle="Italic" Margin="0,0,0,4"
                       Text="Each stroke thickness found in the PDF is drawn with one of this project's own line styles. Auto picks the closest pen; change any row to define it yourself."/>
            <Button Content="Scan weights from selected file" Click="scan_click" Width="200" Height="24" HorizontalAlignment="Left" Margin="0,0,0,4"/>
            <DataGrid x:Name="weight_grid" AutoGenerateColumns="False" CanUserAddRows="False" Height="170" RowHeaderWidth="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="PDF mm" Binding="{Binding mm}" Width="60" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Lines" Binding="{Binding count}" Width="55" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>

        <DataGrid x:Name="file_grid" AutoGenerateColumns="False" CanUserAddRows="False"
                  CanUserSortColumns="True" SelectionMode="Extended" RowHeaderWidth="0"
                  SelectionChanged="file_selected">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="Use" Binding="{Binding selected, Mode=TwoWay}" Width="45"/>
                <DataGridTextColumn Header="PDF File" Binding="{Binding file_name}" Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Drafting View Name" Binding="{Binding view_name, Mode=TwoWay}" Width="*"/>
                <DataGridTextColumn Header="Folder" Binding="{Binding folder}" Width="*" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>

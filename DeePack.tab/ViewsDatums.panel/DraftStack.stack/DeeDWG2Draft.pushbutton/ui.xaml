<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeeDWG2Draft - DWG to Drafting Views"
        ShowInTaskbar="False"
        MinHeight="560" MinWidth="860" Height="620" Width="940"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="10">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="Creates one Drafting View per DWG file and places the drawing in it. Import embeds the drawing in the model; Link keeps it as an external reference to the file on disk."/>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Add Files..." Click="add_files_click" Width="100" Height="26"/>
            <Button Content="Add Folder..." Click="add_folder_click" Width="110" Height="26" Margin="6,0,0,0"/>
            <CheckBox x:Name="subfolders_cb" Content="include subfolders" VerticalAlignment="Center" Margin="10,0,0,0"/>
            <Button Content="Select All" Click="select_all_click" Width="80" Height="26" Margin="20,0,0,0"/>
            <Button Content="Select None" Click="select_none_click" Width="90" Height="26" Margin="6,0,0,0"/>
            <Button Content="Remove Unchecked" Click="remove_unchecked_click" Width="130" Height="26" Margin="6,0,0,0"/>
        </StackPanel>

        <Button DockPanel.Dock="Bottom" x:Name="close_b" Content="Close" Click="close_click"
                Width="100" Height="26" HorizontalAlignment="Right" Margin="0,10,0,0"/>
        <TextBlock DockPanel.Dock="Bottom" x:Name="status_tb" Text="Add DWG files to begin." FontStyle="Italic" Margin="0,8,0,0"/>

        <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="170"/>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="150"/>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/><RowDefinition Height="32"/><RowDefinition Height="32"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Mode:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox Grid.Row="0" Grid.Column="1" x:Name="mode_cb" Height="24" SelectedIndex="0">
                <ComboBoxItem Content="Import (embed in model)"/>
                <ComboBoxItem Content="Link (external reference)"/>
            </ComboBox>
            <TextBlock Grid.Row="0" Grid.Column="2" Text="Units:" VerticalAlignment="Center" Margin="16,0,6,0"/>
            <ComboBox Grid.Row="0" Grid.Column="3" x:Name="unit_cb" Height="24"/>
            <TextBlock Grid.Row="0" Grid.Column="4" Text="Colours:" VerticalAlignment="Center" Margin="16,0,6,0"/>
            <ComboBox Grid.Row="0" Grid.Column="5" x:Name="color_cb" Height="24" Width="150" HorizontalAlignment="Left"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="View scale 1:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox Grid.Row="1" Grid.Column="1" x:Name="scale_tb" Text="10" Height="24" Width="70" HorizontalAlignment="Left" VerticalContentAlignment="Center"/>
            <TextBlock Grid.Row="1" Grid.Column="2" Text="If name exists:" VerticalAlignment="Center" Margin="16,0,6,0"/>
            <ComboBox Grid.Row="1" Grid.Column="3" x:Name="exists_cb" Height="24" SelectedIndex="0">
                <ComboBoxItem Content="Skip the file"/>
                <ComboBoxItem Content="Add a number"/>
            </ComboBox>
            <CheckBox Grid.Row="1" Grid.Column="5" x:Name="visible_cb" Content="Visible layers only" VerticalAlignment="Center" Margin="16,0,0,0" IsChecked="True"/>

            <Button Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" x:Name="create_b" Content="Create Drafting Views"
                    Click="create_click" Height="26" HorizontalAlignment="Left" Width="230"/>
        </Grid>

        <DataGrid x:Name="file_grid" AutoGenerateColumns="False" CanUserAddRows="False"
                  CanUserSortColumns="True" SelectionMode="Extended" RowHeaderWidth="0">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="Use" Binding="{Binding selected, Mode=TwoWay}" Width="45"/>
                <DataGridTextColumn Header="DWG File" Binding="{Binding file_name}" Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Drafting View Name" Binding="{Binding view_name, Mode=TwoWay}" Width="*"/>
                <DataGridTextColumn Header="Folder" Binding="{Binding folder}" Width="*" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>

<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dee.extension — DeeS.V.Template"
        ShowInTaskbar="False"
        MinHeight="700" MinWidth="1100" Height="780" Width="1200"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="10">

        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="Pick a Discipline, Originator and Package, then a Preset - each Preset is a set of per-category visibility/graphics overrides (halftone / hidden / line weight) tuned for that deliverable. Apply it to picked views or to whatever's already on picked sheets, create a real View Template from the result, or save your own new Preset for a Package."/>

        <GroupBox DockPanel.Dock="Top" Header="1. Discipline / Originator / Package" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" Margin="6">
                <TextBlock Text="Discipline:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="discipline_cb" Width="160" Height="24" SelectionChanged="discipline_changed"/>
                <TextBlock Text="Originator:" VerticalAlignment="Center" Margin="20,0,6,0"/>
                <ComboBox x:Name="originator_cb" Width="140" Height="24" SelectionChanged="originator_changed"/>
                <TextBlock Text="Package:" VerticalAlignment="Center" Margin="20,0,6,0"/>
                <ComboBox x:Name="package_cb" Width="260" Height="24" SelectionChanged="package_changed"/>
                <TextBlock x:Name="package_info_tb" VerticalAlignment="Center" Margin="16,0,0,0"
                           Foreground="#888" TextWrapping="Wrap" Text=""/>
            </StackPanel>
        </GroupBox>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem><TextBlock x:Name="status_tb" Text="Ready."/></StatusBarItem>
        </StatusBar>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,8">
            <Button x:Name="apply_b" Content="Apply Preset to Targets" Width="170" Height="30"
                    FontWeight="Bold" Click="apply_click"/>
            <Button x:Name="create_template_b" Content="Create View Template from Active View" Width="230" Height="30"
                    Margin="10,0,0,0" Click="create_template_click"/>
            <Button x:Name="close_b" Content="Close" Width="90" Height="30" Margin="24,0,0,0" Click="close_click"/>
        </StackPanel>

        <TabControl x:Name="main_tabs">

            <TabItem Header="Setup &amp; Targets">
                <Grid Margin="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" MinWidth="300"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="1.4*" MinWidth="320"/>
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0">
                        <TextBlock DockPanel.Dock="Top" Text="2. Preset" FontWeight="Bold" Margin="0,0,0,6"/>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                            <ComboBox x:Name="preset_cb" Width="260" Height="24" SelectionChanged="preset_changed"/>
                            <Button x:Name="delete_preset_b" Content="Delete" Width="70" Height="24"
                                    Margin="8,0,0,0" Click="delete_preset_click"/>
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Top" x:Name="preset_detail_tb" TextWrapping="Wrap"
                                   FontSize="11" Foreground="#888" Margin="0,0,0,12" Text=""/>

                        <TextBlock DockPanel.Dock="Top" Text="Reference - views/templates for this Package" FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBlock DockPanel.Dock="Top" Text="Views normally placed on the sheet:" FontSize="11" Foreground="#888"/>
                        <TextBlock DockPanel.Dock="Top" x:Name="ref_views_tb" TextWrapping="Wrap" Margin="0,0,0,8" Text=""/>
                        <TextBlock DockPanel.Dock="Top" Text="Matching view template names:" FontSize="11" Foreground="#888"/>
                        <TextBlock DockPanel.Dock="Top" x:Name="ref_templates_tb" TextWrapping="Wrap" Text=""/>
                    </DockPanel>

                    <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Stretch" Background="#444"
                                  ResizeBehavior="PreviousAndNext"/>

                    <DockPanel Grid.Column="2">
                        <TextBlock DockPanel.Dock="Top" Text="3. Targets" FontWeight="Bold" Margin="0,0,0,6"/>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                            <RadioButton x:Name="target_views_rb" Content="Pick Views" GroupName="target_mode"
                                         IsChecked="True" Checked="target_mode_changed" VerticalAlignment="Center"/>
                            <RadioButton x:Name="target_sheets_rb" Content="Pick Sheets (apply to views already on them)"
                                         GroupName="target_mode" Margin="20,0,0,0" Checked="target_mode_changed"
                                         VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBox x:Name="target_search_tb" Width="220" Height="22" VerticalContentAlignment="Center"
                                     TextChanged="target_search_changed"
                                     ToolTip="Type part of a name - multiple words all have to match, in any order."/>
                            <Button x:Name="target_all_b" Content="All" Width="50" Height="22" Margin="6,0,0,0" Click="target_all_click"/>
                            <Button x:Name="target_none_b" Content="None" Width="56" Height="22" Margin="4,0,0,0" Click="target_none_click"/>
                            <TextBlock x:Name="target_count_tb" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#888"/>
                        </StackPanel>
                        <Border BorderBrush="#555" BorderThickness="1">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="target_panel" Background="#1E1E1E"/>
                            </ScrollViewer>
                        </Border>
                    </DockPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Preview">
                <DockPanel Margin="6">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock FontSize="11" Foreground="#888" TextWrapping="Wrap"
                                   Text="Categories from the active view. Click a swatch to cycle Original -&gt; Halftone -&gt; Thick Outline -&gt; Filled -&gt; Hidden -&gt; Original, while authoring a new preset."/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button x:Name="preview_refresh_b" Content="Refresh from Active View" Width="170" Height="26" Click="preview_refresh_click"/>
                        <Button x:Name="preview_apply_now_b" Content="Preview on Active View" Width="160" Height="26" Margin="8,0,0,0" Click="preview_apply_now_click"/>
                        <Button x:Name="preview_reset_b" Content="Reset Draft" Width="110" Height="26" Margin="8,0,0,0" Click="preview_reset_click"/>
                        <Button x:Name="save_preset_b" Content="Save As New Preset..." Width="170" Height="26" Margin="20,0,0,0" FontWeight="Bold" Click="save_preset_click"/>
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" MinWidth="300"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="1.3*" MinWidth="320"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" BorderBrush="#555" BorderThickness="1">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <WrapPanel x:Name="preview_panel" Background="#1E1E1E" Margin="6"/>
                            </ScrollViewer>
                        </Border>

                        <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Stretch" Background="#444"
                                      ResizeBehavior="PreviousAndNext"/>

                        <DockPanel Grid.Column="2">
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                                <Button x:Name="preview_image_b" Content="Generate Preview Image (Active View)" Width="240" Height="26"
                                        Click="preview_image_click"/>
                            </StackPanel>
                            <TextBlock DockPanel.Dock="Top" FontSize="11" Foreground="#888" TextWrapping="Wrap" Margin="0,0,0,6"
                                       Text="Applies the current Preset or in-progress draft to the ACTIVE view (same real change as 'Preview on Active View'), then captures a picture of it - the active view should already show the real walls/furniture/doors/windows/tags you want to see the effect on, e.g. an enlarged plan."/>
                            <Border BorderBrush="#555" BorderThickness="1" Background="#1E1E1E">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                    <Image x:Name="preview_image_img" Stretch="Uniform"/>
                                </ScrollViewer>
                            </Border>
                        </DockPanel>
                    </Grid>
                </DockPanel>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>

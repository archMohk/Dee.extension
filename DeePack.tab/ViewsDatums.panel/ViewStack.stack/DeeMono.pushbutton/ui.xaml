<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeeMono - Monochrome View Theme"
        ShowInTaskbar="False"
        MinHeight="720" MinWidth="640" Height="920" Width="700"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="10">

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="status_tb" Text="Pick a view, a colour and a style, then Apply."/>
            </StatusBarItem>
        </StatusBar>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,8">
            <Button x:Name="apply_b" Content="Apply" Width="110" Height="32"
                    FontWeight="Bold" Click="apply_click"/>
            <Button x:Name="restore_b" Content="Restore Original" Width="140" Height="32"
                    Margin="10,0,0,0" Click="restore_click"
                    ToolTip="Puts this view's graphics back to how they were before DeeMono first touched them."/>
            <Button x:Name="close_b" Content="Close" Width="90" Height="32"
                    Margin="10,0,0,0" Click="close_click"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,0,0,4">
            <CheckBox x:Name="save_template_cb" Content="Also create a View Template from this"
                      VerticalAlignment="Center" Click="save_template_cb_click"
                      ToolTip="Applies the theme to the selected view (same as Apply), then saves that view's look as a brand new, reusable Revit View Template - so it can be assigned to other views from Revit's own Properties panel without running DeeMono again."/>
            <TextBox x:Name="template_name_tb" Width="220" Height="24" Margin="10,0,0,0"
                     VerticalContentAlignment="Center" IsEnabled="False"/>
        </StackPanel>

        <Border DockPanel.Dock="Top" Background="#EEF3F8" Padding="8" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock FontWeight="Bold" Text="Recolour a 3D view into one theme colour"/>
                <TextBlock TextWrapping="Wrap" Margin="0,3,0,0"
                           Text="Same as opening VV and setting every category's overrides by hand. Nothing changes until you press Apply, and this view's current graphics are saved first so you can always Restore them."/>
            </StackPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="3D view:" VerticalAlignment="Center"
                       Margin="0,0,10,8"/>
            <ComboBox Grid.Row="0" Grid.Column="1" x:Name="view_cb" Height="26" Margin="0,0,0,8"
                      SelectionChanged="view_cb_changed"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Theme colour:" VerticalAlignment="Center"
                       Margin="0,0,10,8"/>
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                <Border x:Name="colour_swatch" Width="26" Height="26" BorderBrush="#888"
                        BorderThickness="1" CornerRadius="3"/>
                <Button x:Name="colour_b" Content="Change Colour..." Width="140" Height="26"
                        Margin="10,0,0,0" Click="colour_click"/>
                <TextBlock x:Name="colour_hex_tb" VerticalAlignment="Center" Margin="10,0,0,0"
                           Foreground="#666" FontFamily="Consolas"/>
            </StackPanel>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Style:" VerticalAlignment="Center"
                       Margin="0,0,10,4"/>
            <ComboBox Grid.Row="2" Grid.Column="1" x:Name="style_cb" Height="26" Margin="0,0,0,4"
                      SelectionChanged="style_cb_changed"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="" VerticalAlignment="Center"/>
            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,4">
                <TextBox x:Name="custom_preset_name_tb" Width="160" Height="24"
                         VerticalContentAlignment="Center"
                         ToolTip="Name for a new preset that captures the current style plus every tint, per-category outline, auto-outline and transparency adjustment below - not the theme colour or per-view options like hide-categories/shadows."/>
                <Button x:Name="save_preset_b" Content="Save as Preset" Width="120" Height="24"
                        Margin="8,0,0,0" Click="save_preset_click"/>
            </StackPanel>

            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="style_desc_tb" TextWrapping="Wrap"
                       Foreground="#666" FontStyle="Italic" Margin="0,0,0,10"/>

            <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
                <CheckBox x:Name="flatten_cb" IsChecked="True" Click="flatten_cb_click"
                          Content="Flatten shading to 'Consistent Colors' (matches the poster look)"/>
            </StackPanel>

            <TextBlock Grid.Row="6" Grid.Column="0" Text="Outline colour:" VerticalAlignment="Center"
                       Margin="0,0,10,10"/>
            <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
                <CheckBox x:Name="outline_override_cb" Click="outline_override_click"
                          Content="Override" VerticalAlignment="Center"
                          ToolTip="Off (default): the tool's own dark neutral, chosen to stay legible against any fill colour. On: pick your own - the same legibility check still applies to whichever colour you choose."/>
                <Border x:Name="outline_swatch" Width="26" Height="26" BorderBrush="#888"
                        BorderThickness="1" CornerRadius="3" Margin="10,0,0,0"/>
                <Button x:Name="outline_b" Content="Change Colour..." Width="140" Height="26"
                        Margin="10,0,0,0" Click="outline_click" IsEnabled="False"/>
                <TextBlock x:Name="outline_hex_tb" VerticalAlignment="Center" Margin="10,0,0,0"
                           Foreground="#666" FontFamily="Consolas"/>
            </StackPanel>

            <TextBlock Grid.Row="7" Grid.Column="0" Text="Outline thickness:" VerticalAlignment="Center"
                       Margin="0,0,10,10"/>
            <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
                <Slider x:Name="outline_weight_slider" Width="220" Minimum="1" Maximum="16"
                        ValueChanged="outline_weight_slider_changed"
                        ToolTip="Revit pen weight 1 (thin) - 16 (thick), applied to every category's outline in this view. Starts at the current style's own thickness; switching style resets it back to that."/>
                <TextBlock x:Name="outline_weight_value_tb" VerticalAlignment="Center" Width="24"
                           Margin="10,0,0,0"/>
            </StackPanel>

            <TextBlock Grid.Row="8" Grid.Column="0" Text="Auto outline:" VerticalAlignment="Top"
                       Margin="0,2,10,10"/>
            <StackPanel Grid.Row="8" Grid.Column="1" Margin="0,0,0,10">
                <CheckBox x:Name="auto_outline_cb" Content="Auto - tint each category's outline from its own fill"
                          Click="auto_outline_cb_click"
                          ToolTip="Instead of one flat outline colour for the whole view, each category's outline becomes a lighter/darker shade of THAT category's own fill. Turning this on turns the Override above off - only one outline source applies to the whole view at a time; a per-category pick in the preview below still wins over either."/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="Style:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="auto_outline_style_cb" Width="150" Height="24"
                              SelectionChanged="auto_outline_style_cb_changed" IsEnabled="False"/>
                </StackPanel>
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Lighter / darker:" VerticalAlignment="Center"/>
                    <Slider Grid.Column="1" x:Name="auto_outline_slider" Minimum="-90" Maximum="90"
                            Margin="0,0,8,0" ValueChanged="auto_outline_slider_changed"
                            IsEnabled="False"
                            ToolTip="Negative = darker than the category's own fill, positive = lighter. Always stays legible against that fill, same guarantee as every other outline source."/>
                    <TextBlock Grid.Column="2" x:Name="auto_outline_value_tb"
                               VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>

            <TextBlock Grid.Row="9" Grid.Column="0" Text="Hide in view:" VerticalAlignment="Center"
                       Margin="0,0,10,10"/>
            <StackPanel Grid.Row="9" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
                <CheckBox x:Name="hide_levels_cb" Content="Levels" Margin="0,0,16,0"
                          VerticalAlignment="Center"/>
                <CheckBox x:Name="hide_grids_cb" Content="Grids" Margin="0,0,16,0"
                          VerticalAlignment="Center"/>
                <CheckBox x:Name="hide_sectionbox_cb" Content="Section Box" Margin="0,0,16,0"
                          VerticalAlignment="Center"/>
                <CheckBox x:Name="hide_scopebox_cb" Content="Scope Boxes"
                          VerticalAlignment="Center"/>
            </StackPanel>

            <TextBlock Grid.Row="10" Grid.Column="0" Text="Shadows:" VerticalAlignment="Top"
                       Margin="0,2,10,10"/>
            <StackPanel Grid.Row="10" Grid.Column="1" Margin="0,0,0,10">
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="34"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0" x:Name="cast_shadows_cb" Content="Cast Shadows"
                              VerticalAlignment="Center" Click="cast_shadows_cb_click"
                              ToolTip="Off (default): leave this view's shadow intensity exactly as it is. On: set it below (0 = no cast shadows, 100 = solid black) - the real, documented View.ShadowIntensity property."/>
                    <Slider Grid.Column="1" x:Name="shadow_slider" Minimum="0" Maximum="100"
                            Margin="0,0,8,0" IsEnabled="False" ValueChanged="shadow_slider_changed"/>
                    <TextBlock Grid.Column="2" x:Name="shadow_value_tb" VerticalAlignment="Center"/>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="34"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0" x:Name="ambient_shadows_cb" Content="Ambient Shadows"
                              VerticalAlignment="Center" Click="ambient_shadows_cb_click"
                              ToolTip="Revit's own 'Show Ambient Shadows' checkbox has NO public API - confirmed, not guessed, so it cannot actually be toggled here. This instead controls Sunlight Intensity, the real, documented property closest to it (how strong the simulated directional light is, which is what makes a cast shadow read as sharp or soft)."/>
                    <Slider Grid.Column="1" x:Name="sunlight_slider" Minimum="0" Maximum="100"
                            Margin="0,0,8,0" IsEnabled="False" ValueChanged="sunlight_slider_changed"/>
                    <TextBlock Grid.Column="2" x:Name="sunlight_value_tb" VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>

            <GroupBox Grid.Row="11" Grid.Column="0" Grid.ColumnSpan="2" Header="Preview">
                <DockPanel Margin="4">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" x:Name="reset_tints_b" Content="Reset All"
                                Width="90" Height="24" Click="reset_tints_click"
                                ToolTip="Puts every category's tint and transparency slider back to this style's own default and clears every per-category outline override below."/>
                        <TextBlock Foreground="#888" FontSize="11" TextWrapping="Wrap"
                                   Text="A sample of categories under the current colour and style - the same calculation Apply uses. Top slider nudges that tone group lighter/darker; bottom slider nudges its transparency. The labelled Outline box below shows that category's own outline colour, at the current thickness - left-click to set one, right-click to clear it."/>
                    </DockPanel>
                    <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto">
                        <WrapPanel x:Name="preview_panel"/>
                    </ScrollViewer>
                </DockPanel>
            </GroupBox>
        </Grid>
    </DockPanel>
</Window>

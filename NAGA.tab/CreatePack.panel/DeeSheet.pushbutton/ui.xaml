<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="DeeSheet — Create Sheets" Height="560" Width="680"
    WindowStartupLocation="CenterScreen"
    ResizeMode="CanResize"
    ShowInTaskbar="False">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,10" FontSize="13"
                   Text="Copy the Sheet Number column from Excel and paste it into the left box. Copy the Sheet Name column and paste it into the right box. Line 1 in both boxes = one sheet, line 2 = the next one, and so on."/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="Sheet Number" FontWeight="Bold" Margin="0,0,0,4"/>
                <TextBox x:Name="numbers_box" AcceptsReturn="True" AcceptsTab="False"
                         TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="13"/>
            </DockPanel>

            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Text="Sheet Name" FontWeight="Bold" Margin="0,0,0,4"/>
                <TextBox x:Name="names_box" AcceptsReturn="True" AcceptsTab="False"
                         TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="13"/>
            </DockPanel>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="create_btn" Content="Create Sheets" Width="130" Height="32"
                    Margin="0,0,10,0" Click="create_click"/>
            <Button x:Name="cancel_btn" Content="Cancel" Width="100" Height="32" Click="cancel_click"/>
        </StackPanel>
    </Grid>
</Window>

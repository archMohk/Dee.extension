<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeeView — Batch Create Views"
        ShowInTaskbar="False"
        MinHeight="720" MinWidth="1080" Height="800" Width="1150"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="10">
        <!-- Presets toolbar -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Preset:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="preset_cb" Width="160" Height="24"/>
            <Button x:Name="load_preset_b" Content="Load" Click="load_preset_click" Width="60" Height="24" Margin="6,0,0,0"/>
            <Button x:Name="save_preset_b" Content="Save As..." Click="save_preset_click" Width="80" Height="24" Margin="6,0,0,0"/>
            <Button x:Name="import_preset_b" Content="Import JSON..." Click="import_preset_click" Width="100" Height="24" Margin="14,0,0,0"/>
            <Button x:Name="export_preset_b" Content="Export JSON..." Click="export_preset_click" Width="100" Height="24" Margin="6,0,0,0"/>
        </StackPanel>

        <!-- Bottom nav -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
            <Button x:Name="back_b" Content="&lt; Back" Click="back_click" Width="80" Height="28"/>
            <Button x:Name="next_b" Content="Next &gt;" Click="next_click" Width="80" Height="28" Margin="6,0,0,0"/>
            <Button x:Name="close_b" Content="Close" Click="close_click" Width="80" Height="28" Margin="20,0,0,0"/>
        </StackPanel>

        <TabControl x:Name="wizard_tabs">
            <!-- STEP 1: Levels -->
            <TabItem Header="1. Levels">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Checking levels here just seeds the level set for new rows you add in Step 2 - each row keeps its own list of levels from then on, editable there via 'Pick Levels for Selected Row(s)'."/>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="Search:" VerticalAlignment="Center" Margin="0,0,6,0" DockPanel.Dock="Left"/>
                        <TextBox x:Name="level_search_tb" Height="24" TextChanged="level_search_changed"/>
                    </DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button x:Name="check_all_levels_b" Content="Select All" Click="check_all_levels_click" Width="90" Height="24"/>
                        <Button x:Name="uncheck_all_levels_b" Content="Deselect All" Click="uncheck_all_levels_click" Width="90" Height="24" Margin="6,0,0,0"/>
                    </StackPanel>
                    <ListView x:Name="levels_lb">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox IsChecked="{Binding state}" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding name}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </DockPanel>
            </TabItem>

            <!-- STEP 2: Views -->
            <TabItem Header="2. Views">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Each enabled row creates one view per level assigned to THAT row - different rows can target different levels. Select one or more rows (click, or Ctrl/Shift-click for several) and use 'Pick Levels for Selected Row(s)' to assign or change levels. View Type / View Template are dropdowns populated from this project (all templates are listed - the tool validates the match, flagging and skipping a template that doesn't fit the row's View Type rather than pre-filtering the list)."/>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button x:Name="add_row_b" Content="Add Row" Click="add_row_click" Width="90" Height="24"/>
                        <Button x:Name="remove_row_b" Content="Remove Row(s)" Click="remove_row_click" Width="100" Height="24" Margin="6,0,0,0"/>
                        <Button x:Name="move_row_up_b" Content="Move Up" Click="move_row_up_click" Width="80" Height="24" Margin="20,0,0,0"/>
                        <Button x:Name="move_row_down_b" Content="Move Down" Click="move_row_down_click" Width="90" Height="24" Margin="6,0,0,0"/>
                        <Button x:Name="pick_levels_b" Content="Pick Levels for Selected Row(s)" Click="pick_levels_for_rows_click" Width="200" Height="24" Margin="20,0,0,0"/>
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="280"/>
                        </Grid.ColumnDefinitions>
                        <DataGrid x:Name="views_grid" Grid.Column="0" AutoGenerateColumns="False"
                                  CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False"
                                  SelectionMode="Extended" SelectionUnit="FullRow"
                                  RowEditEnding="views_row_edit_ending">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding enabled, Mode=TwoWay}" Width="55"/>
                                <DataGridComboBoxColumn x:Name="view_type_col" Header="View Type" SelectedItemBinding="{Binding vft_name, Mode=TwoWay}" Width="130"/>
                                <DataGridComboBoxColumn x:Name="template_col" Header="View Template" SelectedItemBinding="{Binding template_name, Mode=TwoWay}" Width="140"/>
                                <DataGridTextColumn Header="Scale (1:x)" Binding="{Binding scale_text, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="75"/>
                                <DataGridTextColumn Header="Prefix" Binding="{Binding prefix, Mode=TwoWay}" Width="70"/>
                                <DataGridTextColumn Header="Suffix" Binding="{Binding suffix, Mode=TwoWay}" Width="70"/>
                                <DataGridCheckBoxColumn Header="Place on Sheet" Binding="{Binding place_on_sheet, Mode=TwoWay}" Width="95"/>
                                <DataGridTextColumn Header="Levels" Binding="{Binding levels_text}" IsReadOnly="True" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <DockPanel Grid.Column="2">
                            <Button x:Name="preview_naming_b" DockPanel.Dock="Top" Content="Preview Naming"
                                    Click="preview_naming_click" Height="24" HorizontalAlignment="Left" Width="140"/>
                            <TextBlock DockPanel.Dock="Top" Text="Naming Preview (one view per line):"
                                       FontWeight="Bold" Margin="0,8,0,4" TextWrapping="Wrap"/>
                            <ListBox x:Name="naming_preview_lb"/>
                        </DockPanel>
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- STEP 3: Sheets -->
            <TabItem Header="3. Sheets">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <GroupBox Header="Sheet Mode" Margin="0,0,0,8">
                            <StackPanel Margin="6">
                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,6" FontStyle="Italic"
                                           Text="DeeView never creates sheets - it only creates views and, optionally, places them onto sheets that already exist in this project."/>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="mode_views_only_rb" GroupName="SheetMode" Content="Create Views Only" IsChecked="True" Margin="0,0,16,0"/>
                                    <RadioButton x:Name="mode_existing_rb" GroupName="SheetMode" Content="Place on Existing Sheets"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Sheet Assignment Rule (matches an existing sheet)" Margin="0,0,0,8">
                            <StackPanel Margin="6">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="rule_per_level_rb" GroupName="SheetRule" Content="One Sheet per Level" IsChecked="True" Margin="0,0,16,0"/>
                                    <RadioButton x:Name="rule_per_viewtype_rb" GroupName="SheetRule" Content="One Sheet per View Type (Discipline)" Margin="0,0,16,0"/>
                                    <RadioButton x:Name="rule_per_building_rb" GroupName="SheetRule" Content="One Sheet per Building Parameter" Margin="0,0,16,0"/>
                                    <RadioButton x:Name="rule_manual_rb" GroupName="SheetRule" Content="Manual Mapping (existing sheets)"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="Building Parameter Name:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBox x:Name="building_param_tb" Width="140" Height="22" Text="Building"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button x:Name="load_manual_map_b" Content="Load Selected Levels Into Mapping Table" Click="load_manual_map_click" Width="230" Height="24"/>
                                </StackPanel>
                                <DataGrid x:Name="manual_map_grid" AutoGenerateColumns="False" Height="140" Margin="0,8,0,0"
                                          CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Level" Binding="{Binding level_name}" IsReadOnly="True" Width="200"/>
                                        <DataGridComboBoxColumn x:Name="manual_sheet_col" Header="Target Sheet" SelectedItemBinding="{Binding sheet_label, Mode=TwoWay}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Viewport Placement" Margin="0,0,0,8">
                            <StackPanel Margin="6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Viewport Type:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <ComboBox x:Name="viewport_type_cb" Width="160" Height="24"/>
                                    <TextBlock Text="Position:" VerticalAlignment="Center" Margin="20,0,6,0"/>
                                    <ComboBox x:Name="position_cb" Width="120" Height="24" SelectionChanged="position_changed"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="Offset X:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBox x:Name="offset_x_tb" Width="70" Height="22" Text="0"/>
                                    <TextBlock Text="Offset Y:" VerticalAlignment="Center" Margin="14,0,6,0"/>
                                    <TextBox x:Name="offset_y_tb" Width="70" Height="22" Text="0"/>
                                    <TextBlock Text="Custom X:" VerticalAlignment="Center" Margin="20,0,6,0"/>
                                    <TextBox x:Name="custom_x_tb" Width="70" Height="22" Text="0" IsEnabled="False"/>
                                    <TextBlock Text="Custom Y:" VerticalAlignment="Center" Margin="14,0,6,0"/>
                                    <TextBox x:Name="custom_y_tb" Width="70" Height="22" Text="0" IsEnabled="False"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="H. Spacing:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBox x:Name="h_spacing_tb" Width="70" Height="22" Text="0.5"/>
                                    <TextBlock Text="V. Spacing:" VerticalAlignment="Center" Margin="14,0,6,0"/>
                                    <TextBox x:Name="v_spacing_tb" Width="70" Height="22" Text="0.5"/>
                                    <TextBlock Text="(project length units)" VerticalAlignment="Center" Margin="10,0,0,0" FontStyle="Italic"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button x:Name="preview_layout_b" Content="Preview Layout" Click="preview_layout_click" Width="110" Height="24"/>
                                    <TextBlock Text="(illustrative only - actual viewport size is only known once a view is created)" VerticalAlignment="Center" Margin="10,0,0,0" FontStyle="Italic"/>
                                </StackPanel>
                                <Border BorderBrush="#FFAAAAAA" BorderThickness="1" Background="#FFF7F7F7" Height="220" Margin="0,8,0,0">
                                    <Canvas x:Name="layout_canvas" ClipToBounds="True"/>
                                </Border>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Duplicate View Handling">
                            <StackPanel Orientation="Horizontal" Margin="6">
                                <TextBlock Text="If a view name already exists:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox x:Name="duplicate_mode_cb" Width="180" Height="24"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- STEP 4: Preview & Run -->
            <TabItem Header="4. Preview &amp; Run">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button x:Name="refresh_preview_b" Content="Refresh Preview" Click="refresh_preview_click" Width="110" Height="26"/>
                        <Button x:Name="export_csv_b" Content="Export to Excel (CSV)" Click="export_csv_click" Width="150" Height="26" Margin="8,0,0,0"/>
                        <Button x:Name="run_b" Content="Run" Click="run_click" Width="100" Height="26" Margin="14,0,0,0"/>
                    </StackPanel>
                    <TextBox x:Name="summary_tb" DockPanel.Dock="Top" Height="110" Margin="0,0,0,8"
                             IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas"/>
                    <DataGrid x:Name="plan_grid" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" CanUserDeleteRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="View Name" Binding="{Binding view_name}" Width="2*"/>
                            <DataGridTextColumn Header="Level" Binding="{Binding level_name}" Width="*"/>
                            <DataGridTextColumn Header="View Type" Binding="{Binding vft_name}" Width="*"/>
                            <DataGridTextColumn Header="Template" Binding="{Binding template_name}" Width="*"/>
                            <DataGridTextColumn Header="Scale" Binding="{Binding scale_label}" Width="70"/>
                            <DataGridTextColumn Header="Target Sheet" Binding="{Binding sheet_label}" Width="*"/>
                            <DataGridTextColumn Header="Conflict" Binding="{Binding conflict_label}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>

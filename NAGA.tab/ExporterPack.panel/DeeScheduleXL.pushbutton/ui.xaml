<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeeScheduleXL — Schedule ⇄ Excel Sync"
        ShowInTaskbar="False"
        MinHeight="700" MinWidth="1000" Height="760" Width="1080"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="10">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,10">
            <Run Text="Export writes one Excel sheet per selected Schedule. Bidirectional mode adds a hidden Element Id column and locks calculated/non-settable cells, so the file can be re-imported later - Unidirectional is a clean one-way copy only. Only itemized Schedules (one row per element) support Bidirectional; others still export but are marked import-incompatible. Import reads a previously-exported file, checks each sheet against the current model's Schedules, and writes edited (unlocked) cell values back onto the matching elements. Nothing changes in the model until Import is clicked."/>
        </TextBlock>

        <Button DockPanel.Dock="Bottom" x:Name="close_b" Content="Close" Click="close_click"
                Width="100" Height="26" HorizontalAlignment="Right" Margin="0,10,0,0"/>

        <TabControl x:Name="main_tabs">
            <TabItem Header="Export">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button x:Name="scan_schedules_b" Content="Scan / Re-scan Schedules"
                                Click="scan_schedules_click" Width="180" Height="26"/>
                        <TextBlock x:Name="export_summary_tb" Text="Not scanned yet." VerticalAlignment="Center" Margin="14,0,0,0" FontStyle="Italic"/>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <RadioButton x:Name="mode_bidirectional_rb" Content="Bidirectional - Import possible but locked/formatted cells"
                                         GroupName="export_mode" IsChecked="True" VerticalAlignment="Center"/>
                            <RadioButton x:Name="mode_unidirectional_rb" Content="Unidirectional - Clean copy, import impossible"
                                         GroupName="export_mode" VerticalAlignment="Center" Margin="30,0,0,0"/>
                        </StackPanel>
                        <Button x:Name="export_b" Content="Export to Excel" Click="export_click"
                                Width="160" Height="28" HorizontalAlignment="Left"/>
                    </StackPanel>

                    <DataGrid x:Name="schedules_grid" AutoGenerateColumns="False" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Export" Binding="{Binding is_selected, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                            <DataGridTextColumn Header="Schedule Name" Binding="{Binding name}" Width="*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Category" Binding="{Binding category_name}" Width="180" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Itemized" Binding="{Binding itemized_text}" Width="90" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Fields" Binding="{Binding field_count_text}" Width="70" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Import">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Top">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="File:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="import_file_tb" Width="500" Height="24" IsReadOnly="True"/>
                            <Button x:Name="browse_import_b" Content="Browse..." Click="browse_import_click"
                                    Width="90" Height="24" Margin="8,0,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <Button DockPanel.Dock="Bottom" x:Name="import_b" Content="Import" Click="import_click"
                            Width="160" Height="28" HorizontalAlignment="Left" Margin="0,10,0,0"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <DockPanel Grid.Column="0">
                            <TextBlock DockPanel.Dock="Top" Text="Compatible for import" FontWeight="Bold" Margin="0,0,0,6"/>
                            <DataGrid x:Name="compatible_grid" AutoGenerateColumns="False" CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridCheckBoxColumn Header="Import" Binding="{Binding is_selected, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                                    <DataGridTextColumn Header="Sheet" Binding="{Binding sheet_name}" Width="*" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Rows" Binding="{Binding row_count_text}" Width="60" IsReadOnly="True"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                        <DockPanel Grid.Column="2">
                            <TextBlock DockPanel.Dock="Top" Text="Not compatible for import" FontWeight="Bold" Margin="0,0,0,6"/>
                            <DataGrid x:Name="incompatible_grid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Sheet" Binding="{Binding sheet_name}" Width="*"/>
                                    <DataGridTextColumn Header="Reason" Binding="{Binding reason}" Width="2*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Grid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Live Editor">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Schedule:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="editor_schedule_cb" Width="300" Height="24"/>
                        <Button x:Name="load_editor_b" Content="Load into Editor" Click="load_editor_click"
                                Width="140" Height="24" Margin="8,0,0,0"/>
                        <Button x:Name="apply_editor_b" Content="Apply Changes to Model" Click="apply_editor_click"
                                Width="180" Height="24" Margin="8,0,0,0"/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top" FontStyle="Italic" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Only itemized Schedules can be loaded (one row per element). Select cells and use Ctrl+C / Ctrl+V - works both within this grid and to/from a real Excel window. Gray (read-only) columns are calculated fields and can't be edited or pasted into. Nothing changes in the model until 'Apply Changes to Model' is clicked."/>
                    <DataGrid x:Name="editor_grid" AutoGenerateColumns="True" CanUserAddRows="False"
                              ClipboardCopyMode="ExcludeHeader" PreviewKeyDown="editor_grid_preview_key_down"
                              AutoGeneratingColumn="editor_grid_auto_generating_column"/>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>

<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeeHealth — Model Health Score"
        ShowInTaskbar="False"
        MinHeight="700" MinWidth="1200" Height="780" Width="1300"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="10">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,10">
            <Run Text="Import Rubric loads a QC-test-style Excel workbook (Section/Test names, weights, and the three threshold cells E/F/G) into the editable grid below - Weight/E/F/G stay editable afterward, so you can tune the scoring without touching the Excel again. Run Health Check executes every test that maps to a known check, fills in its measured Value and per-test Score, and computes an overall weighted score (tests with no Weight are informational only and never affect the score). Nothing changes in the model - every check here only reads."/>
        </TextBlock>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="import_rubric_b" Content="Import Rubric from Excel" Click="import_rubric_click" Width="180" Height="26"/>
            <TextBlock x:Name="rubric_summary_tb" Text="No rubric loaded yet." VerticalAlignment="Center" Margin="14,0,0,0" FontStyle="Italic"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Naming Pattern (regex, used by the 3 naming-convention tests):" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="naming_pattern_tb" Width="260" Height="24"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="run_health_b" Content="Run Health Check" Click="run_health_click" Width="160" Height="30"/>
            <Button x:Name="export_csv_b" Content="Export Results to CSV" Click="export_csv_click" Width="160" Height="30" Margin="10,0,0,0"/>
            <Button x:Name="export_report_b" Content="Export Health Report (Excel)" Click="export_report_click" Width="200" Height="30" Margin="10,0,0,0"/>
            <TextBlock x:Name="overall_score_tb" Text="Overall Score: --" VerticalAlignment="Center" Margin="24,0,0,0" FontSize="18" FontWeight="Bold"/>
            <Button x:Name="close_b" Content="Close" Click="close_click" Width="100" Height="26" HorizontalAlignment="Right" Margin="40,0,0,0"/>
        </StackPanel>

        <DataGrid x:Name="rubric_grid" AutoGenerateColumns="False" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Section" Binding="{Binding section}" Width="150" IsReadOnly="True"/>
                <DataGridTextColumn Header="Test" Binding="{Binding name}" Width="180" IsReadOnly="True"/>
                <DataGridTextColumn Header="Implemented" Binding="{Binding implemented_text}" Width="90" IsReadOnly="True"/>
                <DataGridTextColumn Header="Weight" Binding="{Binding weight_text, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                <DataGridTextColumn Header="E (good)" Binding="{Binding e_text, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                <DataGridTextColumn Header="F (warn)" Binding="{Binding f_text, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                <DataGridTextColumn Header="G (fail)" Binding="{Binding g_text, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                <DataGridTextColumn Header="Value" Binding="{Binding result_value_text}" Width="90" IsReadOnly="True"/>
                <DataGridTextColumn Header="Score" Binding="{Binding result_score_text}" Width="70" IsReadOnly="True"/>
                <DataGridTextColumn Header="Description" Binding="{Binding description}" Width="*" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>

<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dee.extension — Shape sample"
        Width="440" Height="260" MinWidth="320" MinHeight="200"
        ResizeMode="CanResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Sample action" Width="120" Height="28" Style="{DynamicResource DeePrimary}"/>
            <Button Content="Close" Width="90" Height="28" Margin="8,0,0,0" Click="close_click"/>
        </StackPanel>
        <StackPanel>
            <TextBlock x:Name="sample_tb" FontWeight="Bold" Margin="0,0,0,6" Text=""/>
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource DeeTextMuted}" Margin="0,0,0,10"
                       Text="This is how every DeePack tool window looks with this shape. Drag the title bar, resize from the edges, or double-click the title to fill the screen."/>
            <ProgressBar Height="12" Minimum="0" Maximum="100" Value="55"/>
        </StackPanel>
    </DockPanel>
</Window>

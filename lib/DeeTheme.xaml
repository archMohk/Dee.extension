<!--
DeeTheme.xaml - the one shared look for Dee.extension tool windows.

Loaded by dee_branding.DeeBrandedWindow when a tool opts in with
theme=True, and merged into that window's Resources. Everything here is
an IMPLICIT style (TargetType only, no x:Key) so the tool's own ui.xaml
needs no edits to pick it up: every Button, TextBox, ComboBox, CheckBox,
GroupBox and TabItem in the window simply starts looking the same as in
every other themed tool. A control that sets its own Background /
FontSize / Padding inline still wins - inline values beat styles - so
nothing a tool deliberately coloured is overridden.

Two keyed button styles are the only opt-in extras:
  Style="{DynamicResource DeePrimary}"  - the blue main action
  Style="{DynamicResource DeeDanger}"   - red, for delete / destructive
DynamicResource (not StaticResource) because the dictionary is merged
after the window's XAML has loaded; StaticResource would fail to resolve
at parse time and the window would not open.

Colours are the ones already scattered across the tools (blue #1F6FB2,
orange #F2994D, status green/amber/red), gathered in one place.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== Palette ===== -->
    <Color x:Key="DeeAccentColor">#1F6FB2</Color>
    <Color x:Key="DeeAccentDarkColor">#185A90</Color>
    <Color x:Key="DeeOrangeColor">#F2994D</Color>
    <Color x:Key="DeeDangerColor">#C0392B</Color>
    <Color x:Key="DeeDangerDarkColor">#A93226</Color>

    <SolidColorBrush x:Key="DeeAccent" Color="{StaticResource DeeAccentColor}"/>
    <SolidColorBrush x:Key="DeeAccentDark" Color="{StaticResource DeeAccentDarkColor}"/>
    <SolidColorBrush x:Key="DeeOrange" Color="{StaticResource DeeOrangeColor}"/>
    <SolidColorBrush x:Key="DeeDangerBrush" Color="{StaticResource DeeDangerColor}"/>
    <SolidColorBrush x:Key="DeeDangerDark" Color="{StaticResource DeeDangerDarkColor}"/>

    <SolidColorBrush x:Key="DeeWindowBg" Color="#FAFAFA"/>
    <SolidColorBrush x:Key="DeeSurface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="DeeBorder" Color="#D0D0D0"/>
    <SolidColorBrush x:Key="DeeBorderStrong" Color="#A0A0A0"/>
    <SolidColorBrush x:Key="DeeText" Color="#222222"/>
    <SolidColorBrush x:Key="DeeTextMuted" Color="#777777"/>
    <SolidColorBrush x:Key="DeeButtonBg" Color="#F2F2F2"/>
    <SolidColorBrush x:Key="DeeButtonHover" Color="#E4E4E4"/>
    <SolidColorBrush x:Key="DeeButtonPressed" Color="#D6D6D6"/>

    <!-- Status colours, same values the DataGrid row triggers already use -->
    <SolidColorBrush x:Key="DeeStatusOk" Color="#C6E0B4"/>
    <SolidColorBrush x:Key="DeeStatusWarn" Color="#FFE699"/>
    <SolidColorBrush x:Key="DeeStatusFail" Color="#F4C7C3"/>
    <SolidColorBrush x:Key="DeeStatusIgnored" Color="#E0E0E0"/>

    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="DeeFontSize">12</sys:Double>
    <FontFamily x:Key="DeeFont">Segoe UI</FontFamily>
    <CornerRadius x:Key="DeeRadius">4</CornerRadius>

    <!-- ===== Buttons ===== -->
    <!-- Base template shared by every button variant: flat, rounded, with
         hover / pressed / disabled visuals. -->
    <ControlTemplate x:Key="DeeButtonTemplate" TargetType="Button">
        <Border x:Name="bd"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{StaticResource DeeRadius}"
                SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}"
                              RecognizesAccessKey="True"/>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Opacity" Value="0.75"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Default (secondary) button: every Button in a themed window. -->
    <Style TargetType="Button">
        <Setter Property="Template" Value="{StaticResource DeeButtonTemplate}"/>
        <Setter Property="Background" Value="{StaticResource DeeButtonBg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource DeeBorderStrong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource DeeText}"/>
        <Setter Property="Padding" Value="12,4"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="MinWidth" Value="80"/>
        <Setter Property="FontSize" Value="{StaticResource DeeFontSize}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource DeeButtonHover}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource DeeButtonPressed}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Main action: blue. Opt in with Style="{DynamicResource DeePrimary}". -->
    <Style x:Key="DeePrimary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource DeeAccent}"/>
        <Setter Property="BorderBrush" Value="{StaticResource DeeAccentDark}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource DeeAccentDark}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource DeeAccentDark}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Destructive action: red. Opt in with Style="{DynamicResource DeeDanger}". -->
    <Style x:Key="DeeDanger" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource DeeDangerBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource DeeDangerDark}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource DeeDangerDark}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource DeeDangerDark}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== Inputs ===== -->
    <Style TargetType="TextBox">
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="MinHeight" Value="26"/>
        <Setter Property="BorderBrush" Value="{StaticResource DeeBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="{StaticResource DeeSurface}"/>
        <Setter Property="Foreground" Value="{StaticResource DeeText}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="{StaticResource DeeFontSize}"/>
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource DeeAccent}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="PasswordBox">
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="MinHeight" Value="26"/>
        <Setter Property="BorderBrush" Value="{StaticResource DeeBorder}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="{StaticResource DeeFontSize}"/>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="MinHeight" Value="26"/>
        <Setter Property="Padding" Value="6,3"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="{StaticResource DeeFontSize}"/>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,2"/>
        <Setter Property="FontSize" Value="{StaticResource DeeFontSize}"/>
        <Setter Property="Foreground" Value="{StaticResource DeeText}"/>
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,2"/>
        <Setter Property="FontSize" Value="{StaticResource DeeFontSize}"/>
    </Style>

    <!-- ===== Text ===== -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource DeeText}"/>
        <Setter Property="FontSize" Value="{StaticResource DeeFontSize}"/>
    </Style>

    <Style TargetType="Label">
        <Setter Property="Foreground" Value="{StaticResource DeeText}"/>
        <Setter Property="FontSize" Value="{StaticResource DeeFontSize}"/>
        <Setter Property="Padding" Value="0,2"/>
    </Style>

    <!-- ===== Containers ===== -->
    <Style TargetType="GroupBox">
        <Setter Property="BorderBrush" Value="{StaticResource DeeBorder}"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="FontSize" Value="{StaticResource DeeFontSize}"/>
        <Setter Property="HeaderTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}" FontWeight="SemiBold"
                               Foreground="{StaticResource DeeAccent}"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="Padding" Value="12,5"/>
        <Setter Property="FontSize" Value="{StaticResource DeeFontSize}"/>
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="Foreground" Value="{StaticResource DeeAccent}"/>
        <Setter Property="Background" Value="{StaticResource DeeButtonBg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource DeeBorder}"/>
        <Setter Property="Height" Value="14"/>
    </Style>

    <Style TargetType="DataGrid">
        <Setter Property="FontSize" Value="{StaticResource DeeFontSize}"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="#EAEAEA"/>
        <Setter Property="BorderBrush" Value="{StaticResource DeeBorder}"/>
        <Setter Property="RowHeight" Value="24"/>
        <Setter Property="AlternatingRowBackground" Value="#F7F7F7"/>
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource DeeButtonBg}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="BorderBrush" Value="{StaticResource DeeBorder}"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
    </Style>

    <Style TargetType="ListBox">
        <Setter Property="BorderBrush" Value="{StaticResource DeeBorder}"/>
        <Setter Property="FontSize" Value="{StaticResource DeeFontSize}"/>
    </Style>

    <Style TargetType="ListView">
        <Setter Property="BorderBrush" Value="{StaticResource DeeBorder}"/>
        <Setter Property="FontSize" Value="{StaticResource DeeFontSize}"/>
    </Style>

</ResourceDictionary>

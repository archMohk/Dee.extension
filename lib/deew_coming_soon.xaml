<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeeW.Cloud"
        ShowInTaskbar="False"
        SizeToContent="Height" Width="440"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <StackPanel Margin="20">
        <TextBlock x:Name="tool_name_tb" Text="DeeW.Example" FontSize="20" FontWeight="Bold" Margin="0,0,0,6"/>
        <TextBlock Text="Coming Soon" FontSize="14" Foreground="#FF808080" FontStyle="Italic" Margin="0,0,0,14"/>
        <TextBlock x:Name="description_tb" TextWrapping="Wrap" Margin="0,0,0,16"
                   Text="This tool is part of the DeeW.Cloud package and shares its reusable services (logging, settings, model scanning, cloud upload, failure handling) with DeeW.Sharing and DeeW.Batch Save to Cloud. It will be implemented in a future update."/>
        <Button x:Name="close_b" Content="Close" Click="close_click" Width="100" Height="28" HorizontalAlignment="Right"/>
    </StackPanel>
</Window>

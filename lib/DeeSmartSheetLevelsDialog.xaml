<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SmartSheet - Configure Classification Parameters"
        ShowInTaskbar="False"
        MinHeight="360" MinWidth="520" Height="440" Width="560"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="10">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,10" FontSize="11" Foreground="#555"
                   Text="Each level below is one folder in the Sheet Browser tree (Level 1 = the top one, e.g. Villa Type). SmartSheet guesses which parameter drives each level by matching values - pick one yourself where the guess is wrong, or where a level shows '???' because every sheet in a branch currently has it blank (nothing to guess from). This is what Duplicate Group and Add Sheet write into new sheets so they land in the right spot instead of showing up unclassified."/>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="cancel_b" Content="Cancel" Width="90" Height="28" Margin="0,0,8,0" Click="cancel_click"/>
            <Button x:Name="ok_b" Content="Save" Width="100" Height="28" FontWeight="Bold"
                    Background="#1F6FB2" Foreground="White" BorderBrush="#1F6FB2" Cursor="Hand" Click="ok_click"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="levels_ic">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding level_label}" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding sample_text}" VerticalAlignment="Center"
                                       Foreground="#555" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                            <ComboBox Grid.Column="2" ItemsSource="{Binding param_choices}"
                                      SelectedItem="{Binding selected_param, Mode=TwoWay}" Height="24"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>

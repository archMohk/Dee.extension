<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeeSchedule - Schedule a task"
        ShowInTaskbar="False"
        MinHeight="560" MinWidth="820" Height="800" Width="900"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="cancel_b" Content="Close" Width="90" Height="30" Margin="0,0,8,0" Click="cancel_click"/>
            <Button x:Name="ok_b" Content="Schedule it" Width="140" Height="30" FontWeight="Bold"
                    Background="#1F6FB2" Foreground="White" BorderBrush="#1F6FB2" Cursor="Hand"
                    Click="ok_click" Style="{DynamicResource DeePrimary}"/>
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" x:Name="status_tb" Foreground="#AA0000" TextWrapping="Wrap" Margin="0,6,0,0"/>

        <GroupBox DockPanel.Dock="Bottom" x:Name="existing_gb" Header="Already scheduled in this tool" Margin="0,8,0,0">
            <DockPanel Margin="6">
                <WrapPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                    <Button Content="Run now" Width="84" Height="26" Margin="0,0,6,0" Click="run_click"/>
                    <Button Content="Resume" Width="84" Height="26" Margin="0,0,6,0" Click="resume_click"/>
                    <Button Content="Pause" Width="84" Height="26" Margin="0,0,6,0" Click="pause_click"/>
                    <Button Content="Stop" Width="84" Height="26" Margin="0,0,6,0" Click="stop_click"/>
                    <Button Content="Delete" Width="84" Height="26" Click="delete_click"/>
                </WrapPanel>
                <DataGrid x:Name="tasks_grid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                          SelectionMode="Extended" SelectionUnit="FullRow" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" Height="120">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Task" Binding="{Binding name}" Width="*" MinWidth="150"/>
                        <DataGridTextColumn Header="When" Binding="{Binding when}" Width="180"/>
                        <DataGridTextColumn Header="Next run" Binding="{Binding next_text}" Width="140"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding status}" Width="120"/>
                        <DataGridTextColumn Header="Last result" Binding="{Binding result}" Width="160"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </GroupBox>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <GroupBox Header="What" Margin="0,0,0,8">
                    <StackPanel Margin="8,6">
                        <TextBlock Text="Task name" Margin="0,0,0,2"/>
                        <TextBox x:Name="name_tb" Height="26" Margin="0,0,0,8"/>
                        <TextBlock x:Name="summary_tb" TextWrapping="Wrap" Margin="0,0,0,4"/>
                        <TextBlock x:Name="models_tb" TextWrapping="Wrap" Foreground="#555555"/>
                        <StackPanel x:Name="extras_panel" Margin="0,6,0,0"/>
                        <TextBlock x:Name="note_tb" TextWrapping="Wrap" Foreground="#8D6E19" Margin="0,4,0,0"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="When" Margin="0,0,0,8">
                    <StackPanel Margin="8,6">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Repeat" Width="90" VerticalAlignment="Center"/>
                            <ComboBox x:Name="repeat_cb" Width="190" Height="26" SelectionChanged="repeat_changed"/>
                            <StackPanel x:Name="interval_panel" Orientation="Horizontal">
                                <TextBlock Text="every" VerticalAlignment="Center" Margin="14,0,6,0"/>
                                <TextBox x:Name="minutes_tb" Width="60" Height="26" Text="60" TextChanged="when_changed"/>
                                <ComboBox x:Name="unit_cb" Width="90" Height="26" Margin="6,0,0,0" SelectionChanged="when_changed"/>
                            </StackPanel>
                            <StackPanel x:Name="monthly_panel" Orientation="Horizontal">
                                <TextBlock Text="on day" VerticalAlignment="Center" Margin="14,0,6,0"/>
                                <TextBox x:Name="day_tb" Width="50" Height="26" Text="1" TextChanged="when_changed"
                                         ToolTip="1 to 31. In a shorter month the last day is used."/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel x:Name="weekly_panel" Orientation="Horizontal" Margin="90,0,0,6">
                            <CheckBox x:Name="d0_cb" Content="Mon" Margin="0,0,10,0" Click="when_changed"/>
                            <CheckBox x:Name="d1_cb" Content="Tue" Margin="0,0,10,0" Click="when_changed"/>
                            <CheckBox x:Name="d2_cb" Content="Wed" Margin="0,0,10,0" Click="when_changed"/>
                            <CheckBox x:Name="d3_cb" Content="Thu" Margin="0,0,10,0" Click="when_changed"/>
                            <CheckBox x:Name="d4_cb" Content="Fri" Margin="0,0,10,0" Click="when_changed"/>
                            <CheckBox x:Name="d5_cb" Content="Sat" Margin="0,0,10,0" Click="when_changed"/>
                            <CheckBox x:Name="d6_cb" Content="Sun" Margin="0,0,10,0" Click="when_changed"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Start" Width="90" VerticalAlignment="Center"/>
                            <DatePicker x:Name="start_dp" Width="130" Height="26" SelectedDateChanged="when_changed"/>
                            <TextBlock Text="at" VerticalAlignment="Center" Margin="10,0,6,0"/>
                            <TextBox x:Name="time_tb" Width="70" Height="26" TextChanged="when_changed" ToolTip="24-hour time, e.g. 21:30"/>
                            <StackPanel x:Name="end_panel" Orientation="Horizontal">
                                <TextBlock Text="until (optional)" VerticalAlignment="Center" Margin="16,0,6,0"/>
                                <DatePicker x:Name="end_dp" Width="130" Height="26" SelectedDateChanged="when_changed"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock x:Name="preview_tb" FontWeight="Bold" TextWrapping="Wrap" Margin="90,0,0,4"/>
                        <CheckBox x:Name="missed_cb" IsChecked="True" Margin="90,2,0,0"
                                  Content="If Revit was closed at that time, run as soon as it is open again"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Where" Margin="0,0,0,4">
                    <StackPanel Margin="8,6">
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="Output folder" Width="90" VerticalAlignment="Center"/>
                            <Button DockPanel.Dock="Right" Content="Browse..." Width="84" Height="26" Margin="6,0,0,0" Click="browse_click"/>
                            <TextBox x:Name="output_tb" Height="26"/>
                        </DockPanel>
                        <CheckBox x:Name="dated_cb" Margin="90,0,0,6"
                                  Content="Put every run in its own dated subfolder"
                                  ToolTip="Off: each run replaces the files of the one before."/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Revit version" Width="90" VerticalAlignment="Center"/>
                            <ComboBox x:Name="year_cb" Width="170" Height="26"
                                      ToolTip="Opening a model in a newer Revit upgrades it in memory (slow), so a task normally waits for its own version."/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>

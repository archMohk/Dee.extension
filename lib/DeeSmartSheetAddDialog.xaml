<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SmartSheet - Add Sheet"
        ShowInTaskbar="False"
        MinHeight="320" MinWidth="420" Height="340" Width="420"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="10">
        <TextBlock DockPanel.Dock="Top" Text="Folder:" FontWeight="Bold" Margin="0,0,0,2"/>
        <TextBlock DockPanel.Dock="Top" x:Name="chain_tb" TextWrapping="Wrap" Margin="0,0,0,10" Foreground="#555"/>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="cancel_b" Content="Cancel" Width="90" Height="28" Margin="0,0,8,0" Click="cancel_click"/>
            <Button x:Name="ok_b" Content="Add Sheet" Width="100" Height="28" FontWeight="Bold"
                    Background="#1F6FB2" Foreground="White" BorderBrush="#1F6FB2" Cursor="Hand" Click="ok_click"/>
        </StackPanel>

        <StackPanel>
            <TextBlock Text="Sheet Number:" Margin="0,0,0,2"/>
            <TextBox x:Name="number_tb" Height="24" Margin="0,0,0,8"/>
            <TextBlock Text="Sheet Name:" Margin="0,0,0,2"/>
            <TextBox x:Name="name_tb" Height="24" Margin="0,0,0,8"/>
            <TextBlock Text="Title Block:" Margin="0,0,0,2"/>
            <ComboBox x:Name="titleblock_cb" Height="24"/>
        </StackPanel>
    </DockPanel>
</Window>

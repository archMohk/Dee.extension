<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dee.extension — Accent Colour"
        ShowInTaskbar="False" ResizeMode="NoResize"
        SizeToContent="Height" Width="560"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="14">
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,10"
                   Text="Pick the colours of the DeePack ribbon icons: the accent (also used for the website bar under each tool window and the progress bars) and the grey lines. Personal to this PC - it does not change anyone else's ribbon."/>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Colour the:" FontWeight="Bold" VerticalAlignment="Center"/>
            <RadioButton x:Name="target_accent_rb" Content="Accent (orange)" GroupName="target"
                         IsChecked="True" Margin="12,0,0,0" VerticalAlignment="Center"
                         Checked="target_changed"
                         ToolTip="The orange in the icons, the website bar and the progress bars."/>
            <RadioButton x:Name="target_line_rb" Content="Lines (grey)" GroupName="target"
                         Margin="16,0,0,0" VerticalAlignment="Center"
                         Checked="target_changed"
                         ToolTip="The grey line work of the ribbon icons."/>
        </StackPanel>

        <TextBlock Text="Palette" FontWeight="Bold" Margin="0,0,0,4"/>
        <WrapPanel x:Name="presets_panel" Margin="0,0,0,10"/>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <Button x:Name="more_b" Content="More colours..." Width="120" Height="26"
                    Click="more_click"
                    ToolTip="Open the full Windows colour picker - any colour at all."/>
            <TextBlock Text="Hex:" VerticalAlignment="Center" Margin="14,0,0,0"/>
            <TextBox x:Name="hex_tb" Width="100" Height="24" Margin="8,0,0,0"
                     TextChanged="hex_changed"
                     ToolTip="Any colour as #RRGGBB, e.g. #1F6FB2"/>
            <Border x:Name="swatch_b" Width="40" Height="24" Margin="8,0,0,0"
                    BorderBrush="{DynamicResource DeeBorderStrong}" BorderThickness="1" CornerRadius="3"/>
            <TextBlock x:Name="name_tb" Foreground="{DynamicResource DeeTextMuted}"
                       VerticalAlignment="Center" Margin="8,0,0,0" Text=""/>
            <TextBlock x:Name="hex_error_tb" Foreground="{DynamicResource DeeDangerBrush}"
                       VerticalAlignment="Center" Margin="8,0,0,0" Text=""/>
        </StackPanel>

        <TextBlock Text="Preview" FontWeight="Bold" Margin="0,0,0,4"/>
        <Border Background="{DynamicResource DeeSurface}" BorderBrush="{DynamicResource DeeBorder}"
                BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,12">
            <StackPanel>
                <WrapPanel x:Name="preview_panel"/>
                <ProgressBar x:Name="preview_pb" Height="14" Minimum="0" Maximum="100" Value="62"
                             Margin="4,8,4,2" ToolTip="Progress bars use the accent too."/>
                <TextBlock Foreground="{DynamicResource DeeTextMuted}" Margin="4,4,4,0" TextWrapping="Wrap"
                           Text="The bar at the bottom of this window shows the colour as well."/>
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="reset_b" Content="Reset to Orange" Width="130" Height="28" Click="reset_click"/>
            <Button x:Name="apply_b" Content="Apply" Width="100" Height="28" Margin="8,0,0,0"
                    Style="{DynamicResource DeePrimary}" Click="apply_click"/>
            <Button x:Name="close_b" Content="Close" Width="90" Height="28" Margin="8,0,0,0" Click="close_click"/>
        </StackPanel>
        <TextBlock x:Name="status_tb" Foreground="{DynamicResource DeeTextMuted}" TextWrapping="Wrap"
                   Margin="0,8,0,0" Text=""/>
    </StackPanel>
</Window>

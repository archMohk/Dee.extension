<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dee.extension — Accent Colour"
        ShowInTaskbar="False" ResizeMode="NoResize"
        SizeToContent="Height" Width="520"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="14">
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,10"
                   Text="Pick the colour used for the accent in every DeePack ribbon icon and for the bar under each tool window. Personal to this PC - it does not change anyone else's ribbon."/>

        <TextBlock Text="Presets" FontWeight="Bold" Margin="0,0,0,4"/>
        <WrapPanel x:Name="presets_panel" Margin="0,0,0,10"/>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Custom hex:" VerticalAlignment="Center"/>
            <TextBox x:Name="hex_tb" Width="110" Height="24" Margin="8,0,0,0"
                     TextChanged="hex_changed"
                     ToolTip="Any colour as #RRGGBB, e.g. #1F6FB2"/>
            <Border x:Name="swatch_b" Width="40" Height="24" Margin="8,0,0,0"
                    BorderBrush="{DynamicResource DeeBorderStrong}" BorderThickness="1" CornerRadius="3"/>
            <TextBlock x:Name="hex_error_tb" Foreground="{DynamicResource DeeDangerBrush}"
                       VerticalAlignment="Center" Margin="8,0,0,0" Text=""/>
        </StackPanel>

        <TextBlock Text="Preview" FontWeight="Bold" Margin="0,0,0,4"/>
        <Border Background="{DynamicResource DeeSurface}" BorderBrush="{DynamicResource DeeBorder}"
                BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,12">
            <WrapPanel x:Name="preview_panel"/>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="reset_b" Content="Reset to Orange" Width="130" Height="28" Click="reset_click"/>
            <Button x:Name="apply_b" Content="Apply" Width="100" Height="28" Margin="8,0,0,0"
                    Style="{DynamicResource DeePrimary}" Click="apply_click"/>
            <Button x:Name="close_b" Content="Close" Width="90" Height="28" Margin="8,0,0,0" Click="close_click"/>
        </StackPanel>
        <TextBlock x:Name="status_tb" Foreground="{DynamicResource DeeTextMuted}" TextWrapping="Wrap"
                   Margin="0,8,0,0" Text=""/>
    </StackPanel>
</Window>

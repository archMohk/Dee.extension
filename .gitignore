# Real credentials - NEVER commit. Distribute this file to trusted
# users through a separate, non-public channel instead.
acc_config.json

# Per-machine caches / runtime state - not source, and re-generated
# automatically on first use of the relevant tool.
.acc_token_cache.json
.acc_file_cache.json
lib/.dee_identity.json
dlgval.json
Project_Dlg_Data/
__pycache__/
*.pyc

# DeeW.Cloud: per-machine persistent settings (last folder/ACC
# destination/options) and log files - not source, re-generated on
# first use, and may reference machine-local paths or ACC project
# names not meant for the public repo.
lib/.deew_settings/
logs/
lib/.dee_mono/

# Installer build output - the .exe is a rebuildable compiler artifact
# (ISCC.exe installer/Dee.extension.iss), not source; keeping it out of
# git avoids bloating the public repo's history with a binary.
installer/Output/

# Owner-only usage/access dashboard - embeds the Supabase SECRET key
# (bypasses every RLS policy - full read/write on every table), unlike
# the publishable key embedded in lib/dee_telemetry.py which is safe to
# ship publicly. This whole folder must NEVER be committed - it is not
# part of the distributed extension, just a private file living in the
# same OneDrive folder for convenience.
dashboard/
